@* Модалка подтверждения (удаление проекта/задачи/файла/комментария). Enter — подтвердить, Esc — закрыть.

   Слой — MudDialog: затемнение, захват фокуса, Esc и клик по фону берёт на себя библиотека.
   Вид прежний — класс .flow-modal (mud-overrides.css). Enter остаётся на нашем HotkeyService:
   у диалога Mud подтверждения по Enter нет, а хоткей в Flow привычен.
   Компонент по-прежнему монтируется условием на странице (@if (_deleting is not null)), поэтому
   открыт он всегда — за видимость отвечает вызывающая сторона, как и раньше. Но снятие компонента
   диалог с экрана не убирает: ссылку, выданную MudDialogProvider, закрываем сами (CloseDialog). *@
@implements IAsyncDisposable
@inject HotkeyService Hotkeys

<MudDialog @ref="_dialog" Visible="@_visible" VisibleChanged="OnVisibleChanged" Options="_options" Class="flow-modal"
           TitleClass="flow-modal-title" ContentClass="flow-modal-content" ActionsClass="modal-actions">
    <TitleContent>
        <h3>@Title</h3>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(Text))
        {
            <p>@Text</p>
        }
    </DialogContent>
    <DialogActions>
        <DsButton Variant="secondary" Size="md" OnClick="Cancel" Disabled="_busy">Отмена</DsButton>
        <DsButton Id="@_confirmId" Variant="danger" Size="md" OnClick="Confirm" Busy="_busy" Icon="trash">@ConfirmLabel</DsButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Text { get; set; }
    [Parameter] public string ConfirmLabel { get; set; } = "Удалить";
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private readonly string _confirmId = "cd-" + Guid.NewGuid().ToString("N")[..8];
    private MudDialog? _dialog;
    /// <summary>Открыт, пока страница держит компонент; false — закрываемся (см. CloseDialog).</summary>
    private bool _visible = true;
    private bool _closing;
    private bool _busy;
    private IDisposable? _hotkeys;

    // Заголовок и кнопки у нас свои, поэтому шапку и крестик Mud не показываем.
    private readonly DialogOptions _options = new()
    {
        MaxWidth = MaxWidth.ExtraSmall,
        CloseButton = false,
        CloseOnEscapeKey = true,
        BackdropClick = true,
        DefaultFocus = DefaultFocus.LastChild
    };

    protected override void OnInitialized()
    {
        _hotkeys = Hotkeys.Subscribe(async e =>
        {
            if (e.Key == "Enter" && !e.InEditable)
            {
                e.Handled = true;
                await Confirm();
            }
        });
    }

    /// <summary>Esc или клик по фону — закрытие идёт тем же путём, что и кнопка «Отмена».</summary>
    private Task OnVisibleChanged(bool visible) => visible || _closing ? Task.CompletedTask : Cancel();

    /// <summary>
    /// Убирает диалог с экрана. Сам MudDialog этого не делает: страница снимает компонент условием,
    /// а его ссылка в MudDialogProvider живёт дальше — модалка осталась бы висеть поверх страницы.
    /// </summary>
    private async Task CloseDialog()
    {
        if (_closing)
            return;

        // Visible гасим раньше самого закрытия: иначе ре-рендер компонента, случившийся до того,
        // как страница его снимет, снова передал бы Visible=true и диалог открылся бы заново.
        _closing = true;
        _visible = false;

        if (_dialog is not null)
            await _dialog.CloseAsync();
    }

    private async Task Cancel()
    {
        if (_busy)
            return;

        await CloseDialog();
        await OnCancel.InvokeAsync();
    }

    private async Task Confirm()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await OnConfirm.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Снимают компонент со страницы и после подтверждения, и по «Отмена» — закрываем диалог здесь.</summary>
    public ValueTask DisposeAsync()
    {
        _hotkeys?.Dispose();
        return new ValueTask(CloseDialog());
    }
}
