@* Диагностика доставок репозитория (docs/TZ_git_integration.md, этап 5B): последние 100 доставок вебхуков и заданий
   дозагрузки истории с фильтром по состоянию — что пришло, сколько попыток, почему не разобралось и когда воркер
   попробует снова (у паузы по лимиту запросов хостинга — время сброса). Ошибку можно повторить (попытки с нуля),
   историю — дозагрузить заново. Жизненный цикл MudDialog — как у MilestoneDialog. *@
@implements IAsyncDisposable
@inject IFlowApi Api
@inject ToastService Toasts

<MudDialog @ref="_dialog" Visible="@_visible" VisibleChanged="OnVisibleChanged" Options="_options" Class="flow-modal git-deliv-modal"
           TitleClass="flow-modal-title" ContentClass="flow-modal-content" ActionsClass="modal-actions">
    <TitleContent>
        <h3>Доставки · @Repository.FullName</h3>
    </TitleContent>
    <DialogContent>
        <div class="git-deliv-bar">
            <div class="seg" role="radiogroup" aria-label="Состояние">
                @foreach (var (status, label) in Filters)
                {
                    var s = status;
                    <button type="button" class="seg-btn @(_status == s ? "on" : "")" role="radio" aria-checked="@(_status == s)"
                            @onclick="() => Filter(s)">@label</button>
                }
            </div>
            <span class="git-deliv-actions">
                <DsButton Variant="secondary" Size="sm" OnClick="Reload">Обновить</DsButton>
                @if (Repository.IsActive)
                {
                    <DsButton Variant="secondary" Size="sm" Icon="history" OnClick="Backfill" Disabled="_busy">Дозагрузить историю</DsButton>
                }
            </span>
        </div>
        @if (_deliveries is null)
        {
            <Skeleton Kind="rows" Count="4" />
        }
        else if (_deliveries.Count == 0)
        {
            <div class="empty"><div class="empty-title">@(_status is null ? "Доставок ещё не было" : "Таких доставок нет")</div></div>
        }
        else
        {
            <MudSimpleTable Dense="true" Elevation="0" Class="git-deliv">
                <thead>
                    <tr><th>Когда</th><th>Событие</th><th>Состояние</th><th>Попытки</th><th>Подробности</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var d in _deliveries)
                    {
                        <tr>
                            <td class="nowrap" title="@d.DeliveryId">@Ru.DateTimeFull(d.ReceivedAt)</td>
                            <td>@GitMeta.EventName(d)</td>
                            <td><span class="git-deliv-state @StateClass(d.Status)">@GitMeta.DeliveryStatusName(d.Status)</span></td>
                            <td class="num">@d.Attempts</td>
                            <td class="git-deliv-error">
                                @if (d.LastError is { } error)
                                {
                                    <span>@error</span>
                                }
                                @if (d.NextAttemptAt is { } next && next > DateTime.UtcNow)
                                {
                                    <span class="hint">снова в @Ru.DateTimeFull(next)</span>
                                }
                            </td>
                            <td>
                                @if (d.Status == GitIntegrationJobStatus.Failed)
                                {
                                    <DsButton Variant="secondary" Size="sm" OnClick="() => Retry(d)" Disabled="_busy">Повторить</DsButton>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </DialogContent>
    <DialogActions>
        <DsButton Variant="secondary" Size="md" OnClick="Close">Закрыть</DsButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public GitRepositoryResponse Repository { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private static readonly (GitIntegrationJobStatus? Status, string Label)[] Filters =
    [
        (null, "Все"), (GitIntegrationJobStatus.Failed, "Ошибки"), (GitIntegrationJobStatus.Pending, "В очереди"),
        (GitIntegrationJobStatus.Done, "Разобраны"), (GitIntegrationJobStatus.Ignored, "Пропущены")
    ];

    private MudDialog? _dialog;
    private bool _visible = true;
    private bool _closing;
    private bool _busy;
    private GitIntegrationJobStatus? _status;
    private List<GitIntegrationJobResponse>? _deliveries;

    private readonly DialogOptions _options = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = false, CloseOnEscapeKey = true, BackdropClick = true };

    protected override async Task OnInitializedAsync()
    {
        // Есть ошибки — открываемся сразу на них: ради них диалог обычно и открывают.
        _status = Repository.FailedDeliveries > 0 ? GitIntegrationJobStatus.Failed : null;
        await Reload();
    }

    private static string StateClass(GitIntegrationJobStatus status) => status switch
    {
        GitIntegrationJobStatus.Failed => "failed",
        GitIntegrationJobStatus.Pending => "pending",
        GitIntegrationJobStatus.Done => "done",
        _ => ""
    };

    private async Task Filter(GitIntegrationJobStatus? status)
    {
        _status = status;
        _deliveries = null;
        await Reload();
    }

    private async Task Reload()
    {
        var result = await Api.GetGitIntegrationJobs(Repository.Id, _status);
        _deliveries = result.Ok ? result.Value!.ToList() : [];
        if (!result.Ok)
            Toasts.Error(result.Error ?? "Не удалось загрузить доставки");
    }

    private async Task Retry(GitIntegrationJobResponse delivery)
    {
        _busy = true;
        var result = await Api.RetryGitIntegrationJob(delivery.Id);
        _busy = false;
        if (!result.Ok)
        {
            Toasts.Error(result.Error ?? "Не удалось повторить");
            return;
        }

        Toasts.Ok("Доставка снова в очереди");
        await Reload();
        await OnChanged.InvokeAsync();
    }

    private async Task Backfill()
    {
        _busy = true;
        var result = await Api.BackfillGitRepository(Repository.Id);
        _busy = false;
        if (!result.Ok)
        {
            Toasts.Error(result.Error ?? "Не удалось поставить дозагрузку");
            return;
        }

        Toasts.Ok("Дозагрузка истории поставлена в очередь");
        await Reload();
    }

    private Task OnVisibleChanged(bool visible) => visible || _closing ? Task.CompletedTask : Close();

    private async Task CloseDialog()
    {
        if (_closing) return;
        _closing = true;
        _visible = false;
        if (_dialog is not null)
            await _dialog.CloseAsync();
    }

    public ValueTask DisposeAsync() => new(CloseDialog());

    private async Task Close()
    {
        await CloseDialog();
        await OnClose.InvokeAsync();
    }
}
