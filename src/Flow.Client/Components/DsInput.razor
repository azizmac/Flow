@* Поле на подложке: label сверху, значение крупным semibold в тёмной подложке с рамкой 1px
   (focus → акцентная рамка и мягкое кольцо, ошибка → danger), строка ошибки под полем.

   Фасад над MudTextField: снаружи API прежний, внутри — поле библиотеки (фокус, маски, счётчик,
   работа внутри MudForm). Подчёркивание Mud выключено (Underline="false") — подложку и рамку рисует наш
   .ds-field-row (app.css); сбросы отступов Material — в mud-overrides.css.

   Type="password" — справа кнопка-«глаз»: показать или скрыть набранное.

   Lines > 1 — многострочное поле (описание шаблона, «о себе»): текст обычного размера, а не крупный заголовочный.
   Compact — то же для однострочного поля в плотной форме или строке списка. *@

<label class="ds-field @(Lines > 1 ? "multiline" : "") @(Compact ? "sm" : "") @(Error is null ? "" : "error") @Class" style="@Style"
       data-esc-revert="@(EscapeReverts ? _original : null)">
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="ds-field-label">@Label</span>
    }
    <span class="ds-field-row">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <Icon Name="@Icon" Size="20" />
        }
        <MudTextField T="string" InputId="@Id" InputType="@InputType" Value="@Value" ValueChanged="OnInput"
                      Placeholder="@Placeholder" MaxLength="@(MaxLength ?? 524288)" Lines="Lines" AutoGrow="@(Lines > 1)" Disabled="Disabled"
                      Immediate="true" Underline="false" Variant="Variant.Text" Margin="Margin.None"
                      OnKeyDown="OnKeyDown" OnBlur="OnBlur" autocomplete="off" spellcheck="false" />
        @if (Type == "password")
        {
            @* mousedown гасится, чтобы фокус и курсор остались в поле: показ пароля не должен прерывать набор. *@
            <button type="button" class="ds-field-reveal" @onclick="() => _revealed = !_revealed" @onclick:preventDefault
                    @onmousedown:preventDefault aria-pressed="@(_revealed ? "true" : "false")"
                    aria-label="@(_revealed ? "Скрыть пароль" : "Показать пароль")" title="@(_revealed ? "Скрыть" : "Показать")"
                    disabled="@Disabled">
                <Icon Name="@(_revealed ? "eye-off" : "eye")" Size="18" />
            </button>
        }
    </span>
    @if (Error is not null)
    {
        <span class="ds-field-error">@Error</span>
    }
</label>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Icon { get; set; }
    /// <summary>text | password | email — как у атрибута type нативного поля.</summary>
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    /// <summary>Потеря фокуса — переименование на месте сохраняется по ней, как по Enter.</summary>
    [Parameter] public EventCallback<FocusEventArgs> OnBlur { get; set; }
    /// <summary>
    /// Переименование на месте: Esc возвращает значение, с которым поле появилось, и снимает фокус — правку
    /// завершает OnBlur, диалог вокруг не закрывается. Делает это flow.js по атрибуту data-esc-revert: перехватчик
    /// Esc у MudDialog нативный, и Razor-овский stopPropagation его не останавливает.
    /// </summary>
    [Parameter] public bool EscapeReverts { get; set; }

    private string _original = "";

    protected override void OnInitialized() => _original = Value;
    /// <summary>Строк у многострочного поля; 1 — обычное поле.</summary>
    [Parameter] public int Lines { get; set; } = 1;
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Пароль показан открытым текстом — кнопка-«глаз» справа в поле; только у Type="password".</summary>
    private bool _revealed;

    private InputType InputType => Type switch
    {
        "password" => _revealed ? MudBlazor.InputType.Text : MudBlazor.InputType.Password,
        "email" => MudBlazor.InputType.Email,
        "number" => MudBlazor.InputType.Number,
        _ => MudBlazor.InputType.Text
    };

    private Task OnInput(string? value) => ValueChanged.InvokeAsync(value ?? "");
}
