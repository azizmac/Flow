@* Срок задачи (или дата начала при Plain) в панели свойств. Правка — DsDateField в виде пилюли (docs/TZ_ui_consistency.md,
   этап 3): календарь в слое Flow, ввод текстом, крестик снимает дату. Без права править — чип срока (просрочен —
   красный, ближайшие 2 дня — акцент) или просто дата для начала.

   Раньше здесь был нативный input[type=date]: он шлёт change на каждое «полное» значение, и пока год набирали с
   клавиатуры, на сервер успевали уйти 0002, 0020, 0202. MudDatePicker разбирает текст по уходу из поля или Enter,
   а Min/Max (±20 лет от сегодня, но не уже сохранённое значение) не дают уйти опечатке в году. *@

@if (CanEdit)
{
    <DsDateField Pill="true" Value="Value" ValueChanged="OnChange" Disabled="Disabled" AriaLabel="@Label" Min="Min" Max="Max" />
}
else if (Value is { } d && Plain)
{
    <span class="meta-v">@Ru.DateOnlyShort(d)</span>
}
else if (Value is { } d2)
{
    <DueChip Value="d2" IsDone="IsDone" />
}
else
{
    <span class="meta-v" style="color:var(--text-tertiary);">—</span>
}

@code {
    [Parameter] public DateOnly? Value { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool IsDone { get; set; }
    [Parameter] public EventCallback<DateOnly?> OnChange { get; set; }
    /// <summary>Подпись поля для скринридера: тот же компонент служит и сроку, и дате начала.</summary>
    [Parameter] public string Label { get; set; } = "Срок";
    /// <summary>Без редактирования — просто дата, без окраски «просрочено» (для даты начала она не имеет смысла).</summary>
    [Parameter] public bool Plain { get; set; }

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    private DateOnly Min => Value is { } v && v < Today.AddYears(-20) ? v : Today.AddYears(-20);

    private DateOnly Max => Value is { } v && v > Today.AddYears(20) ? v : Today.AddYears(20);
}
