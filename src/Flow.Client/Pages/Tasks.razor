@page "/tasks"

<PageTitle>Задачи — Flow</PageTitle>

<FlowTopBar Title="Задачи">
    <div class="search">
        <Icon Name="search" Size="16" />
        <input placeholder="Поиск задач..." />
    </div>
    <FlowButton Variant="primary" Size="sm" Icon="plus">Новая задача</FlowButton>
</FlowTopBar>

<div class="content">
    <div style="position:relative;">
        <div class="filter-btn" @onclick="ToggleFilter">
            <Icon Name="filter" Size="13" />Статус
            <span class="filter-badge">@_statuses.Count(s => s.Active)</span>
            <Icon Name="chevron-down" Size="12" />
        </div>
        @if (_filterOpen)
        {
            <div class="filter-panel">
                @foreach (var s in _statuses)
                {
                    <div class="filter-row @(s.Active ? "checked" : "")" @onclick="() => ToggleStatus(s)">
                        <span>@s.Label</span>
                        <div class="checkbox @(s.Active ? "on" : "")">
                            @if (s.Active)
                            {
                                <Icon Name="check" Size="11" />
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="panel" style="flex:1;">
        <div class="section-title">Задачи · @SampleData.Tasks.Count</div>
        <div style="flex:1;min-height:0;overflow:auto;display:flex;flex-direction:column;">
            @foreach (var t in SampleData.Tasks)
            {
                <div class="task-row" style="cursor:pointer;" @onclick="() => OpenTask(t)">
                    <div class="dot" style="background:@t.Color"></div>
                    <div class="task-title">@t.Title</div>
                    <div class="task-tag" style="width:74px;flex-shrink:0;">@t.Project</div>
                    <div class="task-meta" style="width:74px;flex-shrink:0;">@t.Due</div>
                    <div style="width:90px;flex-shrink:0;display:flex;gap:10px;">
                        <span class="task-meta"><Icon Name="chat" Size="12" />@t.Comments</span>
                        <span class="task-meta"><Icon Name="check" Size="12" />@t.Checklist</span>
                    </div>
                    <Avatar Initials="@t.Initials" Size="22" />
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private bool _filterOpen;
    private List<StatusFilter> _statuses = SampleData.TaskStatuses.Select(s => new StatusFilter(s.Label, s.Active)).ToList();

    private void ToggleFilter() => _filterOpen = !_filterOpen;

    private void ToggleStatus(StatusFilter s) => s.Active = !s.Active;

    private void OpenTask(TaskItem t) => Nav.NavigateTo("/tasks/1");

    private class StatusFilter(string label, bool active)
    {
        public string Label { get; } = label;
        public bool Active { get; set; } = active;
    }
}
