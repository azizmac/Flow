@* Роль в проекте «в строке» — PillSelect: роли с подсказкой, что каждая может, и свои наборы прав (этап 4E) с их
   основой. Allowed — роли, которые actor может выдать (не выше своей); наборы — по базовой роли не выше разрешённых. *@

<PillSelect T="RoleOption" Items="Options" Value="CurrentOption" Disabled="Disabled" OnChange="Select" Current="IsCurrent"
            Label="@(o => o?.Set?.Name ?? Permissions.ProjectRoleLabel(o?.Role ?? Value))" Hint="HintFor"
            ItemClass="role-item" AriaLabel="Сменить роль в проекте" />

@code {
    [Parameter] public ProjectRole Value { get; set; }
    [Parameter] public IReadOnlyList<ProjectRole> Allowed { get; set; } = [ProjectRole.Viewer, ProjectRole.Member, ProjectRole.Developer, ProjectRole.Admin];
    [Parameter] public EventCallback<ProjectRole> OnChange { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Свои наборы прав (этап 4E); выбор набора приходит в OnSetChange, если он задан.</summary>
    [Parameter] public IReadOnlyList<PermissionSetResponse> Sets { get; set; } = [];
    [Parameter] public Guid? SetId { get; set; }
    [Parameter] public EventCallback<(ProjectRole Role, Guid? SetId)> OnSetChange { get; set; }

    /// <summary>Пункт списка: встроенная роль (Set = null) или свой набор с его основой.</summary>
    private sealed record RoleOption(ProjectRole Role, PermissionSetResponse? Set);

    private IEnumerable<RoleOption> Options =>
        Allowed.Select(r => new RoleOption(r, null))
            .Concat(Sets.Where(s => Allowed.Contains(s.BaseRole)).Select(s => new RoleOption(s.BaseRole, s)));

    private RoleOption CurrentOption =>
        SetId is { } id && Sets.FirstOrDefault(s => s.Id == id) is { } set ? new RoleOption(set.BaseRole, set) : new RoleOption(Value, null);

    private bool IsCurrent(RoleOption o) => o.Set is null ? o.Role == Value && SetId is null : o.Set.Id == SetId;

    private static string HintFor(RoleOption o) =>
        o.Set is null ? Permissions.ProjectRoleHint(o.Role) : $"набор · основа «{Permissions.ProjectRoleLabel(o.Set.BaseRole)}»";

    private async Task Select(RoleOption o)
    {
        if (o.Set is { } set)
            await OnSetChange.InvokeAsync((set.BaseRole, set.Id));
        else if (OnSetChange.HasDelegate)
            await OnSetChange.InvokeAsync((o.Role, null));
        else
            await OnChange.InvokeAsync(o.Role);
    }
}
