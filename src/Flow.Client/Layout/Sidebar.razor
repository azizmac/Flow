@* Drawer-nav 240px по Sidebar.dc.html. «Проекты» → /boards; «Задачи» → последний открытый проект (или /boards);
   «Люди» → /users. Дашборды/Настройки — в API ещё нет, показаны неактивными.
   Футер — «это я» (AppState.CurrentUserId из localStorage flow.me, выбирается на странице профиля);
   пока не выбран — приглашение выбрать себя. *@
@implements IDisposable
@inject NavigationManager Nav
@inject AppState State
@inject UserDirectory Users
@inject BrowserInterop Browser

<nav class="sb">
    <div class="sb-brand"><div class="sb-mark">F</div><div class="sb-word">FLOW</div></div>

    <div class="sb-ws" title="Переключение рабочих пространств появится позже">
        <div>
            <div class="sb-ws-name">Flow</div>
            <div class="sb-ws-sub">Workspace</div>
        </div>
        <Icon Name="chevrons" Size="14" Style="color:rgba(255,255,255,0.4)" />
    </div>

    <div class="sb-section">Рабочее пространство</div>

    <a class="sb-item @(IsBoards ? "active" : "")" href="boards"><Icon Name="grid" Size="18" />Проекты</a>
    <a class="sb-item @(IsTasks ? "active" : "")" href="@TasksHref"><Icon Name="check" Size="18" />Задачи</a>
    <a class="sb-item @(IsUsers ? "active" : "")" href="users"><Icon Name="users" Size="18" />Люди</a>
    <span class="sb-item disabled" aria-disabled="true"><Icon Name="chart" Size="18" />Дашборды</span>
    <span class="sb-item disabled" aria-disabled="true"><Icon Name="settings" Size="18" />Настройки</span>

    @if (Me is { } me)
    {
        <a class="sb-foot" href="@($"users/{me.Id}")" title="Мой профиль">
            <Avatar User="me" Size="32" />
            <div style="flex:1;min-width:0;">
                <div class="sb-un">@me.FullName</div>
                <div class="sb-ur">@(string.IsNullOrEmpty(me.JobTitle) ? "@" + me.Username : me.JobTitle)</div>
            </div>
            <Icon Name="chevrons" Size="14" Style="color:rgba(255,255,255,0.35)" />
        </a>
    }
    else
    {
        <a class="sb-foot" href="users" title="Выберите свой профиль на странице «Люди»">
            <span class="sb-av ghost"><Icon Name="user" Size="16" /></span>
            <div style="flex:1;min-width:0;">
                <div class="sb-un">Кто вы?</div>
                <div class="sb-ur">Выберите профиль</div>
            </div>
        </a>
    }
</nav>

@code {
    private string Path => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');

    private bool IsBoards => Path is "" or "boards";

    private bool IsTasks => Path.StartsWith("boards/", StringComparison.OrdinalIgnoreCase)
                            || Path.StartsWith("tasks/", StringComparison.OrdinalIgnoreCase);

    private bool IsUsers => Path is "users" || Path.StartsWith("users/", StringComparison.OrdinalIgnoreCase);

    private string TasksHref => State.LastBoardId is { } id ? $"boards/{id}" : "boards";

    private UserResponse? Me => Users.Find(State.CurrentUserId);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        State.Changed += OnStateChanged;
        Users.Changed += OnStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var stored = await Browser.StorageGetAsync("flow.me");
        if (Guid.TryParse(stored, out var id))
        {
            State.SetCurrentUser(id);
            if (!Users.IsLoaded)
                await Users.EnsureLoadedAsync();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        State.Changed -= OnStateChanged;
        Users.Changed -= OnStateChanged;
    }
}
