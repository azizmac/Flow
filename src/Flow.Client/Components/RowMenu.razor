@* Меню «…» задачи: Открыть · Переименовать · Скопировать код · — · Удалить.

   Слой — MudMenu: позиция пересчитывается при скролле и ресайзе, клавиатура и закрытие по Esc
   работают без нашего JS. Вид остаётся прежним: .flow-pop у слоя, .pop-item у пунктов.

   Открытием управляем сами (@bind-Open), а не встроенным активатором: строка задачи кликабельна,
   и кнопке нужен собственный обработчик, гасящий всплытие, — иначе клик по «…» открыл бы ещё и задачу.
   Фокус при этом остаётся на кнопке — так и надо: перехватчик клавиш MudMenu слушает активатор,
   и стрелки, Enter и Esc работают сами. Если увести фокус внутрь поповера, стрелки перестают ходить. *@

<MudMenu @bind-Open="_open" PopoverClass="flow-pop" ListClass="flow-pop-list" AnchorOrigin="Origin.BottomRight"
         TransformOrigin="Origin.TopRight" Dense="true" DropShadow="false" Ripple="false" AriaLabel="Действия">
    <ActivatorContent>
        <DsIconButton Icon="more" Size="@Size" Title="Действия" Style="@Style"
                      AriaHasPopup="menu" AriaExpanded="_open" OnClick="Toggle" />
    </ActivatorContent>
    <ChildContent>
        @if (ShowOpen)
        {
            <MudMenuItem Class="pop-item" OnClick="OnOpen"><Icon Name="view" Size="15" />Открыть</MudMenuItem>
        }
        @if (ShowRename)
        {
            <MudMenuItem Class="pop-item" OnClick="OnRename"><Icon Name="edit" Size="15" />Переименовать</MudMenuItem>
        }
        <MudMenuItem Class="pop-item" OnClick="OnCopy"><Icon Name="copy" Size="15" />Скопировать код</MudMenuItem>
        @if (ShowDelete)
        {
            <div class="pop-sep" role="separator"></div>
            <MudMenuItem Class="pop-item danger" OnClick="OnDelete"><Icon Name="trash" Size="15" />Удалить</MudMenuItem>
        }
    </ChildContent>
</MudMenu>

@code {
    [Parameter] public bool ShowOpen { get; set; } = true;
    /// <summary>Пункты, требующие прав (Permissions.CanEditTask / CanManageBoards); без них меню — открыть и скопировать.</summary>
    [Parameter] public bool ShowRename { get; set; } = true;
    [Parameter] public bool ShowDelete { get; set; } = true;
    [Parameter] public int Size { get; set; } = 26;
    [Parameter] public string? Style { get; set; }
    [Parameter] public EventCallback OnOpen { get; set; }
    [Parameter] public EventCallback OnRename { get; set; }
    [Parameter] public EventCallback OnCopy { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private bool _open;

    private void Toggle() => _open = !_open;
}
