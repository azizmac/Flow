@* Скелетоны на время загрузки: Kind="cards" — сетка карточек проектов, Kind="rows" — строки списка задач.
   Форма повторяет реальный контент, чтобы при подстановке данных ничего не прыгало.

   Полосы — MudSkeleton (волна и цвет приходят из темы, Palette.Skeleton); компоновка под наши экраны
   остаётся здесь, потому что повторяет конкретную вёрстку карточки, строки и карточки задачи. *@

<div class="skel-wrap" role="status" aria-busy="true" aria-live="polite">
    <span class="sr-only">Загрузка…</span>

    @if (Kind == "task")
    {
        <div class="task-page-main" aria-hidden="true">
            <div>
                <MudSkeleton Width="64px" Height="12px" />
                <MudSkeleton Width="44%" Height="30px" Style="margin-top:12px;" />
            </div>
            <div>
                <MudSkeleton Width="88px" Height="14px" />
                <MudSkeleton Height="180px" Style="margin-top:10px;border-radius:var(--r-lg);" />
            </div>
        </div>
        <div class="task-page-side" aria-hidden="true">
            <div class="side-card">
                @for (var i = 0; i < 4; i++)
                {
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
                        <MudSkeleton Width="64px" Height="12px" />
                        <MudSkeleton Width="110px" Height="16px" />
                    </div>
                }
            </div>
        </div>
    }
    else if (Kind == "cards")
    {
        <div class="board-grid">
            @for (var i = 0; i < Count; i++)
            {
                <div class="board-card skel-card" aria-hidden="true">
                    <MudSkeleton Width="52px" Height="22px" Style="border-radius:var(--radius-pill);" />
                    <div>
                        <MudSkeleton Width="62%" Height="17px" />
                        <MudSkeleton Width="38%" Height="12px" Style="margin-top:8px;" />
                    </div>
                    <div class="board-card-pills">
                        <MudSkeleton Width="78px" Height="22px" Style="border-radius:var(--radius-pill);" />
                        <MudSkeleton Width="66px" Height="22px" Style="border-radius:var(--radius-pill);" />
                        <MudSkeleton Width="88px" Height="22px" Style="border-radius:var(--radius-pill);" />
                    </div>
                    <div class="board-card-foot">
                        <MudSkeleton Width="64px" Height="12px" />
                        <MudSkeleton Width="96px" Height="12px" />
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="panel">
            <div class="list-cols list-head"><div>Код</div><div>Задача</div><div>Кто</div><div>Статус</div><div>Создана</div><div></div></div>
            <div class="panel-rows">
                @for (var i = 0; i < Count; i++)
                {
                    <div class="task-row list-cols skel-row" aria-hidden="true">
                        <MudSkeleton Width="52px" Height="12px" />
                        <MudSkeleton Width="@($"{RowWidths[i % RowWidths.Length]}%")" Height="13px" />
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="24px" Height="24px" />
                        <MudSkeleton Width="104px" Height="24px" Style="border-radius:8px;" />
                        <MudSkeleton Width="44px" Height="12px" />
                        <div></div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    /// <summary>cards — экран проектов, rows — список задач, task — карточка задачи на всю страницу.</summary>
    [Parameter] public string Kind { get; set; } = "rows";
    [Parameter] public int Count { get; set; } = 4;

    // Разная длина «названий» — ровная стопка одинаковых полос выглядит мертвее.
    private static readonly int[] RowWidths = [58, 34, 72, 46, 64];
}
