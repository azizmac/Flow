<component name="ProjectRunConfigurationManager">
  <!-- Data stack (включая OpenCode) — Docker, api и интерфейс — процесс Rider на :5000.
       Перед первым запуском нужен ручной init под свою ОС. .env Compose не задаёт автоматически
       настройки хост-процесса; его каталог repository-workspaces не является общим Docker-томом.
       Для готовой проверки агента с общим томом использовать Flow Only. См. docs/OpenCode_setup.md. -->
  <configuration default="false" name="Flow (api debug)" type="LaunchSettings" factoryName=".NET Launch Settings Profile">
    <option name="LAUNCH_PROFILE_PROJECT_FILE_PATH" value="$PROJECT_DIR$/src/Flow.Api/Flow.Api.csproj" />
    <option name="LAUNCH_PROFILE_TFM" value="net10.0" />
    <option name="LAUNCH_PROFILE_NAME" value="http" />
    <option name="USE_MONO" value="0" />
    <option name="RUNTIME_ARGUMENTS" value="" />
    <option name="GENERATE_APPLICATIONHOST_CONFIG" value="1" />
    <option name="SHOW_IIS_EXPRESS_OUTPUT" value="0" />
    <option name="SEND_DEBUG_REQUEST" value="1" />
    <option name="ADDITIONAL_IIS_EXPRESS_ARGUMENTS" value="" />
    <option name="AUTO_ATTACH_CHILDREN" value="0" />
    <option name="MIXED_MODE_DEBUG" value="0" />
    <method v="2">
      <option name="RunConfigurationTask" enabled="true" run_configuration_name="Flow (data stack)" run_configuration_type="docker-deploy" />
      <option name="Build" />
    </method>
  </configuration>
</component>
