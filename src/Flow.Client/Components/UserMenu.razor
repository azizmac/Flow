@* Меню «…» человека: Открыть профиль · Скопировать @username · (Owner) Деактивировать / Активировать.

   Слой — MudMenu, как у RowMenu: вид от .flow-pop / .pop-item, поведение от библиотеки.
   Открытием управляем сами — строка человека кликабельна, и клик по «…» не должен её открывать.
   Фокус остаётся на кнопке: перехватчик клавиш MudMenu слушает активатор (см. RowMenu). *@

<MudMenu @bind-Open="_open" PopoverClass="flow-pop" ListClass="flow-pop-list" AnchorOrigin="Origin.BottomRight"
         TransformOrigin="Origin.TopRight" Dense="true" DropShadow="false" Ripple="false" AriaLabel="Действия">
    <ActivatorContent>
        <DsIconButton Icon="more" Size="@Size" Title="Действия" Style="@Style"
                      AriaHasPopup="menu" AriaExpanded="_open" OnClick="Toggle" />
    </ActivatorContent>
    <ChildContent>
        <MudMenuItem Class="pop-item" OnClick="OnOpen"><Icon Name="view" Size="15" />Открыть профиль</MudMenuItem>
        <MudMenuItem Class="pop-item" OnClick="OnCopy"><Icon Name="at" Size="15" />Скопировать @@username</MudMenuItem>
        @if (CanDeactivate)
        {
            <div class="pop-sep" role="separator"></div>
            @if (User.IsActive)
            {
                <MudMenuItem Class="pop-item danger" OnClick="OnDeactivate"><Icon Name="user-off" Size="15" />Деактивировать</MudMenuItem>
            }
            else
            {
                <MudMenuItem Class="pop-item" OnClick="OnActivate"><Icon Name="user" Size="15" />Активировать</MudMenuItem>
            }
        }
    </ChildContent>
</MudMenu>

@code {
    [Parameter, EditorRequired] public UserResponse User { get; set; } = default!;
    [Parameter] public int Size { get; set; } = 26;
    [Parameter] public string? Style { get; set; } = "color:rgba(255,255,255,0.4)";
    /// <summary>Показывать пункт деактивации/активации — Permissions.CanDeactivate(me, User).</summary>
    [Parameter] public bool CanDeactivate { get; set; }
    [Parameter] public EventCallback OnOpen { get; set; }
    [Parameter] public EventCallback OnCopy { get; set; }
    [Parameter] public EventCallback OnDeactivate { get; set; }
    [Parameter] public EventCallback OnActivate { get; set; }

    private bool _open;

    private void Toggle() => _open = !_open;
}
