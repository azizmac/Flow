@* Слайдер справа поверх main (сайдбар не затемняется). Всегда смонтирован — открытие/закрытие через класс,
   чтобы CSS-переходы (translateX) можно было прервать. Контент остаётся на время выходной анимации (160ms).

   Фокус держит MudFocusTrap: при открытии уходит внутрь и не выпускается Tab'ом — раньше это делал
   самописный обход фокусируемых элементов в flow.js. Возврат фокуса на элемент, с которого открыли,
   остаётся за нами (стек в flow.js): у ловушки библиотеки такого поведения нет. *@
@inject BrowserInterop Browser

<div class="drawer-scrim @(Open ? "in" : "")" @onclick="RequestClose"></div>
<div class="drawer @(Open ? "in" : "") @(_closing ? "closing" : "")" role="dialog" aria-modal="true" aria-hidden="@(!Open)">
    @if (Open || _closing)
    {
        <MudFocusTrap Disabled="@(!Open)" DefaultFocus="DefaultFocus.FirstChild">
            @ChildContent
        </MudFocusTrap>
    }
</div>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _wasOpen;
    private bool _closing;
    private CancellationTokenSource? _closeCts;

    protected override void OnParametersSet()
    {
        if (!_wasOpen && Open)
            _ = Browser.PushFocusAsync();

        if (_wasOpen && !Open)
        {
            _closing = true;
            _ = Browser.PopFocusAsync();
            _closeCts?.Cancel();
            _closeCts = new CancellationTokenSource();
            _ = EndClosing(_closeCts.Token);
        }
        else if (Open)
        {
            _closing = false;
            _closeCts?.Cancel();
        }

        _wasOpen = Open;
    }

    /// <summary>Контент живёт до конца выходной анимации, иначе панель уезжала бы пустой.</summary>
    private async Task EndClosing(CancellationToken ct)
    {
        try
        {
            await Task.Delay(170, ct);
            _closing = false;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private Task RequestClose() => OnClose.InvokeAsync();
}
