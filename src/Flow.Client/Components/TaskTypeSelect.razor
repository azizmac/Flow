@* Селект типа задачи «в строке» — как StatusSelect: триггер-пилюля + MudMenu. Архивные типы не предлагаются,
   но текущий тип задачи виден, даже если его убрали в архив (TaskMeta.Selectable). *@

<MudMenu @bind-Open="_open" PopoverClass="flow-pop" ListClass="flow-pop-list" AnchorOrigin="Origin.BottomLeft"
         TransformOrigin="Origin.TopLeft" Dense="true" DropShadow="false" Ripple="false" AriaLabel="Сменить тип задачи">
    <ActivatorContent>
        <div class="status-sel @(Disabled ? "disabled" : "")" @onclick="Toggle" @onclick:stopPropagation
             @onkeydown="OnKey" @onkeydown:stopPropagation
             role="button" tabindex="@(Disabled ? -1 : 0)" aria-haspopup="listbox" aria-disabled="@(Disabled ? "true" : "false")"
             aria-expanded="@(_open ? "true" : "false")" title="@(Disabled ? "Сохраняем…" : "Сменить тип")">
            @if (Current is { } cur)
            {
                <TaskTypeIcon Kind="cur.Kind" Name="@cur.Name" Size="13" />
            }
            <span class="lbl">@(Current?.Name ?? "—")</span>
            <Icon Name="chevrons" Size="12" />
        </div>
    </ActivatorContent>
    <ChildContent>
        @foreach (var t in TaskMeta.Selectable(Types, Value))
        {
            <MudMenuItem Class="@($"pop-item {(t.Id == Value ? "cur" : "")}")" OnClick="() => Select(t)">
                <TaskTypeIcon Kind="t.Kind" Name="@t.Name" Size="13" />@t.Name
            </MudMenuItem>
        }
    </ChildContent>
</MudMenu>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TaskTypeResponse> Types { get; set; } = [];
    [Parameter] public Guid Value { get; set; }
    [Parameter] public EventCallback<Guid> OnChange { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private bool _open;

    private TaskTypeResponse? Current => Types.FirstOrDefault(t => t.Id == Value);

    private void OnKey(KeyboardEventArgs e)
    {
        if (!Disabled && e.Key is "Enter" or " " or "ArrowDown")
            _open = true;
    }

    private void Toggle()
    {
        if (!Disabled)
            _open = !_open;
    }

    private async Task Select(TaskTypeResponse t)
    {
        _open = false;
        if (t.Id != Value)
            await OnChange.InvokeAsync(t.Id);
    }
}
