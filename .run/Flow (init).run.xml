<component name="ProjectRunConfigurationManager">
  <!-- Общая сеть flow-network и внешние тома данных (docker/data/init-env.ps1). Идемпотентно, секунда
       работы; стоит шагом «Before launch» у всех конфигураций, которые поднимают контейнеры, потому что
       оба стека объявляют сеть и тома как external и без них compose падает на первом же запуске.
       Скрипт — PowerShell (Windows). На macOS/Linux: INTERPRETER_PATH = /bin/sh, INTERPRETER_OPTIONS
       пустые, SCRIPT_PATH = docker/data/init-env.sh. -->
  <configuration default="false" name="Flow (init)" type="ShConfigurationType">
    <option name="SCRIPT_TEXT" value="" />
    <option name="INDEPENDENT_SCRIPT_PATH" value="true" />
    <option name="SCRIPT_PATH" value="$PROJECT_DIR$/docker/data/init-env.ps1" />
    <option name="SCRIPT_OPTIONS" value="" />
    <option name="INDEPENDENT_SCRIPT_WORKING_DIRECTORY" value="true" />
    <option name="SCRIPT_WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <option name="INDEPENDENT_INTERPRETER_PATH" value="true" />
    <option name="INTERPRETER_PATH" value="powershell.exe" />
    <option name="INTERPRETER_OPTIONS" value="-NoProfile -ExecutionPolicy Bypass -File" />
    <option name="EXECUTE_IN_TERMINAL" value="false" />
    <option name="EXECUTE_SCRIPT_FILE" value="true" />
    <envs />
    <method v="2" />
  </configuration>
</component>
