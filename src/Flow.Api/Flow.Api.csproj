<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Flow.Application\Flow.Application.csproj" />
        <ProjectReference Include="..\Flow.Client\Flow.Client.csproj" />
        <ProjectReference Include="..\Flow.Auth\Flow.Auth.csproj" />
        <ProjectReference Include="..\Flow.Infrastructure\Flow.Infrastructure.csproj" />
        <ProjectReference Include="..\Flow.Shared\Flow.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Нужно самому startup-проекту для dotnet ef (DbContext живёт в Flow.Infrastructure). -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!-- Swagger: документ OpenAPI строит встроенный генератор ASP.NET Core, Swashbuckle даёт только UI (см. OpenApi/SwaggerSetup). -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

</Project>
