@* Строка задачи в списке проекта: код · название (+описание) · исполнитель (аватар) · селект статуса · дата · меню «…».
   Клик по строке (вне селекта/меню) → OnOpen. Переименование — инлайн, Enter/blur сохраняет, Esc отменяет. *@
@inject BrowserInterop Browser

<div class="task-row list-cols @(IsDone ? "done" : "") @(Selected ? "sel" : "") @(Flash ? "flash" : "")"
     id="@ElementId" @onclick="Open" @onkeydown="OnRowKey" @key="Item.Id"
     role="button" tabindex="0" aria-label="@($"{Item.Code}: {Item.Title}")">
    <div class="code">@Item.Code</div>
    <div class="task-cell-title">
        <div class="task-title">
            @if (_renaming)
            {
                <input id="@_inputId" value="@_title" maxlength="500"
                       @oninput="e => _title = e.Value?.ToString() ?? string.Empty"
                       @onkeydown="OnRenameKey" @onblur="CommitRename"
                       @onclick:stopPropagation />
            }
            else
            {
                @Item.Title
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Item.Description))
        {
            <div class="task-desc">@Ru.PlainFirstLine(Item.Description)</div>
        }
        @if (Item.DueDate is { } due || Item.CommentCount > 0)
        {
            <div class="task-meta-chips">
                @if (Item.DueDate is { } d)
                {
                    <DueChip Value="d" IsDone="IsDone" />
                }
                @if (Item.CommentCount > 0)
                {
                    <span class="count-chip" title="@Ru.Comments(Item.CommentCount)"><Icon Name="message" Size="12" />@Item.CommentCount</span>
                }
            </div>
        }
    </div>
    <div>
        <AssigneeSelect Compact="true" Value="Item.AssigneeId" Disabled="!CanAssign" OnlyUserId="OnlyAssigneeId" OnChange="id => OnAssign.InvokeAsync((Item, id))" />
    </div>
    <div>
        @if (CanEdit)
        {
            <StatusSelect Statuses="Statuses" Value="Item.StatusId" OnChange="id => OnStatusChange.InvokeAsync((Item, id))" />
        }
        else
        {
            var st = Statuses.FirstOrDefault(x => x.Id == Item.StatusId);
            <span class="status-pill" @onclick:stopPropagation><span class="sd" style="background:@StatusColors.For(st?.Type)"></span>@(st?.Name ?? "—")</span>
        }
    </div>
    <div class="task-date" title="@Ru.DateTimeFull(Item.CreatedAt)">@Ru.DateShort(Item.CreatedAt)</div>
    <div>
        <RowMenu OnOpen="Open" ShowRename="CanEdit" ShowDelete="CanEdit" OnRename="StartRename" OnCopy="() => OnCopy.InvokeAsync(Item)" OnDelete="() => OnDelete.InvokeAsync(Item)" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TaskResponse Item { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<StatusResponse> Statuses { get; set; } = [];
    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool Flash { get; set; }
    /// <summary>Права actor'а на эту задачу (Permissions.CanEditTask / CanAssign); без них — только просмотр.</summary>
    [Parameter] public bool CanEdit { get; set; } = true;
    [Parameter] public bool CanAssign { get; set; } = true;
    [Parameter] public Guid? OnlyAssigneeId { get; set; }
    [Parameter] public EventCallback<TaskResponse> OnOpen { get; set; }
    [Parameter] public EventCallback<(TaskResponse Task, Guid StatusId)> OnStatusChange { get; set; }
    [Parameter] public EventCallback<(TaskResponse Task, Guid? UserId)> OnAssign { get; set; }
    [Parameter] public EventCallback<(TaskResponse Task, string Title)> OnRename { get; set; }
    [Parameter] public EventCallback<TaskResponse> OnCopy { get; set; }
    [Parameter] public EventCallback<TaskResponse> OnDelete { get; set; }

    public static string ElementIdFor(Guid id) => "task-" + id.ToString("N");

    private string ElementId => ElementIdFor(Item.Id);
    private readonly string _inputId = "tr-" + Guid.NewGuid().ToString("N")[..8];
    private bool _renaming;
    private string _title = "";
    private bool _cancelled;

    private bool IsDone => Statuses.FirstOrDefault(s => s.Id == Item.StatusId)?.IsFinal == true;

    private Task Open() => _renaming ? Task.CompletedTask : OnOpen.InvokeAsync(Item);

    // Строка — не нативная кнопка, поэтому Enter/Space открываем вручную.
    // Стрелки не перехватываем: ими HotkeyService листает задачи.
    private Task OnRowKey(KeyboardEventArgs e) =>
        !_renaming && (e.Key == "Enter" || e.Key == " ") ? Open() : Task.CompletedTask;

    public async Task StartRename()
    {
        if (!CanEdit) return;
        _title = Item.Title;
        _renaming = true;
        _cancelled = false;
        StateHasChanged();
        await Task.Yield();
        await Browser.FocusAsync(_inputId, select: true);
    }

    private async Task OnRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CommitRename();
        }
        else if (e.Key == "Escape")
        {
            _cancelled = true;
            _renaming = false;
        }
    }

    private async Task CommitRename()
    {
        if (!_renaming || _cancelled)
            return;

        _renaming = false;
        var title = _title.Trim();
        if (title.Length == 0 || title == Item.Title)
            return;

        await OnRename.InvokeAsync((Item, title));
    }
}
