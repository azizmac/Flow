@page "/account/change-password"
@model Flow.Auth.Pages.Account.ChangePasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Смена пароля — Flow</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/_content/Flow.Auth/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Flow.Auth/css/auth.css" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/_content/Flow.Auth/brand/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/_content/Flow.Auth/brand/favicon.png" />
</head>
<body>
    <main class="login">
        <div class="login-card">
            <div class="login-brand">
                <span class="login-mark">
                    <svg viewBox="0 0 96 96" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Flow" focusable="false">
                        <path fill="currentColor" d="M8.05 50C22 30 34 70 48 50C62 30 74 70 87.95 50A40 40 0 0 0 8.05 50Z" />
                        <path fill="var(--brand-blue)" d="M8.05 50C22 30 34 70 48 50C62 30 74 70 87.95 50A40 40 0 0 1 8.05 50Z" />
                    </svg>
                </span>
                <span class="login-name">Flow</span>
            </div>
            <h1 class="login-title">Смените пароль</h1>
            @if (Model.Forced)
            {
                <p class="login-hint" style="margin-top:-15px;">Этот пароль задали за вас. Придумайте свой, не короче 8 символов, и вход продолжится.</p>
            }

            <form method="post" class="login-form" autocomplete="on">
                <input type="hidden" asp-for="ReturnUrl" />

                <label class="ds-field @(Model.Error is not null ? "error" : "")">
                    <span class="ds-field-label">Текущий пароль</span>
                    <span class="ds-field-row">
                        <input asp-for="Input.CurrentPassword" type="password" placeholder="••••••••" autocomplete="current-password" autofocus="@(!Model.ConfirmKeep)" />
                    </span>
                </label>

                <label class="ds-field @(Model.Error is not null ? "error" : "")">
                    <span class="ds-field-label">Новый пароль</span>
                    <span class="ds-field-row">
                        <input asp-for="Input.NewPassword" type="password" placeholder="не короче 8 символов" autocomplete="new-password" />
                    </span>
                </label>

                <label class="ds-field @(Model.Error is not null ? "error" : "")">
                    <span class="ds-field-label">Ещё раз</span>
                    <span class="ds-field-row">
                        <input asp-for="Input.ConfirmPassword" type="password" placeholder="••••••••" autocomplete="new-password" />
                    </span>
                </label>

                @if (Model.Error is not null)
                {
                    <div class="ds-field-error" role="alert">@Model.Error</div>
                }

                <button type="submit" class="ds-btn full">Сохранить и войти</button>
            </form>

            @if (Model.Forced)
            {
                @* Отдельная форма: у «Оставить» свой обработчик, и Required полей смены пароля ему не мешают. *@
                <form method="post" asp-page-handler="Keep" class="login-keep">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <button type="submit" class="ds-btn ghost full">Оставить пароль как есть</button>
                </form>
            }
        </div>
    </main>

    @if (Model.ConfirmKeep)
    {
        @* Предупреждение рисует сервер, без скриптов: безопасный выход — ссылка обратно на форму (в фокусе по умолчанию),
           риск принимается только второй, явной отправкой с confirm=true. *@
        <div class="auth-scrim">
            <div class="auth-dialog" role="alertdialog" aria-modal="true" aria-labelledby="keep-title" aria-describedby="keep-text">
                <span class="auth-dialog-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3 2.5 20h19L12 3Z" /><path d="M12 10v4.5" /><path d="M12 17.5h.01" />
                    </svg>
                </span>
                <h2 id="keep-title" class="auth-dialog-title">Оставить пароль, заданный не вами?</h2>
                <div id="keep-text" class="auth-dialog-text">
                    <p>Этот пароль придумали за вас: его знает тот, кто создавал учётную запись или сбрасывал пароль, а у базовой учётной записи он стандартный и есть в документации. Любой, кто его знает, сможет войти под вашим именем.</p>
                    <p class="auth-dialog-risk">Оставляя его, вы берёте этот риск на себя. Flow больше не будет требовать смены — сменить пароль можно позже в профиле.</p>
                </div>
                <div class="auth-dialog-actions">
                    <form method="post" asp-page-handler="Keep">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <input type="hidden" name="confirm" value="true" />
                        <button type="submit" class="ds-btn danger">Оставить, риск беру на себя</button>
                    </form>
                    <a class="ds-btn" asp-page="/Account/ChangePassword" asp-route-ReturnUrl="@Model.ReturnUrl" autofocus>Сменить пароль</a>
                </div>
            </div>
        </div>
    }
</body>
</html>
