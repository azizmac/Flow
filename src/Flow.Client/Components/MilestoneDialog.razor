@* Диалог вехи (docs/TZ_task_views.md §6): создание и правка — имя, описание, целевая дата и (этап 2H) проекты, с которыми
   веха общая: в их задачи тоже можно положить эту веху. Предлагаются проекты, где у человека есть право ManageMilestones —
   его же требует сервер. Каркас и жизненный цикл — как у SprintDialog: MudDialog, фокус на имя, ошибка сервера под полями. *@
@implements IAsyncDisposable
@inject IFlowApi Api
@inject BrowserInterop Browser
@inject ProjectAccessState Access

<MudDialog @ref="_dialog" Visible="@_visible" VisibleChanged="OnVisibleChanged" Options="_options" Class="flow-modal"
           TitleClass="flow-modal-title" ContentClass="flow-modal-content" ActionsClass="modal-actions">
    <TitleContent>
        <h3>@(Milestone is null ? "Новая веха" : "Веха")</h3>
    </TitleContent>
    <DialogContent>
        <DsInput Id="md-name" Label="Название" MaxLength="80" Placeholder="Релиз 1.0" Value="@_name" ValueChanged="v => _name = v" />
        <DsInput Id="md-desc" Label="Описание (необязательно)" MaxLength="2000" Value="@_description" ValueChanged="v => _description = v" />
        <div class="sd-dates">
            <DsDateField Label="Целевая дата" Value="@DsDateField.Of(_target)" ValueChanged="d => _target = DsDateField.At(d)" Class="sd-date" />
        </div>
        @if (_shareable.Count > 0)
        {
            <DsSelect T="Guid" Multiple="true" Label="Общая с проектами" SelectedValues="_shared" SelectedValuesChanged="v => _shared = v.ToHashSet()"
                      Class="md-shared" MultiSelectionTextFunc="@(ids => ids.Count == 0 ? "только этот проект" : string.Join(", ", ids.Select(KeyOf)))">
                @foreach (var b in _shareable)
                {
                    <MudSelectItem T="Guid" Value="b.Id">@b.Key · @b.Name</MudSelectItem>
                }
            </DsSelect>
            <div class="hint">В общую веху кладут задачи всех отмеченных проектов, прогресс считается по всем.</div>
        }
        @if (_error is not null)
        {
            <div class="ds-field-error">@_error</div>
        }
    </DialogContent>
    <DialogActions>
        <DsButton Variant="secondary" Size="md" OnClick="Close" Disabled="_busy">Отмена</DsButton>
        <DsButton Variant="primary" Size="md" OnClick="Save" Disabled="_busy" Busy="_busy">@(Milestone is null ? "Создать" : "Сохранить")</DsButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public Guid BoardId { get; set; }
    /// <summary>Веха для правки; при создании — null.</summary>
    [Parameter] public MilestoneResponse? Milestone { get; set; }
    [Parameter] public EventCallback<MilestoneResponse> OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private MudDialog? _dialog;
    private bool _visible = true;
    private bool _closing;
    private bool _busy;
    private string _name = "";
    private string _description = "";
    private DateTime? _target;
    private string? _error;
    private List<BoardResponse> _shareable = [];
    private HashSet<Guid> _shared = [];

    private readonly DialogOptions _options = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = false, CloseOnEscapeKey = true, BackdropClick = true };

    protected override async Task OnInitializedAsync()
    {
        _name = Milestone?.Name ?? "";
        _description = Milestone?.Description ?? "";
        _target = Milestone?.TargetDate?.ToDateTime(TimeOnly.MinValue);
        _shared = (Milestone?.SharedBoardIds ?? []).ToHashSet();
        await Access.EnsureLoadedAsync();
        if (await Api.GetBoards() is { Ok: true } boards)
            // Уже отмеченный проект остаётся в списке, даже если права в нём у человека нет: иначе он молча пропал бы из вехи.
            _shareable = boards.Value!.Where(b => b.Id != BoardId
                    && (Permissions.CanManageMilestones(Access.For(b.Id)) || _shared.Contains(b.Id)))
                .OrderBy(b => b.Key).ToList();
        await Task.Delay(50);
        await Browser.FocusAsync("md-name", select: true);
    }

    private async Task Save()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Назовите веху.";
            return;
        }

        var target = _target is { } d ? DateOnly.FromDateTime(d) : (DateOnly?)null;
        var description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim();
        _busy = true;
        var result = Milestone is null
            ? await Api.CreateMilestone(BoardId, new CreateMilestoneRequest(_name.Trim(), description, target))
            : await Api.UpdateMilestone(Milestone.Id, new UpdateMilestoneRequest(_name.Trim(), description, ClearDescription: description is null,
                TargetDate: target, ClearTargetDate: target is null));
        if (result.Ok && !_shared.SetEquals(result.Value!.SharedBoardIds ?? []))
            result = await Api.ShareMilestone(result.Value!.Id, new ShareMilestoneRequest(_shared.ToList()));
        _busy = false;

        if (!result.Ok)
        {
            _error = result.Error ?? "Не удалось сохранить веху";
            return;
        }

        await CloseDialog();
        await OnSaved.InvokeAsync(result.Value!);
    }

    private string KeyOf(string id) => Guid.TryParse(id, out var g) ? _shareable.FirstOrDefault(b => b.Id == g)?.Key ?? "?" : id;

    private Task OnVisibleChanged(bool visible) => visible || _closing ? Task.CompletedTask : Close();

    private async Task CloseDialog()
    {
        if (_closing) return;
        _closing = true;
        _visible = false;
        if (_dialog is not null)
            await _dialog.CloseAsync();
    }

    public ValueTask DisposeAsync() => new(CloseDialog());

    private async Task Close()
    {
        if (_busy) return;
        await CloseDialog();
        await OnClose.InvokeAsync();
    }
}
