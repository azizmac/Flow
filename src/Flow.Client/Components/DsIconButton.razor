@* Круглая кнопка с иконкой. Variant: ghost | accent | solid | glass. Иконка = size × 0.5.

   Фасад над MudIconButton: API прежний, поведение (фокус, disabled, отмена всплытия клика) — от библиотеки.
   Размер задаётся в пикселях, поэтому иконка кладётся в ChildContent, а не в параметр Icon: перечисление
   Size у MudBlazor (Small/Medium/Large) не даёт нужных 24/30/34. *@

<MudIconButton id="@Id" Class="@($"ds-iconbtn {Variant} {Class}")" Style="@($"width:{Size}px;height:{Size}px;{Style}")"
               Disabled="@Disabled" title="@Title" aria-label="@Title"
               aria-haspopup="@AriaHasPopup" aria-expanded="@(AriaHasPopup is null ? null : AriaExpanded ? "true" : "false")"
               Ripple="false" ClickPropagation="@(!StopPropagation)" OnClick="OnClick">
    <Icon Name="@Icon" Size="@IconSize" />
</MudIconButton>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter] public string Variant { get; set; } = "ghost";
    [Parameter] public int Size { get; set; } = 30;
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool StopPropagation { get; set; } = true;
    /// <summary>Если кнопка открывает слой — "menu"/"listbox"/"dialog"; тогда же отдаём aria-expanded.</summary>
    [Parameter] public string? AriaHasPopup { get; set; }
    [Parameter] public bool AriaExpanded { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    private int IconSize => (int)Math.Round(Size * 0.5);
}
