@* Поле «Веха» задачи (docs/TZ_task_views.md §6): MudSelect из открытых вех проекта и «Нет». Закрытая веха в список
   не попадает — новые задачи в неё не добавляют; если задача уже в ней, она видна выключенным пунктом.
   Guid.Empty — «Нет»: null MudSelect рисует пустым. *@
@inject IFlowApi Api

@if (CanEdit)
{
    <MudSelect T="Guid" Value="@(Value ?? Guid.Empty)" ValueChanged="Change" Disabled="Disabled" Dense="true" Underline="false"
               Variant="Variant.Text" Margin="Margin.None" PopoverClass="flow-pop" Class="sprint-select" aria-label="Веха">
        <MudSelectItem T="Guid" Value="Guid.Empty">Нет</MudSelectItem>
        @foreach (var milestone in _milestones.Where(m => m.State == MilestoneState.Open || m.Id == Value))
        {
            <MudSelectItem T="Guid" Value="milestone.Id" Disabled="@(milestone.State == MilestoneState.Closed)">@Label(milestone)</MudSelectItem>
        }
    </MudSelect>
}
else if (Current is { } current)
{
    <a class="parent-link" href="@($"milestones/{current.Id}")"><span class="val">@Label(current)</span></a>
}
else
{
    <span class="meta-v muted">—</span>
}

@code {
    [Parameter, EditorRequired] public Guid BoardId { get; set; }
    [Parameter] public Guid? Value { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<Guid?> OnChange { get; set; }

    private IReadOnlyList<MilestoneResponse> _milestones = [];
    private Guid _loadedFor;

    private MilestoneResponse? Current => _milestones.FirstOrDefault(m => m.Id == Value);

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == BoardId)
            return;

        _loadedFor = BoardId;
        var result = await Api.GetMilestones(BoardId);
        _milestones = result.Ok ? result.Value! : [];
    }

    private static string Label(MilestoneResponse milestone) =>
        milestone.State == MilestoneState.Closed ? $"{milestone.Name} · закрыта"
        : milestone.TargetDate is { } date ? $"{milestone.Name} · {Ru.DateOnlyShort(date)}"
        : milestone.Name;

    private Task Change(Guid id) => OnChange.InvokeAsync(id == Guid.Empty ? null : id);
}
