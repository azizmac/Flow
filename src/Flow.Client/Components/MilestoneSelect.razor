@* Поле «Веха» задачи (docs/TZ_task_views.md §6) — пилюля PillSelect: «Нет» (null) и открытые вехи проекта. Закрытая
   веха в список не попадает — новые задачи в неё не добавляют; если задача уже в ней, она видна выключенным пунктом
   с причиной. Без права править — ссылка на страницу вехи. *@
@inject IFlowApi Api

@if (CanEdit)
{
    <PillSelect T="Guid?" Items="Options" Value="Value" OnChange="OnChange" Disabled="Disabled" Empty="@(id => id is null)"
                Label="LabelFor" DisabledReason="@(id => Find(id)?.State == MilestoneState.Closed ? "веха закрыта — новые задачи в неё не добавляют" : null)"
                AriaLabel="Сменить веху" />
}
else if (Find(Value) is { } current)
{
    <a class="parent-link" href="@($"milestones/{current.Id}")"><span class="val">@LabelFor(current.Id)</span></a>
}
else
{
    <span class="meta-v muted">—</span>
}

@code {
    [Parameter, EditorRequired] public Guid BoardId { get; set; }
    [Parameter] public Guid? Value { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<Guid?> OnChange { get; set; }

    private IReadOnlyList<MilestoneResponse> _milestones = [];
    private Guid _loadedFor;

    private IEnumerable<Guid?> Options =>
        new Guid?[] { null }.Concat(_milestones.Where(m => m.State == MilestoneState.Open || m.Id == Value).Select(m => (Guid?)m.Id));

    private MilestoneResponse? Find(Guid? id) => _milestones.FirstOrDefault(m => m.Id == id);

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == BoardId)
            return;

        _loadedFor = BoardId;
        var result = await Api.GetMilestones(BoardId);
        _milestones = result.Ok ? result.Value! : [];
    }

    private string LabelFor(Guid? id) => Find(id) switch
    {
        null => "Нет",
        { State: MilestoneState.Closed } m => $"{m.Name} · закрыта",
        { TargetDate: { } date } m => $"{m.Name} · {Ru.DateOnlyShort(date)}",
        var m => m.Name
    };
}
