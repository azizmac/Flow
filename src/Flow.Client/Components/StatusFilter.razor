@* Фильтр по статусу: в покое видна одна кнопка — выбранный вариант («Все N» или статус с точкой и счётчиком),
   по клику остальные выезжают вправо (SegCollapse). Один активный. *@

<SegCollapse TItem="Guid?" Items="Options" Selected="Value" OnSelect="Select" Role="radiogroup" AriaLabel="Статус">
    <ItemTemplate>
        @if (context is { } id && Statuses.FirstOrDefault(s => s.Id == id) is { } s)
        {
            <span class="sd" style="background:@StatusColors.For(s)"></span>@s.Name <span class="n">@Counts.GetValueOrDefault(s.Id)</span>
        }
        else
        {
            @:Все <span class="n">@Total</span>
        }
    </ItemTemplate>
</SegCollapse>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<StatusResponse> Statuses { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<Guid, int> Counts { get; set; } = new Dictionary<Guid, int>();
    [Parameter] public int Total { get; set; }
    [Parameter] public Guid? Value { get; set; }
    [Parameter] public EventCallback<Guid?> ValueChanged { get; set; }

    private IReadOnlyList<Guid?> Options => [null, .. Statuses.Select(s => (Guid?)s.Id)];

    private Task Select(Guid? id) => ValueChanged.InvokeAsync(id);
}
