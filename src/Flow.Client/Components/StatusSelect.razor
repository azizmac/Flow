@* Селект статуса «в строке» — PillSelect с точкой цвета статуса. Выбор → OnChange(statusId).
   В проекте с workflow (Restricted) при каждом открытии спрашивает у сервера разрешённые переходы и выключает
   запрещённые статусы с причиной второй строкой (docs/TZ_workflow_config.md §2). Сервер всё равно проверит сам. *@
@inject IFlowApi Api

<PillSelect T="StatusResponse" Items="Statuses" Value="Current" Disabled="Disabled"
            Current="@(s => s.Id == Value)" OnChange="@(s => OnChange.InvokeAsync(s.Id))" OnOpening="LoadTransitionsAsync"
            DisabledReason="@(s => Denied(s.Id))" Label="@(s => s?.Name ?? "—")" AriaLabel="Сменить статус">
    <Glyph Context="s"><span class="sd" style="background:@StatusColors.For(s)"></span></Glyph>
</PillSelect>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<StatusResponse> Statuses { get; set; } = [];
    [Parameter] public Guid Value { get; set; }
    [Parameter] public EventCallback<Guid> OnChange { get; set; }
    /// <summary>Пока летит PATCH — селект не принимает новые клики.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Задача, чей статус меняют, и режим workflow её проекта: в Restricted запрещённые переходы выключены.</summary>
    [Parameter] public Guid? TaskId { get; set; }
    [Parameter] public bool Restricted { get; set; }

    private Dictionary<Guid, TaskTransitionResponse>? _transitions;
    private Guid? _transitionsFor;

    private StatusResponse? Current => Statuses.FirstOrDefault(s => s.Id == Value);

    private string? Denied(Guid statusId) =>
        _transitions?.GetValueOrDefault(statusId) is { Allowed: false } t ? string.Join("; ", t.Reasons) : null;

    /// <summary>Переходы — при каждом открытии: условия (исполнитель, чек-лист) могли измениться с прошлого раза.</summary>
    private async Task LoadTransitionsAsync()
    {
        if (!Restricted || TaskId is not { } taskId)
        {
            _transitions = null;
            return;
        }

        if (_transitionsFor != taskId)
            _transitions = null;
        _transitionsFor = taskId;

        var result = await Api.GetTransitions(taskId);
        if (result.Ok && _transitionsFor == taskId)
            _transitions = result.Value!.ToDictionary(t => t.StatusId);
    }
}
