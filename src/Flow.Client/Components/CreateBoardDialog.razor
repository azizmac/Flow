@* Модалка «Новый проект»: название + ключ (авто-uppercase, валидация ^[A-Z][A-Z0-9]{1,9}$),
   живая подсказка «KEY-1, KEY-2…», 409 → «Ключ уже занят». Enter — создать, Esc — закрыть.
   Ключ подставляется из названия, пока пользователь не правил его сам. Шаблон (этап 3F) — встроенный или сохранённый:
   под выбором видно, какие статусы, типы и поля получит проект; сохранённый можно тут же удалить.

   Слой — MudDialog (затемнение, захват фокуса, Esc, клик по фону), вид — класс .flow-modal
   в mud-overrides.css. Enter обрабатывают сами поля (OnFieldKey).

   MudDialog показывает себя через MudDialogProvider и сам не закрывается, когда компонент убирают
   из разметки (@if на странице): закрывать ссылку на диалог нужно явно — CloseDialog. *@
@implements IAsyncDisposable
@inject IFlowApi Api
@inject BrowserInterop Browser

<MudDialog @ref="_dialog" Visible="@_visible" VisibleChanged="OnVisibleChanged" Options="_options" Class="flow-modal"
           TitleClass="flow-modal-title" ContentClass="flow-modal-content" ActionsClass="modal-actions">
    <TitleContent>
        <h3>Новый проект</h3>
        <div class="hint">Настройки берутся из шаблона — потом их можно поменять в проекте</div>
    </TitleContent>
    <DialogContent>
        <DsInput Id="cb-name" Label="Название" Placeholder="Мобильное приложение" MaxLength="200"
                 Value="@_name" ValueChanged="OnNameChanged" Error="@_nameError" OnKeyDown="OnFieldKey" />

        <div>
            <DsInput Id="cb-key" Label="Ключ" Placeholder="MOB" MaxLength="10"
                     Value="@_key" ValueChanged="OnKeyChanged" Error="@_keyError" OnKeyDown="OnFieldKey" />
            <div class="hint" style="margin-top:8px;">
                @Ru.BoardKeyRule. Задачи будут нумероваться <code>@KeyPreview-1</code>, <code>@KeyPreview-2</code>…
            </div>
        </div>

        <div>
            <DsSelect T="Guid" Label="Шаблон" Value="_templateId" ValueChanged="v => _templateId = v" Class="cb-template"
                      Disabled="_templates.Count == 0">
                @foreach (var t in _templates)
                {
                    <MudSelectItem T="Guid" Value="t.Id">@t.Name@(t.IsBuiltIn ? "" : " · сохранённый")</MudSelectItem>
                }
            </DsSelect>
            @if (Template is { } tpl)
            {
                <div class="hint cb-template-hint">
                    @if (tpl.Description is { Length: > 0 })
                    {
                        <div>@tpl.Description</div>
                    }
                    <div>Статусы: @string.Join(" · ", tpl.Statuses)@(tpl.WorkflowMode == WorkflowMode.Restricted ? " (переходы по workflow)" : "")</div>
                    <div>Типы: @string.Join(", ", tpl.TaskTypes)@(tpl.CustomFields.Count > 0 ? $" · поля: {string.Join(", ", tpl.CustomFields)}" : "")</div>
                    @if (tpl.SampleTaskCount > 0)
                    {
                        <div>Задачи-образцы: @tpl.SampleTaskCount</div>
                    }
                    @if (!tpl.IsBuiltIn)
                    {
                        <button type="button" class="icon-lnk danger" @onclick="DeleteTemplate" disabled="@_busy">Удалить шаблон</button>
                    }
                </div>
            }
        </div>

        @if (_serverError is not null)
        {
            <div class="ds-field-error">@_serverError</div>
        }
    </DialogContent>
    <DialogActions>
        <DsButton Variant="secondary" Size="md" OnClick="Cancel" Disabled="_busy">Отмена</DsButton>
        <DsButton Variant="primary" Size="md" OnClick="Submit" Disabled="!IsValid" Busy="_busy">Создать</DsButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public EventCallback<BoardResponse> OnCreated { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private const int FocusDelayMs = 50;

    private MudDialog? _dialog;
    /// <summary>Открыт, пока страница держит компонент; false — закрываемся (см. CloseDialog).</summary>
    private bool _visible = true;
    private bool _closing;
    private bool _busy;
    private string _name = "";
    private string _key = "";
    private string? _nameError;
    private string? _keyError;
    private string? _serverError;
    private bool _keyTouched;
    private List<BoardTemplateResponse> _templates = [];
    /// <summary>Выбранный шаблон; по умолчанию — «Простой» (первый встроенный), он же — прежнее поведение.</summary>
    private Guid _templateId;

    private BoardTemplateResponse? Template => _templates.FirstOrDefault(t => t.Id == _templateId);

    private string KeyPreview => _key.Length == 0 ? "KEY" : _key;

    private bool IsValid => _name.Trim().Length > 0 && Ru.BoardKeyPattern().IsMatch(_key) && !_busy;

    // Заголовок и кнопки свои, поэтому шапку и крестик Mud не показываем.
    private readonly DialogOptions _options = new()
    {
        MaxWidth = MaxWidth.ExtraSmall,
        CloseButton = false,
        CloseOnEscapeKey = true,
        BackdropClick = true
    };

    /// <summary>Esc или клик по фону — тот же путь, что и кнопка «Отмена».</summary>
    private Task OnVisibleChanged(bool visible) => visible || _closing ? Task.CompletedTask : Cancel();

    /// <summary>
    /// Убирает диалог с экрана. Сам MudDialog этого не делает: страница снимает компонент условием,
    /// а ссылка, выданная MudDialogProvider, живёт дальше — модалка осталась бы висеть поверх страницы.
    /// </summary>
    private async Task CloseDialog()
    {
        if (_closing)
            return;

        // Visible гасим раньше самого закрытия: иначе ре-рендер компонента, случившийся до того,
        // как страница его снимет, снова передал бы Visible=true и диалог открылся бы заново.
        _closing = true;
        _visible = false;

        if (_dialog is not null)
            await _dialog.CloseAsync();
    }

    /// <summary>Страховка на случай, когда компонент убрали не через «Отмена» (уход со страницы).</summary>
    public ValueTask DisposeAsync() => new(CloseDialog());

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetBoardTemplates();
        if (result.Ok)
        {
            _templates = result.Value!.ToList();
            _templateId = _templates.FirstOrDefault()?.Id ?? Guid.Empty;
        }
    }

    private async Task DeleteTemplate()
    {
        if (Template is not { IsBuiltIn: false } tpl)
            return;
        var result = await Api.DeleteBoardTemplate(tpl.Id);
        if (!result.Ok)
        {
            _serverError = result.Error;
            return;
        }

        _templates.Remove(tpl);
        _templateId = _templates.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Диалог рендерится в портал MudDialogProvider, поэтому его содержимое появляется в DOM
        // на кадр позже нашего рендера — фокус ставим после паузы, иначе элемента ещё нет.
        await Task.Delay(FocusDelayMs);
        await Browser.FocusAsync("cb-name");
    }

    private void OnNameChanged(string value)
    {
        _name = value;
        _nameError = null;
        _serverError = null;

        // Ключ ведём за названием, пока его не тронули руками.
        if (!_keyTouched)
        {
            _key = SuggestKey(value);
            _keyError = null;
        }
    }

    /// <summary>
    /// Название → ключ: «Мобильное приложение» → MP (первые буквы слов), «Флоу» → FLO (первые буквы).
    /// Кириллица транслитерируется, иначе поле осталось бы пустым для русских названий.
    /// </summary>
    private static string SuggestKey(string name)
    {
        var words = name.Split([' ', '-', '_', '.', ',', '/'], StringSplitOptions.RemoveEmptyEntries)
            .Select(w => Translit(w))
            .Where(w => w.Length > 0 && char.IsLetter(w[0]))
            .ToArray();

        if (words.Length == 0)
            return "";

        var key = words.Length > 1
            ? new string(words.Take(5).Select(w => w[0]).ToArray())
            : words[0][..Math.Min(3, words[0].Length)];

        return key.Length >= 2 ? key.ToUpperInvariant() : "";
    }

    private const string Cyrillic = "абвгдеёжзийклмнопрстуфхцчшщъыьэюя";
    private static readonly string[] Latin =
    [
        "A", "B", "V", "G", "D", "E", "E", "ZH", "Z", "I", "I", "K", "L", "M", "N", "O", "P",
        "R", "S", "T", "U", "F", "H", "C", "CH", "SH", "SCH", "", "Y", "", "E", "YU", "YA"
    ];

    private static string Translit(string word)
    {
        var sb = new System.Text.StringBuilder(word.Length);
        foreach (var ch in word.ToLowerInvariant())
        {
            var idx = Cyrillic.IndexOf(ch);
            if (idx >= 0)
                sb.Append(Latin[idx]);
            else if (ch is >= 'a' and <= 'z' or >= '0' and <= '9')
                sb.Append(char.ToUpperInvariant(ch));
        }

        return sb.ToString();
    }

    private void OnKeyChanged(string value)
    {
        _key = value.Trim().ToUpperInvariant();
        _keyTouched = true;
        _serverError = null;
        _keyError = _key.Length > 0 && !Ru.BoardKeyPattern().IsMatch(_key) ? Ru.BoardKeyRule : null;
    }

    private async Task OnFieldKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Submit();
    }

    private async Task Cancel()
    {
        if (_busy)
            return;

        await CloseDialog();
        await OnCancel.InvokeAsync();
    }

    private async Task Submit()
    {
        if (_name.Trim().Length == 0)
        {
            _nameError = "Введите название проекта";
            return;
        }

        if (!Ru.BoardKeyPattern().IsMatch(_key))
        {
            _keyError = Ru.BoardKeyRule;
            return;
        }

        if (!IsValid)
            return;

        _busy = true;
        _serverError = null;
        var result = await Api.CreateBoard(new CreateBoardRequest(_name.Trim(), _key, _templateId == Guid.Empty ? null : _templateId));
        _busy = false;

        if (result.Ok)
        {
            await CloseDialog();
            await OnCreated.InvokeAsync(result.Value!);
            return;
        }

        if (result.Conflict)
            _keyError = "Ключ уже занят";
        else
            _serverError = result.Error;
    }
}
