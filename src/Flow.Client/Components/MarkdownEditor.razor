@* Markdown-редактор: разметка видна прямо при наборе (CodeMirror, см. editor/README.md) — заголовок крупнее,
   жирный жирным, ссылка цветом акцента, а сами символы разметки остаются в тексте приглушёнными.
   Вкладки «Написать / Предпросмотр» больше не нужны; тулбар (заголовок, жирный, курсив, зачёркнутый, код,
   цитата, списки, чек-лист, ссылка) и хоткеи Ctrl B / I / K, Ctrl Enter → OnSubmit, Esc → OnCancel остались.
   Автодополнение @username из UserDirectory: клавиши ↑↓ Enter Tab Esc редактор отдаёт сюда синхронно
   (HandleEditorKey), пока меню открыто. Правки текста делает flowEditor.* и возвращает новое значение в Value. *@
@implements IAsyncDisposable
@inject BrowserInterop Browser
@inject UserDirectory Users

<div class="md-editor @Class">
    <div class="md-head">
        <div class="md-tools" role="toolbar" aria-label="Форматирование">
            <button type="button" class="md-tool" title="Заголовок" @onclick='() => Prefix("### ")'><Icon Name="heading" Size="15" /></button>
            <button type="button" class="md-tool" title="Жирный (Ctrl B)" @onclick='() => Wrap("**", "**", "жирный")'><Icon Name="bold" Size="15" /></button>
            <button type="button" class="md-tool" title="Курсив (Ctrl I)" @onclick='() => Wrap("_", "_", "курсив")'><Icon Name="italic" Size="15" /></button>
            <button type="button" class="md-tool" title="Зачёркнутый" @onclick='() => Wrap("~~", "~~", "текст")'><Icon Name="strikethrough" Size="15" /></button>
            <span class="md-sep"></span>
            <button type="button" class="md-tool" title="Код" @onclick='() => Wrap("`", "`", "код")'><Icon Name="code" Size="15" /></button>
            <button type="button" class="md-tool" title="Цитата" @onclick='() => Prefix("> ")'><Icon Name="quote" Size="15" /></button>
            <button type="button" class="md-tool" title="Ссылка (Ctrl K)" @onclick='() => Wrap("[", "](url)", "текст ссылки")'><Icon Name="link" Size="15" /></button>
            <span class="md-sep"></span>
            <button type="button" class="md-tool" title="Список" @onclick='() => Prefix("- ")'><Icon Name="list" Size="15" /></button>
            <button type="button" class="md-tool" title="Нумерованный список" @onclick='() => Prefix("1. ", ordered: true)'><Icon Name="list-ordered" Size="15" /></button>
            <button type="button" class="md-tool" title="Чек-лист" @onclick='() => Prefix("- [ ] ")'><Icon Name="check-square" Size="15" /></button>
            @if (AttachToTaskId is not null)
            {
                <span class="md-sep"></span>
                @* Label, а не кнопка: диалог выбора файла открывает сам input, без похода в JS. *@
                <label class="md-tool" for="@_attachInputId" title="Прикрепить файл (или перетащите в поле)">
                    <Icon Name="add-file" Size="15" />
                </label>
            }
        </div>
    </div>

    <div class="md-body">
        <div id="@Id" class="md-text" style="@($"min-height:{MinHeight}px;")" data-mention="@(_mentionOpen ? "1" : null)"></div>
        @if (_failed)
        {
            <div class="ds-field-error">Редактор не загрузился — обновите страницу.</div>
        }
        @if (_mentionOpen && _mentionItems.Count > 0)
        {
            <div class="md-mention" role="listbox">
                @for (var i = 0; i < _mentionItems.Count; i++)
                {
                    var idx = i;
                    var u = _mentionItems[i];
                    <button type="button" class="pop-item user @(idx == _mentionIndex ? "cur" : "")" role="option" aria-selected="@((idx == _mentionIndex).ToString().ToLowerInvariant())"
                            @onmousedown:preventDefault @onclick="() => PickMention(idx)">
                        <Avatar User="u" Size="22" />
                        <span class="pop-user">
                            <span class="pop-user-name">@u.FullName</span>
                            <span class="pop-user-un">@@@u.Username</span>
                        </span>
                    </button>
                }
            </div>
        }
    </div>

    @if (AttachToTaskId is { } attachTo)
    {
        @* Зона приёма — поле ввода: брошенный или вставленный файл грузится в задачу, а на место
           курсора встаёт ссылка. Кнопка своя не нужна — её роль играет label в тулбаре. *@
        <AttachmentUpload TaskId="attachTo" InputId="@_attachInputId" ShowButton="false"
                          DropZoneId="@Id" AcceptPaste="true" Disabled="Busy" OnUploaded="InsertAttachment" />
    }

    <div class="md-foot">
        <span class="hint">Markdown · <span class="kbd">@@</span> упомянуть · <span class="kbd">Ctrl Enter</span> @SubmitHint</span>
        @if (ShowActions)
        {
            <div class="md-actions">
                @if (OnCancel.HasDelegate)
                {
                    <button type="button" class="icon-lnk" @onclick="OnCancel" disabled="@Busy">Отмена</button>
                }
                <DsButton Variant="primary" Size="sm" OnClick="Submit" Busy="Busy" Disabled="@(!CanSubmit)">@SubmitLabel</DsButton>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Что нужно сделать, критерии готовности, ссылки…";
    [Parameter] public int MinHeight { get; set; } = 140;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Autofocus { get; set; }
    [Parameter] public string? Class { get; set; }
    /// <summary>Кнопки «Отмена»/Submit под редактором. Без них хоткеи всё равно работают.</summary>
    [Parameter] public bool ShowActions { get; set; } = true;
    [Parameter] public string SubmitLabel { get; set; } = "Сохранить";
    [Parameter] public string SubmitHint { get; set; } = "сохранить";
    /// <summary>Пустой текст не отправляем (комментарий); для описания пустое допустимо — AllowEmpty.</summary>
    [Parameter] public bool AllowEmpty { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    /// <summary>Id контейнера редактора — чтобы страница могла поставить фокус.</summary>
    [Parameter] public string Id { get; set; } = "md-" + Guid.NewGuid().ToString("N")[..8];

    /// <summary>
    /// Задача, к которой приложить брошенный или выбранный файл (docs/TZ_attachments.md). null —
    /// редактор без вложений (например, форма новой задачи: задачи ещё нет, прикладывать не к чему).
    /// </summary>
    [Parameter] public Guid? AttachToTaskId { get; set; }

    private readonly string _attachInputId = "mda-" + Guid.NewGuid().ToString("N")[..8];

    private bool _mentionOpen;
    private int _mentionAt;
    private int _mentionIndex;
    private IReadOnlyList<UserResponse> _mentionItems = [];
    private DotNetObjectReference<MarkdownEditor>? _self;
    private bool _mounted;
    private bool _failed;
    private bool _busyApplied;
    /// <summary>Последнее значение, пришедшее из редактора: чтобы не гонять его же обратно при ре-рендере.</summary>
    private string _lastFromEditor = "";

    private bool CanSubmit => !Busy && (AllowEmpty || !string.IsNullOrWhiteSpace(Value));

    protected override void OnInitialized() => Users.Changed += OnUsersChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            if (!await Browser.EnsureEditorLoadedAsync())
            {
                _failed = true;
                StateHasChanged();
                return;
            }

            _mounted = await Browser.EditorMountAsync(Id, _self, Value, Placeholder, Busy, OnCancel.HasDelegate);
            _lastFromEditor = Value;
            _busyApplied = Busy;

            if (_mounted && Autofocus)
                await Browser.EditorFocusAsync(Id);

            return;
        }

        if (!_mounted)
            return;

        // Значение поменяли снаружи (очистили после отправки, отменили правку) — переносим в редактор.
        if (Value != _lastFromEditor)
        {
            _lastFromEditor = Value;
            await Browser.EditorSetValueAsync(Id, Value);
        }

        if (_busyApplied != Busy)
        {
            _busyApplied = Busy;
            await Browser.EditorSetReadOnlyAsync(Id, Busy);
        }
    }

    private void OnUsersChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Текст изменили в редакторе: поднимаем значение наверх и пересчитываем меню упоминаний.</summary>
    [JSInvokable]
    public async Task HandleEditorInput(string value)
    {
        _lastFromEditor = value;
        if (value != Value)
        {
            Value = value;
            await ValueChanged.InvokeAsync(value);
        }

        await DetectMention();
        await SyncMentionAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Что редактору сделать с перехваченной клавишей. Правку текста выполняет JS (kind = wrap/prefix/mention),
    /// действие компонента — отдельным асинхронным вызовом (kind = action), «handled» — состояние уже поменяли
    /// здесь и делать больше нечего.
    /// </summary>
    public sealed record EditorCommand(
        string Kind,
        string? Before = null,
        string? After = null,
        string? Placeholder = null,
        string? Prefix = null,
        bool Ordered = false,
        int At = 0,
        string? Username = null,
        string? Action = null);

    private static readonly EditorCommand Handled = new("handled");

    /// <summary>
    /// Клавиша из редактора, уже перехваченная на стороне JS. Решение «забрать клавишу себе» принимает
    /// flow-editor (takesKey) синхронно, потому что CodeMirror ждёт true/false, — а сюда вызов приходит
    /// асинхронно, и здесь можно спокойно и в JS сходить, и состояние поменять.
    ///
    /// Раньше это был синхронный invokeMethod. При серверном рендере компонент живёт на другом конце
    /// SignalR, синхронный вызов туда невозможен в принципе, и меню упоминаний вместе с Ctrl+B молча
    /// переставали работать: исключение гасил catch на стороне JS.
    /// </summary>
    [JSInvokable]
    public async Task HandleEditorKeyAsync(string key)
    {
        var command = DecideEditorKey(key);
        if (command is not null && command.Kind != "handled")
            await Browser.EditorRunCommandAsync(Id, command);

        // Меню могло открыться или закрыться — JS обязан знать об этом до следующего нажатия.
        await SyncMentionAsync();
        StateHasChanged();
    }

    private EditorCommand? DecideEditorKey(string key)
    {
        if (_mentionOpen && _mentionItems.Count > 0)
        {
            switch (key)
            {
                case "ArrowDown":
                    _mentionIndex = (_mentionIndex + 1) % _mentionItems.Count;
                    StateHasChanged();
                    return Handled;
                case "ArrowUp":
                    _mentionIndex = (_mentionIndex - 1 + _mentionItems.Count) % _mentionItems.Count;
                    StateHasChanged();
                    return Handled;
                case "Enter":
                case "Tab":
                {
                    var user = _mentionItems[_mentionIndex];
                    var at = _mentionAt;
                    CloseMention();
                    StateHasChanged();
                    return new EditorCommand("mention", At: at, Username: user.Username);
                }
                case "Escape":
                    CloseMention();
                    StateHasChanged();
                    return Handled;
            }
        }

        switch (key)
        {
            case "Mod-Enter":
                return new EditorCommand("action", Action: "submit");
            case "Mod-b":
                return new EditorCommand("wrap", Before: "**", After: "**", Placeholder: "жирный");
            case "Mod-i":
                return new EditorCommand("wrap", Before: "_", After: "_", Placeholder: "курсив");
            case "Mod-k":
                return new EditorCommand("wrap", Before: "[", After: "](url)", Placeholder: "текст ссылки");
            case "Escape" when OnCancel.HasDelegate:
                return new EditorCommand("action", Action: "cancel");
            default:
                return null;
        }
    }

    /// <summary>
    /// Действие компонента по клавише. Зовётся из JS асинхронно и уже вне синхронного HandleEditorKey —
    /// поэтому отсюда можно и в API сходить, и в редактор.
    /// </summary>
    [JSInvokable]
    public async Task RunEditorAction(string action)
    {
        switch (action)
        {
            case "submit":
                await Submit();
                break;
            case "cancel":
                await OnCancel.InvokeAsync();
                break;
        }
    }

    private async Task SetValue(string? value)
    {
        if (value is null) return;
        _lastFromEditor = value;
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }

    // Токен «@…» перед кареткой: начинается с @, перед ним — начало текста или пробел/скобка, без пробелов внутри.
    private async Task DetectMention()
    {
        var state = await Browser.EditorStateAsync(Id);
        if (state is null || state.Start != state.End) { CloseMention(); return; }

        var text = state.Value;
        var caret = Math.Min(state.Start, text.Length);
        var at = text.LastIndexOf('@', Math.Max(0, caret - 1));
        if (at < 0 || (at > 0 && (char.IsLetterOrDigit(text[at - 1]) || text[at - 1] is '/' or '_' or '.')))
        {
            CloseMention();
            return;
        }

        var query = text[(at + 1)..caret];
        if (query.Any(char.IsWhiteSpace) || query.Length > 32)
        {
            CloseMention();
            return;
        }

        // Ждём справочник, а не запускаем загрузку в фон: иначе первый же «@» до её конца получает пустой Filter,
        // меню закрывается и само не откроется — DetectMention вызывается только на новый ввод.
        if (!Users.IsLoaded)
            await Users.EnsureLoadedAsync();

        // Пустой запрос — это «@» без букв: показываем первых активных, как в Slack и GitHub, а не прячем список.
        var items = Users.Filter(query, 6);
        if (items.Count == 0) { CloseMention(); return; }

        _mentionAt = at;
        _mentionItems = items;
        _mentionIndex = Math.Min(_mentionIndex, items.Count - 1);
        _mentionOpen = true;
    }

    private void CloseMention()
    {
        _mentionOpen = false;
        _mentionIndex = 0;
        _mentionItems = [];
    }

    /// <summary>Переносит текущее состояние меню в JS: по нему редактор решает, чьи стрелки и Enter.</summary>
    private Task SyncMentionAsync() => Browser.EditorSetMentionOpenAsync(Id, _mentionOpen && _mentionItems.Count > 0);

    private async Task PickMention(int index)
    {
        if (index < 0 || index >= _mentionItems.Count) return;
        var user = _mentionItems[index];
        var value = await Browser.EditorInsertMentionAsync(Id, _mentionAt, user.Username);
        CloseMention();
        await SyncMentionAsync();
        await SetValue(value);
        StateHasChanged();
    }

    private async Task Wrap(string before, string after, string placeholder) =>
        await SetValue(await Browser.EditorWrapAsync(Id, before, after, placeholder));

    private async Task Prefix(string prefix, bool ordered = false) =>
        await SetValue(await Browser.EditorPrefixLinesAsync(Id, prefix, ordered));

    /// <summary>
    /// Файл приложен — ставим на его место ссылку «attachment:{id}»: картинка покажется прямо в тексте,
    /// остальное станет ссылкой на скачивание. Ссылка живёт на своей строке, как в GitLab: внутри
    /// предложения картинка разрывала бы абзац.
    /// </summary>
    private async Task InsertAttachment(AttachmentResponse attachment)
    {
        // Квадратные скобки в имени файла разорвали бы ссылку — экранируем их, остальное Markdown стерпит.
        var name = attachment.FileName.Replace("[", "\\[").Replace("]", "\\]");
        var link = $"{(attachment.IsImage ? "!" : string.Empty)}[{name}](attachment:{attachment.Id})";

        var state = await Browser.EditorStateAsync(Id);
        var caret = state is null ? 0 : Math.Min(state.Start, state.Value.Length);
        var onOwnLine = state is null || caret == 0 || state.Value[caret - 1] == '\n';

        var text = (onOwnLine ? string.Empty : "\n") + link + "\n";
        await SetValue(await Browser.EditorInsertAsync(Id, text));
        StateHasChanged();
    }

    private async Task Submit()
    {
        if (!CanSubmit) return;
        await OnSubmit.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        Users.Changed -= OnUsersChanged;
        if (_mounted)
            await Browser.EditorDestroyAsync(Id);
        _self?.Dispose();
    }
}
