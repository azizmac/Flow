    private void OpenCreate()
    {
        if (!CanCreateTask || _boards.Count == 0) return;
        if (TaskId is not null)
            Nav.NavigateTo(Nav.GetUriWithQueryParameter("task", (string?)null));

        // В сводном режиме проект берём из прошлого создания — «в тот же проект, что и в прошлый раз».
        // Проект без права создавать задачи (только чтение) не предлагаем — берём первый, где можно.
        var creatable = CreatableBoards;
        _createBoardId ??= new[] { BoardId, State.LastBoardId }.FirstOrDefault(id => id is { } i && creatable.Any(b => b.Id == i))
                           ?? creatable.FirstOrDefault()?.Id;
        _createOpen = true;
    }

