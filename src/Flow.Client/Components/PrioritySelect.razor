@* Селект приоритета «в строке» — как StatusSelect. Шкала фиксированная (docs/TZ_task_model.md §2). *@

<MudMenu @bind-Open="_open" PopoverClass="flow-pop" ListClass="flow-pop-list" AnchorOrigin="Origin.BottomLeft"
         TransformOrigin="Origin.TopLeft" Dense="true" DropShadow="false" Ripple="false" AriaLabel="Сменить приоритет">
    <ActivatorContent>
        <div class="status-sel @(Disabled ? "disabled" : "")" @onclick="Toggle" @onclick:stopPropagation
             @onkeydown="OnKey" @onkeydown:stopPropagation
             role="button" tabindex="@(Disabled ? -1 : 0)" aria-haspopup="listbox" aria-disabled="@(Disabled ? "true" : "false")"
             aria-expanded="@(_open ? "true" : "false")" title="@(Disabled ? "Сохраняем…" : "Сменить приоритет")">
            <PriorityIcon Value="Value" Size="13" ShowNone="true" />
            <span class="lbl">@TaskMeta.PriorityLabel(Value)</span>
            <Icon Name="chevrons" Size="12" />
        </div>
    </ActivatorContent>
    <ChildContent>
        @foreach (var p in TaskMeta.Priorities)
        {
            <MudMenuItem Class="@($"pop-item {(p == Value ? "cur" : "")}")" OnClick="() => Select(p)">
                <PriorityIcon Value="p" Size="13" ShowNone="true" />@TaskMeta.PriorityLabel(p)
            </MudMenuItem>
        }
    </ChildContent>
</MudMenu>

@code {
    [Parameter] public TaskPriority Value { get; set; }
    [Parameter] public EventCallback<TaskPriority> OnChange { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private bool _open;

    private void OnKey(KeyboardEventArgs e)
    {
        if (!Disabled && e.Key is "Enter" or " " or "ArrowDown")
            _open = true;
    }

    private void Toggle()
    {
        if (!Disabled)
            _open = !_open;
    }

    private async Task Select(TaskPriority p)
    {
        _open = false;
        if (p != Value)
            await OnChange.InvokeAsync(p);
    }
}
