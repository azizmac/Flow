@* Слайдер задачи. Mode=Create — форма новой задачи (POST с типом, приоритетом, исполнителем и полями; состав формы —
   экран создания проекта); Mode=View — просмотр/редактирование существующей, поля — по экрану карточки
   (PATCH Title/Description/StatusId/TypeId/Priority, PATCH /assignee, /schedule, /estimate, DELETE). Содержимое рендерится внутри общего Drawer. *@
@implements IDisposable
@inject IFlowApi Api
@inject ToastService Toasts
@inject BrowserInterop Browser
@inject HotkeyService Hotkeys
@inject NavigationManager Nav
@inject UserDirectory Users
@inject ProjectAccessState Access

@if (IsCreate)
{
    <div class="drawer-head">
        <div style="display:flex;align-items:center;gap:10px;">
            <span class="code accent">@Board.Key-@Board.NextTaskNumber</span>
            <span style="font:var(--fw-semibold) 12.5px var(--font-display);color:var(--text-tertiary);">Новая задача</span>
        </div>
        <DsIconButton Icon="close" Size="30" Title="Закрыть (Esc)" OnClick="Close" />
    </div>
    <div class="drawer-body" @onkeydown="OnBodyKey">
        <input id="td-title" class="title-input" placeholder="Название задачи" value="@_title" maxlength="500"
               @oninput="e => _title = e.Value?.ToString() ?? string.Empty" />
        @* Дубль дешевле не создать, чем потом склеивать: похожие показываются прямо по ходу набора. *@
        <SimilarTasks Title="@_title" Limit="3" />
        @* Форма — по экрану создания проекта (docs/TZ_workflow_config.md §3); статус и проект есть всегда. *@
        <div class="meta-grid">
            <div class="meta-k">Статус</div>
            <div><StatusSelect Statuses="Board.Statuses" Value="_statusId" OnChange="id => _statusId = id" /></div>
            @foreach (var field in CreateLayout.Where(f => ScreenLayout.SystemName(f) != "description"))
            {
                @if (field.Section is { } sectionTitle)
                {
                    <div class="meta-section">@sectionTitle</div>
                }
                @if (ScreenLayout.CustomId(field) is { } customId)
                {
                    <CustomFieldsEditor Board="Board" TypeId="_typeId" Values="_newCustomFields" CanEdit="true" Disabled="_busy"
                                        FieldIds="[customId]" Required="field.Required" OnChange="c => SetNewCustomField(c.FieldId, c.Value)" />
                }
                else if (ScreenLayout.SystemName(field) is { } name)
                {
                    <div class="meta-k">@ScreenLayout.Label(name)@(field.Required ? " *" : "")</div>
                    @switch (name)
                    {
                        case "type":
                            <div><TaskTypeSelect Types="Board.TaskTypes" Value="_typeId" OnChange="id => _typeId = id" /></div>
                            break;
                        case "priority":
                            <div><PrioritySelect Value="_priority" OnChange="p => _priority = p" /></div>
                            break;
                        case "assignee":
                            <div><AssigneeSelect Value="_assigneeId" OnlyUserId="OnlyAssigneeId" OnChange="id => _assigneeId = id" /></div>
                            break;
                    }
                }
            }
            <div class="meta-k">Проект</div>
            <div>
                @if (Boards.Count > 1)
                {
                    <BoardSelect Boards="Boards" Value="Board.Id" ValueChanged="OnBoardChanged" Compact="true" AllowAll="false" />
                }
                else
                {
                    <div class="meta-v"><KeyChip Value="@Board.Key" /><span class="val" title="@Board.Name">@Board.Name</span></div>
                }
            </div>
        </div>
        @if (CreateLayout.FirstOrDefault(f => ScreenLayout.SystemName(f) == "description") is { } descField)
        {
            <div class="desc-wrap">
                <div class="desc-head"><div class="meta-k">Описание@(descField.Required ? " *" : "")</div></div>
                <MarkdownEditor @bind-Value="_description" MinHeight="120" ShowActions="false" AllowEmpty="true" SubmitHint="создать" OnSubmit="Create" />
            </div>
        }
        @if (_error is not null)
        {
            <div class="ds-field-error">@_error</div>
        }
    </div>
    <div class="drawer-foot">
        <div class="kbd-hint"><span class="kbd">Ctrl Enter</span> создать <span class="kbd">Esc</span> закрыть</div>
        <div style="display:flex;gap:10px;">
            <DsButton Variant="secondary" Size="sm" OnClick="Close" Disabled="_busy">Отмена</DsButton>
            <DsButton Variant="primary" Size="sm" OnClick="Create" Disabled="@(_title.Trim().Length == 0)" Busy="_busy">Создать задачу</DsButton>
        </div>
    </div>
}
else if (Item is not null)
{
    <div class="drawer-head">
        <div style="display:flex;align-items:center;gap:10px;">
            <span class="code accent">@Item.Code</span>
            <button type="button" class="icon-lnk" @onclick="CopyCode"><Icon Name="copy" Size="13" />Скопировать</button>
        </div>
        <div style="display:flex;align-items:center;gap:4px;">
            @if (_busy)
            {
                <span class="save-state" aria-live="polite"><span class="ds-spin"></span>Сохраняем…</span>
            }
            else if (_savedAt is not null)
            {
                <span class="save-state ok" aria-live="polite"><Icon Name="check" Size="13" />Сохранено</span>
            }
            @* Развернуть — это и есть «открыть на всю страницу»: слайдер во всю ширину показывал ту же
               узкую колонку, а рядом жила ссылка с тем же значком и тем же смыслом. Кнопка одна и ведёт
               на /tasks/{id} — там раскладка страницы задачи (описание слева, мета-карточка справа). *@
            <DsIconButton Icon="expand" Size="30" Title="На всю страницу" OnClick="OpenFullPage" />
            <RowMenu ShowOpen="false" ShowRename="CanEdit" ShowDelete="CanEdit" Size="30" Style="color:rgba(255,255,255,0.5)"
                     OnRename="StartTitleEdit" OnCopy="CopyCode" OnDelete="() => OnDelete.InvokeAsync(Item)" ShowRestructure="CanEdit"
                     OnSplit="() => _restructure = TaskRestructureMode.Split" OnMerge="() => _restructure = TaskRestructureMode.Merge"
                     OnMove="() => _restructure = TaskRestructureMode.Move" />
            <DsIconButton Icon="close" Size="30" Title="Закрыть (Esc)" OnClick="Close" />
        </div>
    </div>
    <div class="drawer-body" id="td-drop" @onkeydown="OnBodyKey">
        @if (_editingTitle)
        {
            <input id="td-title-edit" class="title-input" value="@_title" maxlength="500"
                   @oninput="e => _title = e.Value?.ToString() ?? string.Empty"
                   @onkeydown="OnTitleKey" @onblur="CommitTitle" />
        }
        else
        {
            <div class="drawer-title" title="@(CanEdit ? "Нажмите, чтобы переименовать" : null)"
                 role="@(CanEdit ? "button" : null)" tabindex="@(CanEdit ? 0 : -1)"
                 @onclick="StartTitleEdit" @onkeydown="OnTitleActivate">@Item.Title</div>
        }
        @* Поля — по экрану карточки (docs/TZ_workflow_config.md §3): статус всегда первым, проект и дата создания — в конце. *@
        <div class="meta-grid">
            <div class="meta-k">Статус</div>
            <div>
                @if (CanEdit)
                {
                    <StatusSelect Statuses="Board.Statuses" Value="Item.StatusId" OnChange="ChangeStatus" Disabled="_busy"
                                  TaskId="Item.Id" Restricted="Board.WorkflowMode == WorkflowMode.Restricted" />
                }
                else
                {
                    var st = Board.Statuses.FirstOrDefault(x => x.Id == Item.StatusId);
                    <span class="status-pill"><span class="sd" style="background:@StatusColors.For(st?.Type)"></span>@(st?.Name ?? "—")</span>
                }
            </div>
            @foreach (var field in DetailLayout.Where(f => ScreenLayout.SystemName(f) is not ("description" or "checklist" or "links" or "attachments")))
            {
                @if (field.Section is { } sectionTitle)
                {
                    <div class="meta-section">@sectionTitle</div>
                }
                @if (ScreenLayout.CustomId(field) is { } customId)
                {
                    <CustomFieldsEditor Board="Board" TypeId="Current.TypeId" Values="Current.CustomFields" CanEdit="CanEdit" Disabled="_busy"
                                        FieldIds="[customId]" Required="field.Required" OnChange="c => SetCustomField(c.FieldId, c.Value)" />
                }
                else if (ScreenLayout.SystemName(field) is { } name)
                {
                    <div class="meta-k @(field.Required && ScreenLayout.IsEmpty(name, Current) ? "req" : "")">@ScreenLayout.Label(name)@(field.Required ? " *" : "")</div>
                    @SystemValue(name)
                }
            }
            <div class="meta-k">Проект</div>
            <div class="meta-v"><KeyChip Value="@Board.Key" /><span class="val" title="@Board.Name">@Board.Name</span></div>
            <div class="meta-k">Создана</div>
            <div class="meta-v">@Ru.DateTimeFull(Item.CreatedAt)</div>
        </div>
        @* compact: в просмотре описание занимает высоту по содержимому, иначе оно растянется и отожмёт ленту вниз. *@
        @if (Shows("description"))
        {
        <div class="desc-wrap compact">
            <div class="desc-head">
                <div class="meta-k">Описание</div>
                @if (_editingDesc)
                {
                    <div class="desc-actions">
                        <button type="button" class="icon-lnk" @onclick="CancelDesc">Отмена</button>
                        <DsButton Variant="primary" Size="sm" OnClick="SaveDesc" Busy="_busy">Сохранить</DsButton>
                    </div>
                }
                else if (CanEdit)
                {
                    <button type="button" class="icon-lnk" @onclick="StartDescEdit"><Icon Name="edit" Size="13" />Редактировать</button>
                }
            </div>
            @if (_editingDesc)
            {
                <MarkdownEditor Id="td-desc" @bind-Value="_description" MinHeight="140" Autofocus="true" Busy="_busy" AllowEmpty="true"
                                AttachToTaskId="Item.Id" ShowActions="false" OnSubmit="SaveDesc" OnCancel="CancelDesc" />
            }
            else
            {
                <MarkdownView Text="@Item.Description" OnClick="OnDescClick" />
            }
        </div>
        }
        <SubtaskList Board="Board" Parent="Item" CanCreate="Permissions.CanCreateTask(Access.For(Board.Id))"
                     OnCountsChanged="OnChildCountsChanged" OnCreated="HandleSubtaskCreated" />
        @if (Shows("checklist"))
        {
            <TaskChecklist TaskId="Item.Id" CanEdit="CanEdit" OnCountsChanged="OnChecklistChanged" />
        }
        @if (Shows("links"))
        {
            <TaskLinks TaskId="Item.Id" CanEdit="CanEdit" OnBlockedChanged="n => OnUpdated.InvokeAsync(Current with { BlockedByCount = n })"
                       OnJournal="e => _timeline?.NoteActivity(e.Type, e.Old, e.New)" />
        }
        @if (Shows("attachments"))
        {
            <AttachmentList TaskId="Item.Id" BoardId="Item.BoardId" DropZoneId="td-drop" />
        }
        <TaskTimeline @ref="_timeline" TaskItem="Item" Board="Board" OnCommentCountChanged="OnCommentCountChanged" />
        @if (_error is not null)
        {
            <div class="ds-field-error">@_error</div>
        }
    </div>
    <div class="drawer-foot">
        <div class="kbd-hint"><span class="kbd">↑</span><span class="kbd">↓</span> между задачами <span class="kbd">Esc</span> закрыть</div>
        @if (CanEdit)
        {
            <button type="button" class="icon-lnk danger" @onclick="() => OnDelete.InvokeAsync(Item)"><Icon Name="trash" Size="14" />Удалить</button>
        }
    </div>
}


@if (_restructure != TaskRestructureMode.None && Item is not null)
{
    <TaskRestructure Task="Item" @bind-Mode="_restructure" OnDone="AfterRestructure" />
}

@code {
    /// <summary>Раскладка карточки для типа задачи (экран типа → «для всех типов» → встроенный).</summary>
    private IReadOnlyList<ScreenFieldDto> DetailLayout => ScreenLayout.Resolve(Board, Current.TypeId, ScreenContext.Detail, Current.CustomFields);

    /// <summary>Форма создания: тип в форме ещё не выбран — тип проекта по умолчанию.</summary>
    private IReadOnlyList<ScreenFieldDto> CreateLayout =>
        ScreenLayout.Resolve(Board, _typeId == Guid.Empty ? DefaultTypeId() : _typeId, ScreenContext.Create);

    private bool Shows(string name) => DetailLayout.Any(f => ScreenLayout.SystemName(f) == name);

    /// <summary>Значение системного поля строки мета-сетки — те же компоненты, что были в фиксированной разметке.</summary>
    private RenderFragment SystemValue(string name) => name switch
    {
        "type" => @<div>
                @if (CanEdit)
                {
                    <TaskTypeSelect Types="Board.TaskTypes" Value="Item!.TypeId" OnChange="ChangeType" Disabled="_busy" />
                }
                else if (TaskMeta.TypeOf(Board, Item!.TypeId) is { } type)
                {
                    <span class="status-pill"><TaskTypeIcon Kind="type.Kind" Name="@type.Name" Size="13" />@type.Name</span>
                }
            </div>,
        "parent" => @<div class="meta-v"><ParentSelect Board="Board" Task="Item" Value="Item!.ParentId" CanEdit="CanEdit" Disabled="_busy" OnChange="SetParent" /></div>,
        "sprint" => @<div class="meta-v"><SprintSelect BoardId="Board.Id" Value="Current.SprintId" CanEdit="CanEdit" Disabled="_busy" OnChange="SetSprint" /></div>,
        "milestone" => @<div class="meta-v"><MilestoneSelect BoardId="Board.Id" Value="Current.MilestoneId" CanEdit="CanEdit" Disabled="_busy" OnChange="SetMilestone" /></div>,
        "priority" => @<div>
                @if (CanEdit)
                {
                    <PrioritySelect Value="Item!.Priority" OnChange="ChangePriority" Disabled="_busy" />
                }
                else
                {
                    <span class="status-pill"><PriorityIcon Value="Item!.Priority" Size="13" ShowNone="true" />@TaskMeta.PriorityLabel(Item.Priority)</span>
                }
            </div>,
        "assignee" => @<div class="meta-v">
                <AssigneeSelect Value="Item!.AssigneeId" Disabled="!CanAssign" OnlyUserId="OnlyAssigneeId" OnChange="Assign" />
                @if (Item.AssigneeId is { } aid && Users.Find(aid) is { } who)
                {
                    @* Обёртка — якорь карточки: MudPopover внутри UserCard позиционируется по ней. *@
                    <span class="ucard-anchor">
                        <button type="button" id="@_whoId" class="icon-lnk" @onclick="() => _whoOpen = true" title="Карточка"><Icon Name="view" Size="13" />@@@who.Username</button>
                        @if (_whoOpen)
                        {
                            <UserCard User="who" OnClose="() => _whoOpen = false" />
                        }
                    </span>
                }
            </div>,
        "start" => @<div><DueDateField Value="Item!.StartDate" CanEdit="CanEdit" Disabled="_busy" Plain="true" Label="Дата начала" OnChange="SetStartDate" /></div>,
        "due" => @<div><DueDateField Value="Item!.DueDate" CanEdit="CanEdit" Disabled="_busy" IsDone="IsDone" OnChange="SetDueDate" /></div>,
        "estimate" => @<div><EstimateField StoryPoints="Item!.StoryPoints" EstimateMinutes="Item.EstimateMinutes" CanEdit="CanEdit" Disabled="_busy" OnChange="SetEstimate" /></div>,
        _ => @<div class="meta-v muted">—</div>
    };

    [Parameter, EditorRequired] public BoardResponse Board { get; set; } = default!;
    /// <summary>Все проекты — чтобы в форме создания можно было выбрать, куда заводится задача.</summary>
    [Parameter] public IReadOnlyList<BoardResponse> Boards { get; set; } = [];
    [Parameter] public EventCallback<Guid?> OnBoardChanged { get; set; }
    /// <summary>null — режим создания.</summary>
    [Parameter] public TaskResponse? Item { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<TaskResponse> OnCreated { get; set; }
    [Parameter] public EventCallback<TaskResponse> OnUpdated { get; set; }
    [Parameter] public EventCallback<TaskResponse> OnDelete { get; set; }
    /// <summary>
    /// Иерархия изменилась (создана подзадача, сменился родитель) — у соседних строк списка за слайдером устарели
    /// счётчики подзадач, а новой подзадачи там ещё нет: списку есть что перечитать.
    /// </summary>
    [Parameter] public EventCallback OnHierarchyChanged { get; set; }
    /// <summary>Права actor'а на Item (Permissions.CanEditTask / CanAssign); OnlyAssigneeId — Member назначает только себя.</summary>
    [Parameter] public bool CanEdit { get; set; } = true;
    [Parameter] public bool CanAssign { get; set; } = true;
    [Parameter] public Guid? OnlyAssigneeId { get; set; }

    private bool IsCreate => Item is null;

    private TaskRestructureMode _restructure;

    /// <summary>
    /// Разделение добавило задачи в список; слияние закрыло эту, перенос увёл её из проекта — список перечитывается,
    /// а после слияния и переноса слайдер закрывается: показывать в нём больше нечего.
    /// </summary>
    private async Task AfterRestructure(TaskResponse next)
    {
        await OnHierarchyChanged.InvokeAsync();
        if (next.Id != Item?.Id || next.BoardId != Item.BoardId)
            await OnClose.InvokeAsync();
    }

    private string _title = "";
    private string _description = "";
    private Guid _statusId;
    private Guid _typeId;
    private TaskPriority _priority;
    /// <summary>Значения пользовательских полей в форме создания — уходят в CreateTaskRequest.</summary>
    private Dictionary<Guid, System.Text.Json.JsonElement> _newCustomFields = [];
    private Guid? _assigneeId;
    private bool _busy;
    private bool _whoOpen;
    private readonly string _whoId = "who-" + Guid.NewGuid().ToString("N")[..8];
    private string? _error;
    private bool _editingTitle;
    private bool _editingDesc;
    private bool _titleCancelled;
    private Guid? _itemId;
    private Guid _boardId;
    private DateTime? _savedAt;
    private CancellationTokenSource? _savedCts;
    private IDisposable? _hotkeys;
    private TaskTimeline? _timeline;

    /// <summary>
    /// Последний ответ сервера по этой задаче. Родитель присылает обновлённый Item не мгновенно, а правки
    /// из соседних полей могут идти подряд: «до» для ленты и текущий срок для /schedule берём отсюда.
    /// </summary>
    private TaskResponse? _latest;

    private TaskResponse Current => _latest is { } l && l.Id == Item!.Id && l.UpdatedAt >= Item.UpdatedAt ? l : Item!;

    protected override void OnInitialized()
    {
        Users.Changed += OnUsersChanged;
        // Ctrl+Enter: в MarkdownEditor (описание) — его OnSubmit; в поле названия/вне полей — здесь.
        _hotkeys = Hotkeys.Subscribe(async e =>
        {
            if (e.Key == "Enter" && e.Ctrl)
            {
                e.Handled = true;
                if (e.InEditable && (IsCreate || _editingDesc)) return; // редактор описания сам вызовет Create/SaveDesc
                if (IsCreate) await Create();
            }
        });
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsCreate)
        {
            if (_itemId is not null || _statusId == Guid.Empty)
            {
                _itemId = null;
                _title = "";
                _description = "";
                _error = null;
                _assigneeId = null;
                _priority = TaskPriority.None;
                _boardId = Board.Id;
                _statusId = InitialStatusId();
                _typeId = DefaultTypeId();
                _newCustomFields = [];
                _focusTitle = true;
            }
            else if (_boardId != Board.Id)
            {
                // Проект сменили прямо в форме: статус принадлежит проекту, чужой Flow.Api отвергнет с 400.
                // Введённые название и описание при этом сохраняем — их писали не для проекта, а для задачи.
                _boardId = Board.Id;
                _statusId = InitialStatusId();
                _typeId = DefaultTypeId();
                _newCustomFields = []; // поля — у каждого проекта свои
            }

            return;
        }

        if (_itemId != Item!.Id)
        {
            _itemId = Item.Id;
            _editingTitle = false;
            _editingDesc = false;
            _whoOpen = false;
            _error = null;
        }

        await Task.CompletedTask;
    }

    private bool _focusTitle;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusTitle)
        {
            _focusTitle = false;
            // Пауза обязательна: MudFocusTrap слайдера ставит фокус на первый элемент внутри (кнопку
            // в шапке) в своём OnAfterRender — без задержки он перебивает нас, и «N» открывает форму,
            // в которой нельзя сразу печатать.
            await Task.Delay(50);
            await Browser.FocusAsync("td-title");
        }
    }

    private Guid DefaultTypeId() =>
        Board.TaskTypes.FirstOrDefault(t => t.IsDefault)?.Id ?? Guid.Empty;

    private Guid InitialStatusId() =>
        Board.Statuses.FirstOrDefault(s => s.IsInitial)?.Id ?? Board.Statuses.FirstOrDefault()?.Id ?? Guid.Empty;

    private Task Close() => OnClose.InvokeAsync();

    /// <summary>«Развернуть» — переход на страницу задачи: слайдер закрывается сменой адреса.</summary>
    private void OpenFullPage()
    {
        if (Item is not null)
            Nav.NavigateTo($"tasks/{Item.Id}");
    }

    private Task OnTitleActivate(KeyboardEventArgs e) =>
        e.Key is "Enter" or " " ? StartTitleEdit() : Task.CompletedTask;

    // Успешное сохранение подтверждаем меткой в шапке: тост на каждую смену статуса был бы навязчив,
    // а молчание не даёт понять, сохранилось ли.
    private async Task FlashSaved()
    {
        _savedAt = DateTime.UtcNow;
        _savedCts?.Cancel();
        _savedCts = new CancellationTokenSource();
        var token = _savedCts.Token;
        StateHasChanged();

        try
        {
            await Task.Delay(1800, token);
            _savedAt = null;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task OnBodyKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey))
        {
            if (IsCreate) await Create();
            else if (_editingDesc) await SaveDesc();
        }
    }

    private async Task Create()
    {
        var title = _title.Trim();
        if (title.Length == 0 || _busy)
            return;

        _busy = true;
        _error = null;
        var result = await Api.CreateTask(Board.Id, new CreateTaskRequest(title, NullIfEmpty(_description), _statusId,
            _typeId == Guid.Empty ? null : _typeId, _priority,
            CustomFields: _newCustomFields.Count == 0 ? null : _newCustomFields.ToDictionary(p => p.Key, p => (System.Text.Json.JsonElement?)p.Value),
            AssigneeId: _assigneeId));
        _busy = false;

        if (!result.Ok)
        {
            _error = result.Error;
            return;
        }

        // Исполнитель приходит в самом запросе: обязательный исполнитель на экране создания проверяет сервер.
        await OnCreated.InvokeAsync(result.Value!);
    }

    private async Task StartTitleEdit()
    {
        if (!CanEdit) return;
        _title = Item!.Title;
        _editingTitle = true;
        _titleCancelled = false;
        StateHasChanged();
        await Task.Yield();
        await Browser.FocusAsync("td-title-edit", select: true);
    }

    private async Task OnTitleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CommitTitle();
        else if (e.Key == "Escape") { _titleCancelled = true; _editingTitle = false; }
    }

    private async Task CommitTitle()
    {
        if (!_editingTitle || _titleCancelled)
            return;

        _editingTitle = false;
        var title = _title.Trim();
        if (title.Length == 0 || title == Item!.Title)
            return;

        await Patch(new UpdateTaskRequest(title, null, null));
    }

    private Task ChangeStatus(Guid statusId) => Patch(new UpdateTaskRequest(null, null, statusId));

    private async Task SetParent(Guid? parentId)
    {
        await Apply(id => Api.SetParent(id, new SetTaskParentRequest(parentId)), "Не удалось сменить родителя");
        await OnHierarchyChanged.InvokeAsync();
    }

    private Task SetSprint(Guid? sprintId) =>
        Apply(id => Api.SetTaskSprint(id, new SetTaskSprintRequest(sprintId)), "Не удалось перенести задачу в спринт");

    private void SetNewCustomField(Guid fieldId, System.Text.Json.JsonElement? value)
    {
        if (value is { } v)
            _newCustomFields[fieldId] = v;
        else
            _newCustomFields.Remove(fieldId);
    }

    private Task SetCustomField(Guid fieldId, System.Text.Json.JsonElement? value) =>
        Apply(id => Api.SetTaskCustomFields(id, new SetCustomFieldsRequest(new Dictionary<Guid, System.Text.Json.JsonElement?> { [fieldId] = value })),
            "Не удалось сохранить поле");

    private Task SetMilestone(Guid? milestoneId) =>
        Apply(id => Api.SetTaskMilestone(id, new SetTaskMilestoneRequest(milestoneId)), "Не удалось сменить веху");

    private async Task OnChecklistChanged((int OldDone, int OldTotal, int Done, int Total) c)
    {
        _timeline?.NoteActivity(TaskActivityType.ChecklistChanged, $"{c.OldDone}/{c.OldTotal}", $"{c.Done}/{c.Total}");
        await OnUpdated.InvokeAsync(Current with { ChecklistDone = c.Done, ChecklistTotal = c.Total });
    }

    private Task OnChildCountsChanged((int Total, int Done) counts) =>
        OnUpdated.InvokeAsync(Current with { ChildCount = counts.Total, ChildDoneCount = counts.Done });

    private async Task HandleSubtaskCreated(TaskResponse child)
    {
        _timeline?.NoteChildAdded(child);
        await OnHierarchyChanged.InvokeAsync();
    }

    private Task ChangeType(Guid typeId) => Patch(new UpdateTaskRequest(null, null, null, typeId));

    private Task ChangePriority(TaskPriority priority) => Patch(new UpdateTaskRequest(null, null, null, Priority: priority));

    private async Task Assign(Guid? userId)
    {
        var before = Item!;
        _busy = true;
        var result = await Api.AssignTask(before.Id, new AssignTaskRequest(userId));
        _busy = false;
        if (!result.Ok)
        {
            Toasts.Error(result.Error ?? "Не удалось назначить исполнителя");
            return;
        }

        _latest = result.Value!.WithCountsOf(before);
        await OnUpdated.InvokeAsync(_latest);
        _timeline?.NoteLocalChange(before, _latest);
    }

    private async Task StartDescEdit()
    {
        if (!CanEdit) return;
        _description = Item!.Description ?? "";
        _editingDesc = true;
        await Task.CompletedTask;
    }

    private bool IsDone => Board.Statuses.FirstOrDefault(s => s.Id == Item?.StatusId)?.IsFinal == true;

    private Task SetDueDate(DateOnly? dueDate) =>
        Apply(id => Api.SetDueDate(id, new SetTaskDueDateRequest(dueDate)), "Не удалось изменить срок");

    private Task SetStartDate(DateOnly? startDate) =>
        Apply(id => Api.SetSchedule(id, new SetTaskScheduleRequest(startDate, Current.DueDate)), "Не удалось изменить дату начала");

    private Task SetEstimate((decimal? StoryPoints, int? EstimateMinutes) value) =>
        Apply(id => Api.SetEstimate(id, new SetTaskEstimateRequest(value.StoryPoints, value.EstimateMinutes)), "Не удалось изменить оценку");

    /// <summary>Правка отдельным эндпоинтом (срок, даты, оценка): ошибку показывает тост — текст сервера объясняет,
    /// что не так («начало позже срока»), а лента получает локальную запись без перезагрузки.</summary>
    private async Task Apply(Func<Guid, Task<ApiResult<TaskResponse>>> call, string fallbackError)
    {
        var before = Current;
        _busy = true;
        _error = null;
        var result = await call(before.Id);
        _busy = false;
        if (!result.Ok)
        {
            Toasts.Error(result.Error ?? fallbackError);
            return;
        }

        _latest = result.Value!.WithCountsOf(before);
        await OnUpdated.InvokeAsync(_latest);
        _timeline?.NoteLocalChange(before, _latest);
        _ = FlashSaved();
    }

    private Task OnDescClick() => string.IsNullOrWhiteSpace(Item?.Description) ? StartDescEdit() : Task.CompletedTask;

    private void CancelDesc() => _editingDesc = false;

    private async Task SaveDesc()
    {
        if (!_editingDesc || _busy)
            return;

        var text = _description.TrimEnd();
        if (text == (Item!.Description ?? ""))
        {
            _editingDesc = false;
            return;
        }

        // PATCH-семантика: null = «не трогать», поэтому очищенное описание отправляем как пустую строку.
        var ok = await Patch(new UpdateTaskRequest(null, text, null));
        if (ok)
            _editingDesc = false;
    }

    private async Task<bool> Patch(UpdateTaskRequest request)
    {
        var before = Current;
        _busy = true;
        _error = null;
        var result = await Api.UpdateTask(before.Id, request);
        _busy = false;

        if (!result.Ok)
        {
            Toasts.Error(result.Error ?? "Не удалось сохранить задачу");
            return false;
        }

        _latest = result.Value!.WithCountsOf(before);
        await OnUpdated.InvokeAsync(_latest);
        _timeline?.NoteLocalChange(before, _latest);
        _ = FlashSaved();
        return true;
    }

    private async Task CopyCode()
    {
        var ok = await Browser.CopyAsync(Item!.Code);
        if (ok) Toasts.Ok($"Скопировано: {Item.Code}");
        else Toasts.Error("Не удалось скопировать");
    }

    // Комментарий добавлен или удалён в ленте: число показывает строка списка, поэтому отдаём его наверх
    // тем же путём, что и правки задачи.
    private Task OnCommentCountChanged(int count) =>
        Item is null || Item.CommentCount == count
            ? Task.CompletedTask
            : OnUpdated.InvokeAsync(Item with { CommentCount = count });

    private static string? NullIfEmpty(string s) => string.IsNullOrWhiteSpace(s) ? null : s.TrimEnd();

    private void OnUsersChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Users.Changed -= OnUsersChanged;
        _hotkeys?.Dispose();
        _savedCts?.Cancel();
    }
}
