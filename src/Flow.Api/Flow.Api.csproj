<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Flow.Application\Flow.Application.csproj" />
        <ProjectReference Include="..\Flow.Infrastructure\Flow.Infrastructure.csproj" />
        <ProjectReference Include="..\Flow.Shared\Flow.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Bearer JWT от Flow.Auth: discovery/JWKS по Auth:BaseUrl, audience flow-api. -->
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
        <!-- Нужно самому startup-проекту для dotnet ef (DbContext живёт в Flow.Infrastructure). -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
