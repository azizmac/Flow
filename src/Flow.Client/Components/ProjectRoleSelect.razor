@* Роль в проекте «в строке» — как StatusSelect: пилюля + меню ролей с подсказкой, что каждая может.
   Allowed — роли, которые actor может выдать (не выше своей); остальные не показываются. *@

<MudMenu @bind-Open="_open" PopoverClass="flow-pop" ListClass="flow-pop-list" AnchorOrigin="Origin.BottomLeft"
         TransformOrigin="Origin.TopLeft" Dense="true" DropShadow="false" Ripple="false" AriaLabel="Сменить роль в проекте">
    <ActivatorContent>
        <div class="status-sel @(Disabled ? "disabled" : "")" @onclick="Toggle" @onclick:stopPropagation
             @onkeydown="OnKey" @onkeydown:stopPropagation
             role="button" tabindex="@(Disabled ? -1 : 0)" aria-haspopup="listbox" aria-disabled="@(Disabled ? "true" : "false")"
             aria-expanded="@(_open ? "true" : "false")" title="@(Disabled ? "Сохраняем…" : "Сменить роль в проекте")">
            <span class="lbl">@(CurrentSet?.Name ?? Permissions.ProjectRoleLabel(Value))</span>
            <Icon Name="chevrons" Size="12" />
        </div>
    </ActivatorContent>
    <ChildContent>
        @foreach (var role in Allowed)
        {
            <MudMenuItem Class="@($"pop-item role-item {(role == Value && SetId is null ? "cur" : "")}")" OnClick="() => Select(role)">
                <span class="pop-user">
                    <span class="pop-user-name">@Permissions.ProjectRoleLabel(role)</span>
                    <span class="pop-user-un">@Permissions.ProjectRoleHint(role)</span>
                </span>
            </MudMenuItem>
        }
        @* Свои наборы прав (этап 4E) — по базовой роли не выше разрешённых. *@
        @foreach (var set in Sets.Where(x => Allowed.Contains(x.BaseRole)))
        {
            <MudMenuItem Class="@($"pop-item role-item {(set.Id == SetId ? "cur" : "")}")" OnClick="() => SelectSet(set)">
                <span class="pop-user">
                    <span class="pop-user-name">@set.Name</span>
                    <span class="pop-user-un">набор · основа «@Permissions.ProjectRoleLabel(set.BaseRole)»</span>
                </span>
            </MudMenuItem>
        }
    </ChildContent>
</MudMenu>

@code {
    [Parameter] public ProjectRole Value { get; set; }
    [Parameter] public IReadOnlyList<ProjectRole> Allowed { get; set; } = [ProjectRole.Viewer, ProjectRole.Member, ProjectRole.Developer, ProjectRole.Admin];
    [Parameter] public EventCallback<ProjectRole> OnChange { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Свои наборы прав (этап 4E); выбор набора приходит в OnSetChange, если он задан.</summary>
    [Parameter] public IReadOnlyList<PermissionSetResponse> Sets { get; set; } = [];
    [Parameter] public Guid? SetId { get; set; }
    [Parameter] public EventCallback<(ProjectRole Role, Guid? SetId)> OnSetChange { get; set; }

    private PermissionSetResponse? CurrentSet => SetId is { } id ? Sets.FirstOrDefault(x => x.Id == id) : null;

    private bool _open;

    private void OnKey(KeyboardEventArgs e)
    {
        if (!Disabled && e.Key is "Enter" or " " or "ArrowDown")
            _open = true;
    }

    private void Toggle()
    {
        if (!Disabled)
            _open = !_open;
    }

    private async Task Select(ProjectRole role)
    {
        _open = false;
        if (role == Value && SetId is null)
            return;
        if (OnSetChange.HasDelegate)
            await OnSetChange.InvokeAsync((role, null));
        else
            await OnChange.InvokeAsync(role);
    }

    private async Task SelectSet(PermissionSetResponse set)
    {
        _open = false;
        if (set.Id != SetId)
            await OnSetChange.InvokeAsync((set.BaseRole, set.Id));
    }
}
