@* Добавление репозитория (docs/TZ_git_integration.md §6): список репозиториев подключения с поиском, по клику Flow
   создаёт вебхук со случайным секретом. Не вышло (нет прав или не задан Scm:PublicBaseUrl) — адрес и секрет
   показываются здесь один раз для ручной настройки у хостинга. *@
@implements IAsyncDisposable
@inject IFlowApi Api
@inject BrowserInterop Browser
@inject ToastService Toasts

<MudDialog @ref="_dialog" Visible="@_visible" VisibleChanged="OnVisibleChanged" Options="_options" Class="flow-modal"
           TitleClass="flow-modal-title" ContentClass="flow-modal-content" ActionsClass="modal-actions">
    <TitleContent>
        <h3>Репозиторий из «@Connection.Name»</h3>
    </TitleContent>
    <DialogContent>
        @if (_manual is { } m)
        {
            <div class="ds-field-error">@m.WebhookError</div>
            <div class="git-manual">
                <div class="hint">Адрес (Payload URL), тип application/json, события: push, pull request, создание и удаление веток</div>
                <code>@m.ManualWebhookUrl</code>
                <div class="hint">Секрет</div>
                <code>@m.ManualWebhookSecret</code>
                <DsButton Variant="secondary" Size="sm" Icon="copy" OnClick="CopySecret">Скопировать секрет</DsButton>
            </div>
        }
        else
        {
            <DsInput Id="git-repo-q" Icon="search" Placeholder="Найти репозиторий" Value="@_query" ValueChanged="Search" />
            @if (_repositories is null)
            {
                <Skeleton Kind="rows" Count="3" />
            }
            else if (_repositories.Count == 0)
            {
                <div class="hint">@(_error ?? "Ничего не нашлось.")</div>
            }
            else
            {
                <div class="git-remote">
                    @foreach (var r in _repositories)
                    {
                        <button type="button" class="git-remote-row" disabled="@(r.IsAdded || _busy)" @onclick="() => Add(r)">
                            <span>@r.FullName</span>
                            <span class="hint">@(r.IsAdded ? "подключён" : r.DefaultBranch)</span>
                        </button>
                    }
                </div>
            }
        }
    </DialogContent>
    <DialogActions>
        <DsButton Variant="secondary" Size="md" OnClick="Close" Disabled="_busy">@(_manual is null ? "Отмена" : "Готово")</DsButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public GitHostConnectionResponse Connection { get; set; } = default!;
    [Parameter] public EventCallback<GitRepositoryResponse> OnAdded { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private MudDialog? _dialog;
    private bool _visible = true;
    private bool _closing;
    private bool _busy;
    private string _query = "";
    private string? _error;
    private IReadOnlyList<GitRemoteRepositoryResponse>? _repositories;
    private GitRepositoryResponse? _manual;
    private CancellationTokenSource? _cts;

    private readonly DialogOptions _options = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = false, CloseOnEscapeKey = true, BackdropClick = true };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(null, CancellationToken.None);
        await Task.Delay(50);
        await Browser.FocusAsync("git-repo-q");
    }

    private async Task Search(string query)
    {
        _query = query;
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        try
        {
            await Task.Delay(300, token);
            await LoadAsync(query, token);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task LoadAsync(string? query, CancellationToken token)
    {
        var result = await Api.GetAvailableRepositories(Connection.Id, string.IsNullOrWhiteSpace(query) ? null : query.Trim(), token);
        if (token.IsCancellationRequested)
            return;
        _error = result.Ok ? null : result.Error ?? "Хостинг не ответил";
        _repositories = result.Ok ? result.Value : [];
        StateHasChanged();
    }

    private async Task Add(GitRemoteRepositoryResponse remote)
    {
        _busy = true;
        var result = await Api.AddGitRepository(new AddGitRepositoryRequest(Connection.Id, remote.ExternalId));
        _busy = false;
        if (!result.Ok)
        {
            Toasts.Error(result.Error ?? "Не удалось подключить репозиторий");
            return;
        }

        await OnAdded.InvokeAsync(result.Value!);
        if (!result.Value!.WebhookCreated)
        {
            _manual = result.Value;
            return;
        }

        Toasts.Ok($"{remote.FullName} подключён — привяжите его к проекту");
        await Close();
    }

    private async Task CopySecret()
    {
        if (await Browser.CopyAsync(_manual!.ManualWebhookSecret ?? ""))
            Toasts.Ok("Секрет скопирован");
    }

    private Task OnVisibleChanged(bool visible) => visible || _closing ? Task.CompletedTask : Close();

    private async Task CloseDialog()
    {
        if (_closing) return;
        _closing = true;
        _visible = false;
        _cts?.Cancel();
        if (_dialog is not null)
            await _dialog.CloseAsync();
    }

    public ValueTask DisposeAsync() => new(CloseDialog());

    private async Task Close()
    {
        if (_busy) return;
        await CloseDialog();
        await OnClose.InvokeAsync();
    }
}
