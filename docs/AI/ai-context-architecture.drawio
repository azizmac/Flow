<mxfile host="drawio" version="24.0.0">
  <diagram id="ai-context" name="AI Context Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Flow — механика хранения контекста ИИ (по модели Hermes: Memory + Skills + Session + RAG)" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
