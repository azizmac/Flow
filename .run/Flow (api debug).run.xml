<component name="ProjectRunConfigurationManager">
  <!-- Данные в Docker, api — процессом Rider под отладчиком: брейкпоинты, горячая перезагрузка, без
       пересборки образа. Интерфейс на http://localhost:5000 (профиль http из launchSettings.json).
       Адреса берутся из appsettings.json и совпадают с дефолтами стека данных: Postgres localhost:5432,
       MinIO localhost:9000. Если в .env порт другой (POSTGRES_PORT=5433 рядом с локальным Postgres),
       api уйдёт в чужую базу — тогда задать в этой конфигурации переменную окружения
       ConnectionStrings__Postgres=Host=localhost;Port=5433;Database=flow;Username=flow;Password=flow.
       Контейнер api из «Flow (full stack)» лучше остановить: два процесса разбирают одну очередь индексации. -->
  <configuration default="false" name="Flow (api debug)" type="LaunchSettings" factoryName=".NET Launch Settings Profile">
    <option name="LAUNCH_PROFILE_PROJECT_FILE_PATH" value="$PROJECT_DIR$/src/Flow.Api/Flow.Api.csproj" />
    <option name="LAUNCH_PROFILE_TFM" value="net10.0" />
    <option name="LAUNCH_PROFILE_NAME" value="http" />
    <option name="USE_MONO" value="0" />
    <option name="RUNTIME_ARGUMENTS" value="" />
    <option name="GENERATE_APPLICATIONHOST_CONFIG" value="1" />
    <option name="SHOW_IIS_EXPRESS_OUTPUT" value="0" />
    <option name="SEND_DEBUG_REQUEST" value="1" />
    <option name="ADDITIONAL_IIS_EXPRESS_ARGUMENTS" value="" />
    <option name="AUTO_ATTACH_CHILDREN" value="0" />
    <option name="MIXED_MODE_DEBUG" value="0" />
    <method v="2">
      <option name="RunConfigurationTask" enabled="true" run_configuration_name="Flow (init)" run_configuration_type="ShConfigurationType" />
      <option name="RunConfigurationTask" enabled="true" run_configuration_name="Flow (data stack)" run_configuration_type="docker-deploy" />
      <option name="Build" />
    </method>
  </configuration>
</component>
