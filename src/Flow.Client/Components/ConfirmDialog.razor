@* Модалка подтверждения (удаление проекта/задачи/файла/комментария). Enter — подтвердить, Esc — закрыть.

   Слой — MudDialog: затемнение, захват фокуса, Esc и клик по фону берёт на себя библиотека.
   Вид прежний — класс .flow-modal (mud-overrides.css). Enter остаётся на нашем HotkeyService:
   у диалога Mud подтверждения по Enter нет, а хоткей в Flow привычен.
   Компонент по-прежнему монтируется условием на странице (@if (_deleting is not null)), поэтому
   открыт он всегда — за видимость отвечает вызывающая сторона, как и раньше. *@
@implements IDisposable
@inject HotkeyService Hotkeys

<MudDialog Visible="true" VisibleChanged="OnVisibleChanged" Options="_options" Class="flow-modal"
           TitleClass="flow-modal-title" ContentClass="flow-modal-content" ActionsClass="modal-actions">
    <TitleContent>
        <h3>@Title</h3>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(Text))
        {
            <p>@Text</p>
        }
    </DialogContent>
    <DialogActions>
        <DsButton Variant="secondary" Size="md" OnClick="Cancel" Disabled="_busy">Отмена</DsButton>
        <DsButton Id="@_confirmId" Variant="danger" Size="md" OnClick="Confirm" Busy="_busy" Icon="trash">@ConfirmLabel</DsButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Text { get; set; }
    [Parameter] public string ConfirmLabel { get; set; } = "Удалить";
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private readonly string _confirmId = "cd-" + Guid.NewGuid().ToString("N")[..8];
    private bool _busy;
    private IDisposable? _hotkeys;

    // Заголовок и кнопки у нас свои, поэтому шапку и крестик Mud не показываем.
    private readonly DialogOptions _options = new()
    {
        MaxWidth = MaxWidth.ExtraSmall,
        CloseButton = false,
        CloseOnEscapeKey = true,
        BackdropClick = true,
        DefaultFocus = DefaultFocus.LastChild
    };

    protected override void OnInitialized()
    {
        _hotkeys = Hotkeys.Subscribe(async e =>
        {
            if (e.Key == "Enter" && !e.InEditable)
            {
                e.Handled = true;
                await Confirm();
            }
        });
    }

    /// <summary>Esc или клик по фону — закрытие идёт тем же путём, что и кнопка «Отмена».</summary>
    private Task OnVisibleChanged(bool visible) => visible ? Task.CompletedTask : Cancel();

    private Task Cancel() => _busy ? Task.CompletedTask : OnCancel.InvokeAsync();

    private async Task Confirm()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await OnConfirm.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose() => _hotkeys?.Dispose();
}
