@inherits LayoutComponentBase
@inject HotkeyService Hotkeys

<div class="flow-app">
    <Sidebar />
    <div class="main">
        @Body
    </div>
    <Toast />
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Hotkeys.EnsureRegisteredAsync();
    }
}
