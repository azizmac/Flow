@* Меню «…» задачи: Открыть · Переименовать · Скопировать код · — · Удалить. *@

<DsIconButton Id="@_id" Icon="more" Size="@Size" Title="Действия" OnClick="Toggle" Style="@Style" />
@if (_open)
{
    <Popover AnchorId="@_id" Align="right" Width="190" Offset="4" OnClose="Close">
        @if (ShowOpen)
        {
            <button type="button" class="pop-item" @onclick="() => Fire(OnOpen)"><Icon Name="view" Size="15" />Открыть</button>
        }
        @if (ShowRename)
        {
            <button type="button" class="pop-item" @onclick="() => Fire(OnRename)"><Icon Name="edit" Size="15" />Переименовать</button>
        }
        <button type="button" class="pop-item" @onclick="() => Fire(OnCopy)"><Icon Name="copy" Size="15" />Скопировать код</button>
        <div class="pop-sep"></div>
        @if (ShowDelete)
        {
            <button type="button" class="pop-item danger" @onclick="() => Fire(OnDelete)"><Icon Name="trash" Size="15" />Удалить</button>
        }
    </Popover>
}

@code {
    [Parameter] public bool ShowOpen { get; set; } = true;
    /// <summary>Пункты, требующие прав (Permissions.CanEditTask / CanManageBoards); без них меню — открыть и скопировать.</summary>
    [Parameter] public bool ShowRename { get; set; } = true;
    [Parameter] public bool ShowDelete { get; set; } = true;
    [Parameter] public int Size { get; set; } = 26;
    [Parameter] public string? Style { get; set; }
    [Parameter] public EventCallback OnOpen { get; set; }
    [Parameter] public EventCallback OnRename { get; set; }
    [Parameter] public EventCallback OnCopy { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private readonly string _id = "rm-" + Guid.NewGuid().ToString("N")[..8];
    private bool _open;

    private void Toggle() => _open = !_open;

    private void Close() => _open = false;

    private async Task Fire(EventCallback cb)
    {
        _open = false;
        await cb.InvokeAsync();
    }
}
