@* Фильтр выдачи по проекту: пилюля-триггер + меню со списком проектов. По образцу AssigneeFilter.
   Слой — MudMenu (позиция, клавиатура, закрытие), вид — прежние .status-sel и .pop-item. *@

<MudMenu @bind-Open="_open" PopoverClass="flow-pop flow-pop-wide" ListClass="flow-pop-list" AnchorOrigin="Origin.BottomLeft"
         TransformOrigin="Origin.TopLeft" Dense="true" DropShadow="false" Ripple="false" AriaLabel="Фильтр по проекту">
    <ActivatorContent>
        <div class="status-sel @(Value is null ? "" : "on")" @onclick="() => _open = !_open" @onclick:stopPropagation
             role="button" tabindex="0" aria-haspopup="listbox" aria-expanded="@(_open ? "true" : "false")"
             title="Фильтр по проекту">
            @if (Current is { } board)
            {
                <span class="code">@board.Key</span><span class="lbl">@board.Name</span>
            }
            else
            {
                <Icon Name="grid" Size="14" Style="color:rgba(255,255,255,0.6);margin:0;" /><span class="lbl">Все проекты</span>
            }
            <Icon Name="chevrons" Size="12" />
        </div>
    </ActivatorContent>
    <ChildContent>
        <MudMenuItem Class="@($"pop-item {(Value is null ? "cur" : "")}")" OnClick="() => Select(null)">
            <Icon Name="grid" Size="15" />Все проекты
        </MudMenuItem>
        @foreach (var board in Boards)
        {
            <MudMenuItem Class="@($"pop-item {(Value == board.Id ? "cur" : "")}")" OnClick="() => Select(board.Id)">
                <span class="code">@board.Key</span>
                <span class="pop-user"><span class="pop-user-name">@board.Name</span></span>
            </MudMenuItem>
        }
    </ChildContent>
</MudMenu>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<BoardResponse> Boards { get; set; } = [];
    [Parameter] public Guid? Value { get; set; }
    [Parameter] public EventCallback<Guid?> ValueChanged { get; set; }

    private bool _open;

    private BoardResponse? Current => Boards.FirstOrDefault(board => board.Id == Value);

    private async Task Select(Guid? value)
    {
        _open = false;
        if (value != Value)
            await ValueChanged.InvokeAsync(value);
    }
}
