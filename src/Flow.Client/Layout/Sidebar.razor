@* Drawer-nav 240px по Sidebar.dc.html. Строка поиска — GlobalSearch (выдача на /search).
   «Проекты» → /boards; «Задачи» → /tasks (все проекты);
   «Люди» → /users. Дашборды/Настройки — в API ещё нет: помечены «скоро» и не притворяются кликабельными.
   Футер — текущий пользователь: claim sub из токена Flow.Auth → AppState.CurrentUserId, профиль — GET /users/me;
   кнопка «Выйти» → authentication/logout (endsession в Flow.Auth). *@
@implements IDisposable
@inject NavigationManager Nav
@inject AppState State
@inject UserDirectory Users
@inject IFlowApi Api
@inject AuthenticationStateProvider AuthState
@inject BrowserInterop Browser

<nav class="sb @SidebarModeClass">
    <div class="sb-top">
        <a class="sb-brand" href="boards" title="К проектам" aria-label="Flow — к проектам"><BrandMark Size="34" /><div class="sb-word">FLOW</div></a>
        @* Ниже 1366px сайдбар сворачивается сам; кнопка нужна, чтобы это решение можно было отменить в обе стороны.
           Кнопок две, и показывает их тот же CSS, что решает режим: иначе в автоматически свёрнутом сайдбаре
           (ширина < 1366px, выбора ещё не было) кнопка предлагала бы «свернуть» уже свёрнутое и клик ничего
           не менял бы. Стрелка одна и та же, у «развернуть» она повёрнута — видно, куда поедет панель. *@
        <DsIconButton Icon="arrow-left" Size="28" Class="sb-toggle sb-toggle-collapse" Title="Свернуть меню"
                      Style="color:rgba(255,255,255,0.65)" OnClick="() => State.ToggleSidebar(true)" />
        <DsIconButton Icon="arrow-left" Size="28" Class="sb-toggle sb-toggle-expand" Title="Развернуть меню"
                      Style="color:rgba(255,255,255,0.65)" OnClick="() => State.ToggleSidebar(false)" />
    </div>

    @* Шеврон обещает выпадающий список, которого ещё нет: помечаем блок как «скоро», чтобы клик по нему не выглядел сломанным. *@
    <div class="sb-ws disabled" aria-disabled="true" title="Рабочие пространства — в разработке">
        <div>
            <div class="sb-ws-name">Flow</div>
            <div class="sb-ws-sub">Workspace</div>
        </div>
        <span class="sb-soon">скоро</span>
        <Icon Name="chevrons" Size="14" Style="color:rgba(255,255,255,0.25)" />
    </div>

    @* В иконочном режиме строка поиска не помещается — вместо неё ссылка на экран поиска. *@
    <GlobalSearch />
    <a class="sb-item sb-search-icon" href="search" title="Поиск"><Icon Name="search" Size="18" /></a>

    <div class="sb-section">Рабочее пространство</div>

    <a class="sb-item @(IsBoards ? "active" : "")" href="boards" title="Проекты"><Icon Name="grid" Size="18" /><span>Проекты</span></a>
    <a class="sb-item @(IsTasks ? "active" : "")" href="@TasksHref" title="Задачи"><Icon Name="check" Size="18" /><span>Задачи</span></a>
    <a class="sb-item @(IsUsers ? "active" : "")" href="users" title="Люди"><Icon Name="users" Size="18" /><span>Люди</span></a>
    <span class="sb-item disabled" aria-disabled="true" title="Раздел появится позже"><Icon Name="chart" Size="18" /><span>Дашборды</span><span class="sb-soon">скоро</span></span>
    <span class="sb-item disabled" aria-disabled="true" title="Раздел появится позже"><Icon Name="settings" Size="18" /><span>Настройки</span><span class="sb-soon">скоро</span></span>

    <div class="sb-foot">
        @if (Me is { } me)
        {
            <a class="sb-me" href="@($"users/{me.Id}")" title="Мой профиль">
                <Avatar User="me" Size="32" />
                <div style="flex:1;min-width:0;">
                    <div class="sb-un">@me.FullName</div>
                    <div class="sb-ur">@(string.IsNullOrEmpty(me.JobTitle) ? "@" + me.Username : me.JobTitle)</div>
                </div>
            </a>
        }
        else
        {
            <div class="sb-me">
                <span class="sb-av ghost"><Icon Name="user" Size="16" /></span>
                <div style="flex:1;min-width:0;">
                    <div class="sb-un">@(_meError ?? "Загрузка…")</div>
                    <div class="sb-ur">@_name</div>
                </div>
            </div>
        }
        <DsIconButton Icon="logout" Size="30" Title="Выйти" Style="color:rgba(255,255,255,0.45)" OnClick="Logout" />
    </div>
</nav>

@code {
    private string _name = "";

    /// <summary>Класс режима: пусто — ширина решает сама, collapsed/expanded — выбор кнопкой.</summary>
    private string SidebarModeClass => State.SidebarCollapsed switch
    {
        true => "collapsed",
        false => "expanded",
        null => ""
    };

    private string? _meError;

    private string Path => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');

    private bool IsBoards => Path is "" or "boards";

    private bool IsTasks => Path is "tasks"
                            || Path.StartsWith("boards/", StringComparison.OrdinalIgnoreCase)
                            || Path.StartsWith("tasks/", StringComparison.OrdinalIgnoreCase);

    private bool IsUsers => Path is "users" || Path.StartsWith("users/", StringComparison.OrdinalIgnoreCase);

    // Раньше пункт вёл в последний открытый проект; теперь это отдельный экран со всеми задачами,
    // а проект выбирается селектором в его топбаре.
    private const string TasksHref = "tasks";

    private UserResponse? Me => Users.Find(State.CurrentUserId);

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        State.Changed += OnStateChanged;
        Users.Changed += OnStateChanged;

        var auth = await AuthState.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated != true)
        {
            // Страховка: MainLayout прячет Sidebar за AuthorizeView, но без сессии в API ходить нельзя —
            // AccessTokenNotAvailableException начал бы вход даже с анонимных страниц.
            _meError = "Нет сессии";
            return;
        }

        _name = auth.User.Identity?.Name ?? "";
        // sub остался от токена OpenIddict, NameIdentifier кладёт cookie-схема Identity после /account/login.
        var actorId = auth.User.FindFirst("sub")?.Value
                      ?? auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (Guid.TryParse(actorId, out var id))
            State.SetCurrentUser(id);

        // Профиль текущего пользователя — сразу в справочник; остальных подгружаем следом (аватары исполнителей).
        var me = await Api.GetMe();
        if (me.Ok)
        {
            Users.Put(me.Value!);
        }
        else if (me.Unauthorized)
        {
            // Сессия есть, но профиля под неё нет (удалён руками, сменились ключи): чистим сессию,
            // чтобы человек вошёл заново, а не смотрел на пустой сайдбар.
            _meError = "Сессия устарела";
            await Browser.PostFormAsync("account/logout");
            return;
        }
        else
        {
            _meError = "Нет связи с API";
        }

        if (!Users.IsLoaded)
            _ = Users.EnsureLoadedAsync();
    }

    // Выход — POST на /account/logout хоста: cookie гасится там, на сервере. GET здесь был бы дырой
    // (чужая страница смогла бы разлогинить), поэтому форму отправляет flow.submitPost.
    private async Task Logout() => await Browser.PostFormAsync("account/logout");

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        State.Changed -= OnStateChanged;
        Users.Changed -= OnStateChanged;
    }
}
