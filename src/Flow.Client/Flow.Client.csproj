<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
        <!-- Даты форматируются вручную (Services/Ru.cs), ICU-данные в загрузку не тащим. -->
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all"/>
        <!-- OIDC-вход через Flow.Auth (code + PKCE) и Bearer в запросах к Flow.Api (AuthorizationMessageHandler). -->
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0"/>
        <!-- Markdown в описании задачи. HTML внутри Markdown отключён (см. MarkdownView). -->
        <PackageReference Include="Markdig" Version="1.3.2"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Flow.Shared\Flow.Shared.csproj" />
    </ItemGroup>

</Project>
