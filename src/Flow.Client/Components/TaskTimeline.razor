@using System.Globalization
@* Лента задачи: комментарии (карточки) и журнал изменений (компактные строки) в одном хронологическом списке.
   Данные — GET /tasks/{id}/comments + GET /tasks/{id}/activity параллельно, слияние по CreatedAt.
   Соседние записи журнала одного актора в пределах минуты — одна группа. CommentAdded не показываем:
   сам комментарий уже в ленте. Композер внизу — только Member+ (Permissions.CanComment). *@
@implements IDisposable
@inject IFlowApi Api
@inject ToastService Toasts
@inject AppState State
@inject UserDirectory Users
@inject TeamDirectory Teams
@inject ProjectAccessState Access

<div class="timeline" id="timeline">
    <div class="timeline-head">
        <div class="section-title">Активность</div>
        <div class="seg" role="tablist">
            <button type="button" class="seg-btn @(_filter == Filter.All ? "on" : "")" role="tab" @onclick="() => _filter = Filter.All">Все</button>
            <button type="button" class="seg-btn @(_filter == Filter.Comments ? "on" : "")" role="tab" @onclick="() => _filter = Filter.Comments">Комментарии <span class="n">@_comments.Count</span></button>
            <button type="button" class="seg-btn @(_filter == Filter.History ? "on" : "")" role="tab" @onclick="() => _filter = Filter.History">История</button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="timeline-list"><div class="sk-line" style="width:60%"></div><div class="sk-line" style="width:40%"></div></div>
    }
    else if (_error is not null)
    {
        <div class="empty small">
            <div>@_error</div>
            <DsButton Variant="secondary" Size="sm" OnClick="Load">Повторить</DsButton>
        </div>
    }
    else
    {
        var items = Visible.ToList();
        <div class="timeline-list">
            @if (items.Count == 0)
            {
                <div class="timeline-empty">@(_filter == Filter.Comments ? "Комментариев пока нет" : "Пока пусто")</div>
            }
            @foreach (var item in items)
            {
                if (item.Comment is { } c)
                {
                    <div class="tl-comment @(c.Id == _highlightId ? "flash" : "")" id="@("comment-" + c.Id.ToString("N"))" @key="c.Id">
                        <Avatar User="Users.Find(c.AuthorId)" Size="30" />
                        <div class="tl-card">
                            <div class="tl-card-head">
                                <UserName Id="c.AuthorId" />
                                <span class="tl-time" title="@Ru.DateTimeFull(c.CreatedAt)">@Ru.Ago(c.CreatedAt)</span>
                                @if (c.EditedAt is { } edited)
                                {
                                    <span class="tl-time" title="@($"Изменено {Ru.DateTimeFull(edited)}")">· изменено</span>
                                }
                                @if (_editingId != c.Id)
                                {
                                    <span class="tl-card-actions">
                                        @if (Permissions.CanEditComment(Me, ProjectAccess, c))
                                        {
                                            <button type="button" class="md-tool" title="Редактировать" @onclick="() => StartEdit(c)"><Icon Name="edit" Size="14" /></button>
                                        }
                                        @if (Permissions.CanDeleteComment(Me, ProjectAccess, c))
                                        {
                                            <button type="button" class="md-tool danger" title="Удалить" @onclick="() => _deleting = c"><Icon Name="trash" Size="14" /></button>
                                        }
                                    </span>
                                }
                            </div>
                            @if (_editingId == c.Id)
                            {
                                <MarkdownEditor @bind-Value="_editText" MinHeight="100" Autofocus="true" Busy="_busy" AttachToTaskId="TaskItem.Id"
                                                SubmitLabel="Сохранить" OnSubmit="SaveEdit" OnCancel="() => _editingId = null" />
                            }
                            else
                            {
                                <MarkdownView Text="@c.Body" Class="tl-body" />
                            }
                        </div>
                    </div>
                }
                else if (item.Group is { } g)
                {
                    var first = g[0];
                    <div class="tl-event" @key="first.Id">
                        <Avatar User="Users.Find(first.ActorId)" Size="30" />
                        <div class="tl-event-body">
                            <span class="tl-event-line">
                                <UserName Id="first.ActorId" />
                                @if (g.Count == 1)
                                {
                                    <span class="tl-sep">·</span>
                                    @Render(first)@SourceOf(first)
                                }
                                <span class="tl-time" title="@Ru.DateTimeFull(first.CreatedAt)">@Ru.Ago(first.CreatedAt)</span>
                            </span>
                            @if (g.Count > 1)
                            {
                                <ul class="tl-event-list">
                                    @foreach (var a in g)
                                    {
                                        <li @key="a.Id">@Render(a)@SourceOf(a)</li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }

    @if (Permissions.CanComment(ProjectAccess))
    {
        <div class="tl-composer">
            <Avatar User="Me" Size="30" />
            <MarkdownEditor @bind-Value="_draft" Placeholder="@DraftPlaceholder" MinHeight="96"
                            Busy="_busy" SubmitLabel="Отправить" SubmitHint="отправить" OnSubmit="Send" Id="tl-draft" AttachToTaskId="TaskItem.Id" />
        </div>
    }
    else if (Me is not null)
    {
        <div class="hint">Комментировать могут участники проекта и выше.</div>
    }
</div>

@if (_deleting is { } del)
{
    <ConfirmDialog Title="Удалить комментарий?" Text="В истории останется отметка об удалении, текст восстановить нельзя."
                   OnConfirm="ConfirmDelete" OnCancel="() => _deleting = null" />
}

@code {
    [Parameter, EditorRequired] public TaskResponse TaskItem { get; set; } = default!;
    [Parameter, EditorRequired] public BoardResponse Board { get; set; } = default!;
    /// <summary>Число комментариев изменилось — страница обновляет TaskResponse.CommentCount.</summary>
    [Parameter] public EventCallback<int> OnCommentCountChanged { get; set; }

    private enum Filter { All, Comments, History }

    private sealed record Item(DateTime At, TaskCommentResponse? Comment, List<TaskActivityResponse>? Group);

    private Guid _loadedId;
    private CancellationTokenSource? _loadCts;
    private bool _loading = true;
    private string? _error;
    private bool _busy;
    private Filter _filter = Filter.All;
    private List<TaskCommentResponse> _comments = [];
    private List<TaskActivityResponse> _activity = [];
    private string _draft = "";
    private Guid? _editingId;
    private string _editText = "";
    private TaskCommentResponse? _deleting;
    private Guid? _highlightId;

    /// <summary>Задачи, на которые ссылаются записи об иерархии (родитель, подзадача): код и название для текста. null — удалена или скрыта.</summary>
    private readonly Dictionary<Guid, TaskResponse?> _taskRefs = [];
    private const string DraftPlaceholder = "Написать комментарий… @username — упомянуть, файл можно перетащить";

    private UserResponse? Me => Users.Find(State.CurrentUserId);

    /// <summary>Права в проекте задачи: комментировать может не каждый, кто её видит.</summary>
    private ProjectAccessResponse? ProjectAccess => Access.For(Board.Id);

    private static readonly TimeSpan GroupWindow = TimeSpan.FromSeconds(60);

    protected override void OnInitialized() => Users.Changed += OnUsersChanged;

    private void OnUsersChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == TaskItem.Id)
            return;

        // Лента предыдущей задачи не должна оставаться на экране, пока грузится новая. Черновик тоже её:
        // в слайдере задачи листают стрелками, и недописанный комментарий уехал бы в соседнюю задачу.
        var first = _loadedId == Guid.Empty;
        _loadedId = TaskItem.Id;
        _comments = [];
        _activity = [];
        _draft = "";
        _editingId = null;
        _editText = "";
        _deleting = null;
        _highlightId = null;
        _loading = true;

        // В слайдере задачи листают стрелками: без паузы каждая промежуточная задача успевает
        // отправить пару запросов, ответы которых уже никому не нужны.
        await Load(first ? TimeSpan.Zero : TimeSpan.FromMilliseconds(200));
    }

    public Task Load() => Load(TimeSpan.Zero);

    private async Task Load(TimeSpan delay)
    {
        _loadCts?.Cancel();
        var cts = new CancellationTokenSource();
        _loadCts = cts;

        if (delay > TimeSpan.Zero)
        {
            try
            {
                await Task.Delay(delay, cts.Token);
            }
            catch (TaskCanceledException)
            {
                return;
            }
        }

        var id = TaskItem.Id;
        _loading = true;
        _error = null;
        var comments = Api.GetComments(id);
        var activity = Api.GetActivity(id);
        await Task.WhenAll(comments, activity);

        // Пока ходили в API, человек мог уйти на другую задачу — чужой ответ не показываем.
        if (cts.IsCancellationRequested || id != TaskItem.Id)
            return;

        _loading = false;
        if (!comments.Result.Ok || !activity.Result.Ok)
        {
            _error = comments.Result.Error ?? activity.Result.Error;
            return;
        }

        _comments = comments.Result.Value!.ToList();
        _activity = activity.Result.Value!.ToList();
        await LoadTaskRefsAsync(cts.Token);
        await LoadNamesAsync();
    }

    /// <summary>Имена спринтов и вех для записей SprintChanged/MilestoneChanged — одним запросом по проекту и только когда такие записи есть.</summary>
    private Dictionary<Guid, string>? _sprintNames;

    private async Task LoadNamesThenRedrawAsync()
    {
        await LoadNamesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadNamesAsync()
    {
        if (_sprintNames is null && _activity.Any(a => a.Type == TaskActivityType.SprintChanged))
        {
            var result = await Api.GetSprints(Board.Id);
            _sprintNames = result.Ok ? result.Value!.ToDictionary(s => s.Id, s => s.Name) : new Dictionary<Guid, string>();
        }

        if (_milestoneNames is null && _activity.Any(a => a.Type == TaskActivityType.MilestoneChanged))
        {
            var result = await Api.GetMilestones(Board.Id);
            _milestoneNames = result.Ok ? result.Value!.ToDictionary(m => m.Id, m => m.Name) : new Dictionary<Guid, string>();
        }
    }

    /// <summary>
    /// «поле «SLA»: Gold → Silver». Определение поля — из проекта (Board.CustomFields); удалённого поля или варианта уже
    /// нет — пишем, что есть. NewValue — {"field": Id, "value": …}, OldValue — прежнее значение JSON.
    /// </summary>
    private RenderFragment CustomField(TaskActivityResponse a)
    {
        Guid? fieldId = null;
        System.Text.Json.JsonElement? next = null;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(a.NewValue ?? "{}");
            if (doc.RootElement.TryGetProperty("field", out var f) && Guid.TryParse(f.GetString(), out var id))
                fieldId = id;
            if (doc.RootElement.TryGetProperty("value", out var v) && v.ValueKind != System.Text.Json.JsonValueKind.Null)
                next = v.Clone();
        }
        catch (System.Text.Json.JsonException)
        {
        }

        var field = Board.CustomFields?.FirstOrDefault(x => x.Id == fieldId);
        System.Text.Json.JsonElement? old = null;
        if (a.OldValue is { } raw)
        {
            try { using var doc = System.Text.Json.JsonDocument.Parse(raw); old = doc.RootElement.Clone(); }
            catch (System.Text.Json.JsonException) { }
        }

        string Show(System.Text.Json.JsonElement? value) => value is not { } v ? "—"
            : field is null ? v.ToString()
            : Short(CustomFieldMeta.Display(field, v, id => Users.Find(id)?.FullName));

        return @<span>поле «@(field?.Name ?? "удалённое")»: <s class="tl-old">@Show(old)</s> <span class="tl-arrow">→</span> <b>@Show(next)</b></span>;
    }

    private static string Short(string text) => text.Length > 80 ? text[..80] + "…" : text;

    /// <summary>Имена вех для MilestoneChanged — так же лениво, как спринты.</summary>
    private Dictionary<Guid, string>? _milestoneNames;

    /// <summary>«веха: «A» → «B»», null с любой стороны — без вехи.</summary>
    private RenderFragment Milestones(TaskActivityResponse a) =>
        @<span>веха: <s class="tl-old">@(a.OldValue is { } o ? MilestoneName(o) : "нет")</s> <span class="tl-arrow">→</span> <b>@(a.NewValue is { } n ? MilestoneName(n) : "нет")</b></span>;

    private string MilestoneName(string value) =>
        Guid.TryParse(value, out var id) && _milestoneNames?.GetValueOrDefault(id) is { } name ? $"«{name}»" : "удалённая веха";

    /// <summary>«спринт: «A» → «B»», null с любой стороны — бэклог.</summary>
    private RenderFragment Sprints(TaskActivityResponse a) =>
        @<span>спринт: <s class="tl-old">@(a.OldValue is { } o ? SprintName(o) : "бэклог")</s> <span class="tl-arrow">→</span> <b>@(a.NewValue is { } n ? SprintName(n) : "бэклог")</b></span>;

    private string SprintName(string value) =>
        Guid.TryParse(value, out var id) && _sprintNames?.GetValueOrDefault(id) is { } name ? $"«{name}»" : "удалённый спринт";

    /// <summary>Подзадачу создали из блока «Подзадачи» этой же задачи — запись у родителя без перезагрузки ленты.</summary>
    public void NoteChildAdded(TaskResponse child)
    {
        if (State.CurrentUserId is not { } me) return;
        _taskRefs[child.Id] = child;
        _activity.Add(new TaskActivityResponse(Guid.NewGuid(), TaskItem.Id, me, TaskActivityType.ChildAdded, null, child.Id.ToString(), DateTime.UtcNow));
        StateHasChanged();
    }

    private async Task LoadTaskRefsThenRedrawAsync()
    {
        await LoadTaskRefsAsync(CancellationToken.None);
        await InvokeAsync(StateHasChanged);
    }

    private static readonly TaskActivityType[] HierarchyTypes =
        [TaskActivityType.ParentChanged, TaskActivityType.ChildAdded, TaskActivityType.ChildRemoved,
         TaskActivityType.LinkAdded, TaskActivityType.LinkRemoved, TaskActivityType.Merged];

    /// <summary>Коды задач из записей об иерархии — по запросу на задачу; таких записей обычно единицы.</summary>
    private async Task LoadTaskRefsAsync(CancellationToken ct)
    {
        var ids = _activity
            .Where(a => HierarchyTypes.Contains(a.Type))
            .SelectMany(a => new[] { a.OldValue, a.NewValue })
            .Select(v => Guid.TryParse(v, out var g) ? g : (Guid?)null)
            .OfType<Guid>()
            .Where(g => !_taskRefs.ContainsKey(g))
            .Distinct()
            .ToList();
        if (ids.Count == 0)
            return;

        var loaded = await Task.WhenAll(ids.Select(async id => (id, result: await Api.GetTask(id, ct))));
        foreach (var (id, result) in loaded)
            _taskRefs[id] = result.Ok ? result.Value : null;
    }

    /// <summary>
    /// Изменение сделано на этой же странице (PATCH вернул новую задачу): дописываем записи локально, не перезагружая ленту.
    /// При следующей загрузке их заменят серверные.
    /// </summary>
    public void NoteLocalChange(TaskResponse before, TaskResponse after)
    {
        if (State.CurrentUserId is not { } me) return;
        var now = DateTime.UtcNow;

        if (before.Title != after.Title)
            _activity.Add(new TaskActivityResponse(Guid.NewGuid(), after.Id, me, TaskActivityType.TitleChanged, before.Title, after.Title, now));
        if ((before.Description ?? "") != (after.Description ?? ""))
            _activity.Add(new TaskActivityResponse(Guid.NewGuid(), after.Id, me, TaskActivityType.DescriptionChanged, null, null, now));
        if (before.StatusId != after.StatusId)
            _activity.Add(new TaskActivityResponse(Guid.NewGuid(), after.Id, me, TaskActivityType.StatusChanged, before.StatusId.ToString(), after.StatusId.ToString(), now));
        if (before.AssigneeId != after.AssigneeId)
            _activity.Add(new TaskActivityResponse(Guid.NewGuid(), after.Id, me, TaskActivityType.AssigneeChanged, before.AssigneeId?.ToString(), after.AssigneeId?.ToString(), now));
        if (before.ParentId != after.ParentId)
        {
            _activity.Add(new TaskActivityResponse(Guid.NewGuid(), after.Id, me, TaskActivityType.ParentChanged, before.ParentId?.ToString(), after.ParentId?.ToString(), now));
            _ = LoadTaskRefsThenRedrawAsync();
        }
        if (before.SprintId != after.SprintId)
        {
            _activity.Add(new TaskActivityResponse(Guid.NewGuid(), after.Id, me, TaskActivityType.SprintChanged, before.SprintId?.ToString(), after.SprintId?.ToString(), now));
            _sprintNames = null;
            _ = LoadNamesThenRedrawAsync();
        }
        // Пользовательские поля: запись на каждое поле, чьё значение стало другим (в той же форме, что пишет сервер).
        var oldFields = before.CustomFields ?? new Dictionary<Guid, System.Text.Json.JsonElement>();
        var newFields = after.CustomFields ?? new Dictionary<Guid, System.Text.Json.JsonElement>();
        foreach (var fieldId in oldFields.Keys.Union(newFields.Keys))
        {
            var was = oldFields.TryGetValue(fieldId, out var o) ? o.GetRawText() : null;
            var next = newFields.TryGetValue(fieldId, out var n) ? n.GetRawText() : null;
            if (was != next)
                _activity.Add(new TaskActivityResponse(Guid.NewGuid(), after.Id, me, TaskActivityType.CustomFieldChanged, was,
                    $"{{\"field\":\"{fieldId}\",\"value\":{next ?? "null"}}}", now));
        }
        if (before.MilestoneId != after.MilestoneId)
        {
            _activity.Add(new TaskActivityResponse(Guid.NewGuid(), after.Id, me, TaskActivityType.MilestoneChanged, before.MilestoneId?.ToString(), after.MilestoneId?.ToString(), now));
            _milestoneNames = null;
            _ = LoadNamesThenRedrawAsync();
        }
        if (before.TeamId != after.TeamId)
            _activity.Add(new TaskActivityResponse(Guid.NewGuid(), after.Id, me, TaskActivityType.TeamChanged, before.TeamId?.ToString(), after.TeamId?.ToString(), now));
        if (before.DueDate != after.DueDate)
            _activity.Add(new TaskActivityResponse(Guid.NewGuid(), after.Id, me, TaskActivityType.DueDateChanged,
                before.DueDate?.ToString("yyyy-MM-dd"), after.DueDate?.ToString("yyyy-MM-dd"), now));
        if (before.StartDate != after.StartDate)
            _activity.Add(new TaskActivityResponse(Guid.NewGuid(), after.Id, me, TaskActivityType.StartDateChanged,
                before.StartDate?.ToString("yyyy-MM-dd"), after.StartDate?.ToString("yyyy-MM-dd"), now));
        if (before.TypeId != after.TypeId)
            _activity.Add(new TaskActivityResponse(Guid.NewGuid(), after.Id, me, TaskActivityType.TypeChanged, before.TypeId.ToString(), after.TypeId.ToString(), now));
        if (before.Priority != after.Priority)
            _activity.Add(new TaskActivityResponse(Guid.NewGuid(), after.Id, me, TaskActivityType.PriorityChanged,
                ((int)before.Priority).ToString(CultureInfo.InvariantCulture), ((int)after.Priority).ToString(CultureInfo.InvariantCulture), now));
        if (before.StoryPoints != after.StoryPoints)
            _activity.Add(new TaskActivityResponse(Guid.NewGuid(), after.Id, me, TaskActivityType.StoryPointsChanged,
                before.StoryPoints?.ToString(CultureInfo.InvariantCulture), after.StoryPoints?.ToString(CultureInfo.InvariantCulture), now));
        if (before.EstimateMinutes != after.EstimateMinutes)
            _activity.Add(new TaskActivityResponse(Guid.NewGuid(), after.Id, me, TaskActivityType.EstimateChanged,
                before.EstimateMinutes?.ToString(CultureInfo.InvariantCulture), after.EstimateMinutes?.ToString(CultureInfo.InvariantCulture), now));

        StateHasChanged();
    }

    private IEnumerable<Item> Visible
    {
        get
        {
            var items = new List<Item>();
            if (_filter != Filter.History)
                items.AddRange(_comments.Select(c => new Item(c.CreatedAt, c, null)));

            if (_filter != Filter.Comments)
            {
                List<TaskActivityResponse>? group = null;
                foreach (var a in _activity.Where(a => a.Type != TaskActivityType.CommentAdded).OrderBy(a => a.CreatedAt))
                {
                    if (group is not null && group[0].ActorId == a.ActorId && a.CreatedAt - group[^1].CreatedAt <= GroupWindow)
                    {
                        group.Add(a);
                        continue;
                    }

                    group = [a];
                    items.Add(new Item(a.CreatedAt, null, group));
                }
            }

            return items.OrderBy(i => i.At);
        }
    }

    // ---- тексты журнала: без глагола в прошедшем времени (род актора неизвестен) ----

    private RenderFragment Render(TaskActivityResponse a) => a.Type switch
    {
        TaskActivityType.Created => Text(a.NewValue is { Length: > 0 } how ? $"задача создана {how}" : "задача создана"),
        TaskActivityType.TitleChanged => Titles(a),
        TaskActivityType.DescriptionChanged => Text("описание обновлено"),
        TaskActivityType.StatusChanged => Statuses(a),
        TaskActivityType.AssigneeChanged => Assignees(a),
        TaskActivityType.DueDateChanged => DueDates(a),
        TaskActivityType.CommentDeleted => Text("комментарий удалён"),
        TaskActivityType.AttachmentAdded => Text("добавлен файл"),
        TaskActivityType.AttachmentRemoved => Text("файл удалён"),
        TaskActivityType.StartDateChanged => StartDates(a),
        TaskActivityType.TypeChanged => Types(a),
        TaskActivityType.PriorityChanged => Priorities(a),
        TaskActivityType.StoryPointsChanged => Change("story points", a, v => Ru.Points(decimal.Parse(v, CultureInfo.InvariantCulture))),
        TaskActivityType.EstimateChanged => Change("оценка", a, v => Ru.Duration(int.Parse(v, CultureInfo.InvariantCulture))),
        TaskActivityType.ParentChanged => Parents(a),
        TaskActivityType.ChildAdded => @<span>подзадача: @TaskRef(a.NewValue)</span>,
        TaskActivityType.ChildRemoved => @<span>подзадача убрана: @TaskRef(a.OldValue)</span>,
        TaskActivityType.LinkAdded => @<span>связь «@LinkSide(a.OldValue)»: @TaskRef(a.NewValue)</span>,
        TaskActivityType.LinkRemoved => @<span>связь «@LinkSide(a.OldValue)» убрана: @TaskRef(a.NewValue)</span>,
        TaskActivityType.SprintChanged => Sprints(a),
        TaskActivityType.MilestoneChanged => Milestones(a),
        TaskActivityType.TeamChanged => Change("команда", a, v => Teams.Find(Guid.Parse(v))?.Name ?? "удалённая команда"),
        TaskActivityType.CustomFieldChanged => CustomField(a),
        TaskActivityType.Merged when a.NewValue == TaskItem.Id.ToString() => @<span>влита задача @TaskRef(a.OldValue)</span>,
        TaskActivityType.Merged => @<span>влита в @TaskRef(a.NewValue) как дубликат</span>,
        TaskActivityType.Split => SplitCodes(a.NewValue),
        TaskActivityType.Moved => @<span>перенос: <s class="tl-old">@a.OldValue</s> <span class="tl-arrow">→</span> <b>@a.NewValue</b></span>,
        TaskActivityType.ChecklistChanged => @<span>чек-лист: <s class="tl-old">@a.OldValue</s> <span class="tl-arrow">→</span> <b>@a.NewValue</b></span>,
        _ => Text(a.Type.ToString())
    };

    private static RenderFragment Text(string text) => @<span>@text</span>;

    /// <summary>Изменение пришло с хостинга (этап 5C): «по PR #42», «по коммиту a1b2c3d» — ссылкой, если она есть.</summary>
    private static RenderFragment SourceOf(TaskActivityResponse a) => a.Source is not { } source
        ? _ => { }
        : a.SourceUrl is { } url
            ? @<span class="tl-source"> · по <a href="@url" target="_blank" rel="noopener noreferrer">@GitMeta.SourceLabel(source)</a></span>
            : @<span class="tl-source"> · по @GitMeta.SourceLabel(source)</span>;

    /// <summary>Коды выделенных задач — ссылками /tasks/{код}: коды живут дольше Id в тексте журнала.</summary>
    private static RenderFragment SplitCodes(string? codes) => @<span>выделены задачи:
        @foreach (var taskCode in (codes ?? "").Split(", ", StringSplitOptions.RemoveEmptyEntries))
        {
            <a class="tl-code" href="@($"tasks/{taskCode}")">@taskCode</a>
        }
    </span>;

    /// <summary>OldValue связи — имя вида, у входящей стороны с «:in» (см. TaskActivity.LinkAdded в домене).</summary>
    private static string LinkSide(string? value)
    {
        var parts = (value ?? "").Split(':');
        return Enum.TryParse<TaskLinkType>(parts[0], out var type) ? TaskMeta.LinkLabel(type, parts.Length == 1) : value ?? "";
    }

    /// <summary>Правка на этой же странице (чек-лист) — запись без перезагрузки ленты; при следующей загрузке её заменит серверная.</summary>
    public void NoteActivity(TaskActivityType type, string? oldValue, string? newValue)
    {
        if (State.CurrentUserId is not { } me) return;
        _activity.Add(new TaskActivityResponse(Guid.NewGuid(), TaskItem.Id, me, type, oldValue, newValue, DateTime.UtcNow));
        if (HierarchyTypes.Contains(type))
            _ = LoadTaskRefsThenRedrawAsync();
        StateHasChanged();
    }

    private RenderFragment Parents(TaskActivityResponse a)
    {
        if (a.OldValue is null)
            return @<span>родитель: @TaskRef(a.NewValue)</span>;
        if (a.NewValue is null)
            return @<span>родитель снят (был @TaskRef(a.OldValue))</span>;
        return @<span>родитель: @TaskRef(a.OldValue) <span class="tl-arrow">→</span> @TaskRef(a.NewValue)</span>;
    }

    private RenderFragment TaskRef(string? id)
    {
        var task = Guid.TryParse(id, out var g) ? _taskRefs.GetValueOrDefault(g) : null;
        return task is null
            ? @<span class="tl-old">удалённая задача</span>
            : @<a class="tl-task" href="tasks/@task.Id" title="@task.Title"><span class="code">@task.Code</span> @task.Title</a>;
    }

    private static RenderFragment Titles(TaskActivityResponse a) =>
        @<span>название: <s class="tl-old">@a.OldValue</s> <span class="tl-arrow">→</span> <b>@a.NewValue</b></span>;

    private RenderFragment Statuses(TaskActivityResponse a) =>
        @<span>статус: @StatusPill(a.OldValue) <span class="tl-arrow">→</span> @StatusPill(a.NewValue)</span>;

    private RenderFragment StatusPill(string? id)
    {
        var st = Guid.TryParse(id, out var g) ? Board.Statuses.FirstOrDefault(s => s.Id == g) : null;
        return @<span class="status-pill sm"><span class="sd" style="background:@StatusColors.For(st?.Type)"></span>@(st?.Name ?? "удалённый статус")</span>;
    }

    private RenderFragment Assignees(TaskActivityResponse a)
    {
        if (a.OldValue is null && a.NewValue is not null)
            return @<span>назначен исполнитель: @UserChip(a.NewValue)</span>;
        if (a.NewValue is null && a.OldValue is not null)
            return @<span>исполнитель снят: @UserChip(a.OldValue)</span>;
        return @<span>исполнитель: @UserChip(a.OldValue) <span class="tl-arrow">→</span> @UserChip(a.NewValue)</span>;
    }

    private RenderFragment UserChip(string? id)
    {
        var user = Guid.TryParse(id, out var g) ? Users.Find(g) : null;
        return @<span class="tl-user"><Avatar User="user" Size="16" />@(user?.FullName ?? "—")</span>;
    }

    private static RenderFragment DueDates(TaskActivityResponse a)
    {
        var from = Ru.ParseDateOnly(a.OldValue);
        var to = Ru.ParseDateOnly(a.NewValue);
        if (from is null && to is { } set)
            return @<span>срок: <b>@Ru.DateOnlyShort(set)</b></span>;
        if (to is null && from is not null)
            return @<span>срок снят (был <s class="tl-old">@Ru.DateOnlyShort(from.Value)</s>)</span>;
        return @<span>срок: <s class="tl-old">@(from is { } f ? Ru.DateOnlyShort(f) : "—")</s> <span class="tl-arrow">→</span> <b>@(to is { } t ? Ru.DateOnlyShort(t) : "—")</b></span>;
    }

    private static RenderFragment StartDates(TaskActivityResponse a) =>
        Change("начало", a, v => Ru.ParseDateOnly(v) is { } d ? Ru.DateOnlyShort(d) : v);

    /// <summary>«поле: A → B», «поле: B» (было пусто), «поле снято (было A)» — общий вид для простых значений.</summary>
    private static RenderFragment Change(string field, TaskActivityResponse a, Func<string, string> format)
    {
        if (a.OldValue is null && a.NewValue is { } set)
            return @<span>@field: <b>@format(set)</b></span>;
        if (a.NewValue is null && a.OldValue is { } was)
            return @<span>@field снято (было <s class="tl-old">@format(was)</s>)</span>;
        return @<span>@field: <s class="tl-old">@(a.OldValue is { } o ? format(o) : "—")</s> <span class="tl-arrow">→</span> <b>@(a.NewValue is { } n ? format(n) : "—")</b></span>;
    }

    private RenderFragment Types(TaskActivityResponse a) =>
        @<span>тип: @TypePill(a.OldValue) <span class="tl-arrow">→</span> @TypePill(a.NewValue)</span>;

    private RenderFragment TypePill(string? id)
    {
        var type = Guid.TryParse(id, out var g) ? TaskMeta.TypeOf(Board, g) : null;
        if (type is null)
            return @<span class="status-pill sm">удалённый тип</span>;
        return @<span class="status-pill sm"><TaskTypeIcon Kind="type.Kind" Name="@type.Name" Size="12" />@type.Name</span>;
    }

    private static RenderFragment Priorities(TaskActivityResponse a) =>
        @<span>приоритет: @PriorityPill(a.OldValue) <span class="tl-arrow">→</span> @PriorityPill(a.NewValue)</span>;

    private static RenderFragment PriorityPill(string? value)
    {
        var priority = int.TryParse(value, out var n) && Enum.IsDefined((TaskPriority)n) ? (TaskPriority)n : TaskPriority.None;
        return @<span class="status-pill sm"><PriorityIcon Value="priority" Size="12" ShowNone="true" />@TaskMeta.PriorityLabel(priority)</span>;
    }

    // ---- комментарии ----

    private async Task Send()
    {
        if (_busy || string.IsNullOrWhiteSpace(_draft)) return;
        _busy = true;
        var result = await Api.AddComment(TaskItem.Id, new CreateTaskCommentRequest(_draft));
        _busy = false;
        if (!result.Ok)
        {
            Toasts.Error(result.Error ?? "Не удалось отправить комментарий");
            return;
        }

        _comments.Add(result.Value!);
        _draft = "";
        _highlightId = result.Value!.Id;
        if (_filter == Filter.History) _filter = Filter.All;
        await OnCommentCountChanged.InvokeAsync(_comments.Count);
    }

    private void StartEdit(TaskCommentResponse c)
    {
        _editingId = c.Id;
        _editText = c.Body;
    }

    private async Task SaveEdit()
    {
        if (_editingId is not { } id || _busy) return;
        _busy = true;
        var result = await Api.UpdateComment(id, new UpdateTaskCommentRequest(_editText));
        _busy = false;
        if (!result.Ok)
        {
            Toasts.Error(result.Error ?? "Не удалось сохранить комментарий");
            return;
        }

        var index = _comments.FindIndex(c => c.Id == id);
        if (index >= 0) _comments[index] = result.Value!;
        _editingId = null;
    }

    private async Task ConfirmDelete()
    {
        if (_deleting is not { } c) return;
        _deleting = null;
        var result = await Api.DeleteComment(c.Id);
        if (!result.Ok)
        {
            Toasts.Error(result.Error ?? "Не удалось удалить комментарий");
            return;
        }

        _comments.RemoveAll(x => x.Id == c.Id);
        if (State.CurrentUserId is { } me)
            _activity.Add(new TaskActivityResponse(Guid.NewGuid(), TaskItem.Id, me, TaskActivityType.CommentDeleted, c.Id.ToString(), null, DateTime.UtcNow));
        await OnCommentCountChanged.InvokeAsync(_comments.Count);
    }

    public void Dispose()
    {
        Users.Changed -= OnUsersChanged;
        _loadCts?.Cancel();
    }
}
