@* «Создать ветку» / «Создать PR» из блока «Разработка» (этап 5D): запись на хостинг от имени токена подключения,
   право WriteScm, только в привязанный к проекту репозиторий. Пустая исходная/целевая ветка — ветка по умолчанию
   репозитория; заголовок PR по умолчанию — «КОД Название», описание со ссылкой на задачу ставит сервер. Отказ хостинга
   (ветка уже есть, нет прав у токена) показывается под полями его же текстом. *@
@implements IAsyncDisposable
@inject IFlowApi Api
@inject ToastService Toasts
@inject BrowserInterop Browser

<MudDialog @ref="_dialog" Visible="@_visible" VisibleChanged="OnVisibleChanged" Options="_options" Class="flow-modal"
           TitleClass="flow-modal-title" ContentClass="flow-modal-content" ActionsClass="modal-actions">
    <TitleContent>
        <h3>@(PullRequest ? "Новый PR" : "Новая ветка") · @Task.Code</h3>
        <div class="hint">@(PullRequest ? "PR откроется на хостинге со ссылкой на задачу в описании" : "Ветка появится на хостинге и сразу в блоке «Разработка»")</div>
    </TitleContent>
    <DialogContent>
        <div class="scm-create">
            @if (Repositories.Count > 1)
            {
                <DsSelect T="Guid" Label="Репозиторий" Value="_repositoryId" ValueChanged="OnRepository" ToStringFunc="RepoName" Disabled="_busy">
                    @foreach (var r in Repositories)
                    {
                        <MudSelectItem T="Guid" Value="r.Id">@r.FullName</MudSelectItem>
                    }
                </DsSelect>
            }
            else
            {
                <div class="hint">Репозиторий: <span class="mono">@Repository?.FullName</span></div>
            }

            @if (PullRequest)
            {
                <DsInput Id="scm-source" Label="Из ветки" Value="@_branch" ValueChanged="v => _branch = v" MaxLength="200" Class="mono" OnKeyDown="OnKey" />
                <DsInput Label="В ветку" Placeholder="@Repository?.DefaultBranch" Value="@_target" ValueChanged="v => _target = v" MaxLength="200" OnKeyDown="OnKey" />
                <DsInput Label="Заголовок" Value="@_title" ValueChanged="v => _title = v" MaxLength="250" OnKeyDown="OnKey" />
                <DsCheckbox @bind-Value="_draft" Label="Черновик (draft)" Disabled="_busy" />
            }
            else
            {
                <DsInput Id="scm-branch" Label="Имя ветки" Value="@_branch" ValueChanged="v => _branch = v" MaxLength="200" Class="mono" OnKeyDown="OnKey" />
                <DsInput Label="От ветки" Placeholder="@Repository?.DefaultBranch" Value="@_target" ValueChanged="v => _target = v" MaxLength="200" OnKeyDown="OnKey" />
            }
            @if (_error is not null)
            {
                <div class="ds-field-error">@_error</div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <DsButton Variant="secondary" Size="md" OnClick="Close" Disabled="_busy">Отмена</DsButton>
        <DsButton Variant="primary" Size="md" OnClick="Save" Disabled="@(_busy || _branch.Trim().Length == 0)" Busy="_busy">Создать</DsButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public TaskResponse Task { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<ScmTaskRepositoryResponse> Repositories { get; set; } = [];
    /// <summary>Ветки задачи, уже известные Flow: из них PR предлагает исходную.</summary>
    [Parameter] public IReadOnlyList<ScmLinkResponse> Branches { get; set; } = [];
    [Parameter] public bool PullRequest { get; set; }
    [Parameter] public EventCallback<TaskDevelopmentResponse> OnDone { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private MudDialog? _dialog;
    private bool _visible = true;
    private bool _closing;
    private bool _busy;
    private Guid _repositoryId;
    private string _branch = "";
    private string _target = "";
    private string _title = "";
    private bool _draft;
    private string? _error;

    private readonly DialogOptions _options = new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = false, CloseOnEscapeKey = true, BackdropClick = true };

    private ScmTaskRepositoryResponse? Repository => Repositories.FirstOrDefault(r => r.Id == _repositoryId);

    protected override void OnInitialized()
    {
        // Для PR — репозиторий, где у задачи уже есть открытая ветка: PR почти всегда из неё.
        var open = Branches.FirstOrDefault(b => b.State != GitDevelopmentLinkState.Closed && Repositories.Any(r => r.Id == b.RepositoryId));
        _repositoryId = PullRequest && open is not null ? open.RepositoryId : Repositories.FirstOrDefault()?.Id ?? Guid.Empty;
        _title = $"{Task.Code} {Task.Title}";
        _branch = DefaultBranch();
    }

    private string DefaultBranch() =>
        PullRequest && Branches.FirstOrDefault(b => b.RepositoryId == _repositoryId && b.State != GitDevelopmentLinkState.Closed) is { } branch
            ? branch.ExternalId
            : Ru.BranchName(Task.Code, Task.Title);

    private void OnRepository(Guid id)
    {
        _repositoryId = id;
        if (PullRequest)
            _branch = DefaultBranch();
    }

    private string RepoName(Guid id) => Repositories.FirstOrDefault(r => r.Id == id)?.FullName ?? "";

    protected override async System.Threading.Tasks.Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        await System.Threading.Tasks.Task.Delay(50);
        await Browser.FocusAsync(PullRequest ? "scm-source" : "scm-branch", select: true);
    }

    private async System.Threading.Tasks.Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _branch.Trim().Length > 0)
            await Save();
    }

    private async System.Threading.Tasks.Task Save()
    {
        if (_busy)
            return;
        _busy = true;
        _error = null;
        var target = _target.Trim().Length == 0 ? null : _target.Trim();
        var result = PullRequest
            ? await Api.CreateScmPullRequest(Task.Id, new CreateScmPullRequestRequest(_repositoryId, _branch.Trim(), target, _title.Trim(), _draft))
            : await Api.CreateScmBranch(Task.Id, new CreateScmBranchRequest(_repositoryId, _branch.Trim(), target));
        _busy = false;
        if (!result.Ok)
        {
            _error = result.Error ?? "Хостинг не принял запрос";
            return;
        }

        Toasts.Ok(PullRequest ? "PR создан" : "Ветка создана");
        await OnDone.InvokeAsync(result.Value!);
        await Close();
    }

    private System.Threading.Tasks.Task OnVisibleChanged(bool visible) => visible || _closing ? System.Threading.Tasks.Task.CompletedTask : Close();

    private async System.Threading.Tasks.Task CloseDialog()
    {
        if (_closing) return;
        _closing = true;
        _visible = false;
        if (_dialog is not null)
            await _dialog.CloseAsync();
    }

    public ValueTask DisposeAsync() => new(CloseDialog());

    private async System.Threading.Tasks.Task Close()
    {
        if (_busy) return;
        await CloseDialog();
        await OnClose.InvokeAsync();
    }
}
