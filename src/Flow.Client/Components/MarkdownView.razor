@* Рендер Markdown (Markdig, общий пайплайн FlowMarkdown: сырой HTML отключён, @username → ссылка на профиль).
   Пустой текст → плейсхолдер.

   Ссылки вида attachment:{id} (docs/TZ_attachments.md) превращаются в готовые /files/{id} прямо при
   рендере — см. AttachmentLinks. Дорисовки после рендера больше нет: ни интеропа, ни blob-адресов,
   ни ссылки на компонент. Это важно именно здесь — MarkdownView стоит на каждом комментарии ленты. *@
@using Flow.Client.Markdown

<div class="desc-box @(IsEmpty ? "ph" : "") @Class" style="@Style" id="@_id" @onclick="OnClick">
    @if (IsEmpty)
    {
        @Placeholder
    }
    else
    {
        @Html
    }
</div>

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Добавить описание…";
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private readonly string _id = "md-view-" + Guid.NewGuid().ToString("N")[..8];

    private string _html = string.Empty;

    private bool IsEmpty => string.IsNullOrWhiteSpace(Text);

    private MarkupString Html => new(_html);

    protected override void OnParametersSet() => _html = FlowMarkdown.ToHtml(Text);
}
