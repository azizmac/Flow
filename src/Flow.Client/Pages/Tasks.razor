    private async Task OnTaskRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CommitTaskRename();
        }
        else if (e.Key == "Escape")
        {
            _renameTaskCancelled = true;
            _renamingId = null;
        }
    }

    private async Task CommitTaskRename()
    {
        if (_renamingId is not { } id || _renameTaskCancelled)
            return;

        var task = _tasks.FirstOrDefault(t => t.Id == id);
        _renamingId = null;

        var title = _renameTaskValue.Trim();
        if (task is null || title.Length == 0 || title == task.Title)
            return;

        await RenameTask((task, title));
    }

