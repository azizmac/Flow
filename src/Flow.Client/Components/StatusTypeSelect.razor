@* Вид статуса «в строке» — PillSelect с точкой. null — «Без вида»: статус проекта, который не попадает ни в одну
   группу фильтра по видам. *@

<PillSelect T="StatusType?" Items="StatusColors.TypeOptions" Value="Value" OnChange="OnChange" Disabled="Disabled"
            Label="@(t => StatusColors.TypeLabel(t))" AriaLabel="Сменить вид статуса"
            Title="Вид статуса: по нему фильтруют задачи во всех проектах">
    <Glyph Context="t"><span class="sd" style="background:@StatusColors.For(t)"></span></Glyph>
</PillSelect>

@code {
    [Parameter] public StatusType? Value { get; set; }
    [Parameter] public EventCallback<StatusType?> OnChange { get; set; }
    [Parameter] public bool Disabled { get; set; }
}
