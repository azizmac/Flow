@* Флажок Flow (docs/TZ_ui_consistency.md): MudCheckBox в одном размере и цвете на всех экранах — маленький,
   акцентный, без Material-отступов, подпись текстом интерфейса. Раньше каждый экран задавал Size/Color/Dense сам,
   и там, где забыл, флажок выходил крупным и другого цвета. *@

<MudCheckBox T="bool" Value="Value" ValueChanged="ValueChanged" Label="@Label" Disabled="Disabled"
             Size="Size.Small" Color="Color.Primary" Dense="true" Class="@($"ds-check {Class}")"
             aria-label="@(AriaLabel ?? Label)" />

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    /// <summary>Для флажка без видимой подписи (ячейка таблицы).</summary>
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
}
