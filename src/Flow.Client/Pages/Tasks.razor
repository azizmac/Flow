    /// <summary>
    /// Кнопка «FQL»: при пустой строке и включённой панели — «Показать как FQL»: фильтры панели переезжают в строку
    /// (проект остаётся в селекторе), дальше их можно править текстом. Иначе просто открывает строку.
    /// </summary>
    private async Task OpenFql()
    {
        if (FqlVisible && string.IsNullOrWhiteSpace(EffectiveFql))
        {
            _fqlOpen = false;
            return;
        }

        _fqlOpen = true;
        if (string.IsNullOrWhiteSpace(EffectiveFql) && HasPanelFilters)
        {
            var fql = PanelAsFql();
            _search = "";
            Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                ["status"] = null,
                ["type"] = null,
                ["who"] = null,
                ["fql"] = fql
            }), replace: true);
        }

        await Task.Delay(50);
        await Browser.FocusAsync(FqlBar.InputId);
    }

    /// <summary>Панель фильтров строкой FQL — то же условие, что сервер строит из query-параметров.</summary>
    private string PanelAsFql()
    {
        var parts = new List<string>();
        if (StatusId is { } statusId && CurrentBoard?.Statuses.FirstOrDefault(s => s.Id == statusId) is { } status)
            parts.Add($"status = {FqlValue(status.Name)}");
        if (BoardId is null && TypeFilter is { } type)
            parts.Add($"statusCategory = {char.ToLowerInvariant(type.ToString()[0])}{type.ToString()[1..]}");
        if (Who == "none")
            parts.Add("assignee IS EMPTY");
        else if (AssigneeFilterId is { } who)
            parts.Add(who == State.CurrentUserId ? "assignee = me()" : $"assignee = @{Users.Find(who)?.Username ?? who.ToString()}");
        if (_search.Trim().Length > 0)
            parts.Add($"text ~ {FqlValue(_search.Trim())}");
        return string.Join(" AND ", parts);
    }

    private static string FqlValue(string value) =>
        value.All(c => char.IsLetterOrDigit(c) || c is '_' or '-' or '.') ? value : $"\"{value.Replace("\"", "\\\"")}\"";

    /// <summary>Применить строку: запрос уходит в адрес. Совпал с открытым сохранённым фильтром — адрес без ?fql=.</summary>
    private void ApplyFql(string text)
    {
        var fql = string.IsNullOrWhiteSpace(text) || text == CurrentFilter?.Query ? null : text;
        _page = 0;
        if (fql == Fql && _grid is not null)
        {
            _ = Reload();
            return;
        }

        Nav.NavigateTo(Nav.GetUriWithQueryParameter("fql", fql), replace: true);
    }

