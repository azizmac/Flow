# Скопировать в .env (в git не попадает) и поправить под машину. Всё необязательно — у каждой переменной
# есть default в compose. Файл читают оба стека: и docker-compose.yml, и docker-compose.data.yml.

# ---- Стек данных (docker-compose.data.yml) ----
# Дефолты указывают на стек данных, поднятый на этой же машине.

# Хост и порт БД, по которым ходит приложение. Для внешней (managed) БД — её адрес; стек данных
# в этом случае можно вообще не поднимать.
POSTGRES_HOST=postgres
POSTGRES_INTERNAL_PORT=5432

# Порт БД наружу и интерфейс публикации. По умолчанию порт виден только с самой машины —
# приложение ходит по сети Docker, наружу он нужен для psql. 0.0.0.0 открывает базу всем.
# На машине с локальным Postgres на 5432 — поставить 5433.
POSTGRES_PORT=5432
POSTGRES_BIND=127.0.0.1

POSTGRES_DB=flow
AUTH_DB=flow_auth
POSTGRES_USER=flow
# Сменить на любой машине, кроме локальной разработки.
POSTGRES_PASSWORD=flow

# S3. Для внешнего хранилища — его URL, стек данных тогда не нужен.
S3_ENDPOINT=http://s3:9000
S3_USE_SSL=false
S3_BUCKET=flow
MINIO_ROOT_USER=flow
MINIO_ROOT_PASSWORD=flow12345
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BIND=127.0.0.1

# --- Умный поиск -------------------------------------------------------------------------------
# Три выключателя, от самого грубого к частному:
#   SEARCH_ENABLED=false      — поиска нет вовсе: ни эндпоинтов, ни индексации (задачи ищутся
#                               обычным списком на доске, как до появления поиска).
#   EMBEDDINGS_ENABLED=false  — поиск есть, нейросетей нет: выдача строится только по словам,
#                               индексация продолжает работать и пишет чанки без векторов.
#                               Вместе с ним гаснут визуальная половина и реранкер, а сайдкары
#                               профиля ai можно не поднимать вовсе — GPU не нужен.
#   VISION_ENABLED / RERANK_ENABLED — отдельные ступени, каждая со своей моделью.
# Векторы, не посчитанные с выключёнными эмбеддингами, дозаполняются сами: на старте Flow.Api
# ставит такие источники в очередь. Вручную то же делает POST /search/reindex (Owner).
# SEARCH_ENABLED и SEARCH_INDEXING_ENABLED — ниже, в блоке приложения.
EMBEDDINGS_ENABLED=true

# Эмбеддер поиска (профиль ai стека данных). Модель и её веса: файл кладут в том flow-models-data.
# Если модель крутится на другой машине (GPU), профиль ai не поднимают, а эндпоинты указывают на неё.
EMBEDDINGS_MODEL=Qwen3-Embedding-0.6B
EMBEDDINGS_MODEL_FILE=Qwen3-Embedding-0.6B-Q8_0.gguf
EMBEDDINGS_PORT=8081
EMBEDDINGS_BIND=127.0.0.1
# Адреса, по которым Flow.Api ходит за векторами. Индексация может смотреть на другой хост (CPU),
# запросы — на быстрый (GPU); пусто у индексации означает «тот же, что для запросов».
EMBEDDINGS_QUERY_ENDPOINT=http://embeddings:8081/v1
EMBEDDINGS_INDEXING_ENDPOINT=

# Вторая ступень выдачи (реранкер) и визуальный поиск по картинкам. Обе требуют GPU и поднимаются
# тем же профилем ai. Выключены по умолчанию: без сервисов Flow.Api просто не зовёт их.
# Держать значения здесь, а не префиксом команды: префикс живёт один запуск, а `docker compose up -d`
# пересоздаёт контейнер api — и флаг возвращается к false.
RERANK_ENABLED=false
RERANKER_MODEL=bge-reranker-v2-m3
RERANKER_MODEL_FILE=bge-reranker-v2-m3-Q8_0.gguf
RERANKER_PORT=8082
RERANKER_BIND=127.0.0.1

VISION_ENABLED=false
VISION_MODEL=Qwen3-VL-Embedding-2B
VISION_MODEL_REPO=Qwen/Qwen3-VL-Embedding-2B
VISION_PORT=8083
VISION_BIND=127.0.0.1

# Где лежат веса моделей. Пусто — обычный том Docker (или каталог DATA_ROOT/models, если он задан).
MODELS_ROOT=

# Где лежат данные. Пусто — обычные тома Docker; путь — тома создаются на этом каталоге
# (читается только скриптом docker/data/init-env.sh при создании томов).
DATA_ROOT=

# Бэкапы. Профиль backup в стеке данных; без него — разовый запуск docker/data/backup.sh.
BACKUP_DIR=./backups
BACKUP_CRON=0 3 * * *
BACKUP_KEEP=7

# ---- Стек приложения (docker-compose.yml) ----

# Порты сервисов наружу — их видит браузер.
AUTH_PORT=5100
API_PORT=8080
CLIENT_PORT=5016

# Базовый пользователь при первом запуске.
BOOTSTRAP_EMAIL=admin@flow.com
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=admin

# Поиск. Включён по умолчанию: с моделью — гибрид, без модели (или при EMBEDDINGS_ENABLED=false,
# см. блок «Умный поиск» выше) — только полнотекстовая половина. Первое наполнение индекса —
# POST /search/reindex. false отключает и поиск, и фоновую индексацию.
SEARCH_ENABLED=true
SEARCH_INDEXING_ENABLED=true

# Секрет клиента flow-api (Flow.Api → admin-API Flow.Auth) и пароль PFX-сертификатов Flow.Auth.
AUTH_API_CLIENT_SECRET=dev-only-change-me
AUTH_CERT_PASSWORD=flow-certs
