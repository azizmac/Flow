@* Модалка «Новый человек»: имя, фамилия, username (подсказка транслитом, ^[a-z0-9][a-z0-9._-]{0,30}[a-z0-9]$), email.
   409 → ошибка под занятым полем (сервер говорит, что именно занято). Enter — создать, Esc — закрыть. *@
@implements IDisposable
@inject FlowApi Api
@inject HotkeyService Hotkeys
@inject BrowserInterop Browser

<div class="modal-scrim @(_in ? "in" : "")" @onclick="Cancel">
    <div class="modal" role="dialog" aria-modal="true" @onclick:stopPropagation>
        <div>
            <h3>Новый человек</h3>
            <div class="hint">Профиль, а не учётная запись: пароля и входа пока нет. Должность, телефон и ссылки — потом, в профиле.</div>
        </div>

        <div class="form-2col">
            <DsInput Id="cu-first" Label="Имя" Placeholder="Илья" MaxLength="100"
                     Value="@_first" ValueChanged="OnFirstChanged" Error="@_firstError" OnKeyDown="OnFieldKey" />
            <DsInput Id="cu-last" Label="Фамилия" Placeholder="Моторин" MaxLength="100"
                     Value="@_last" ValueChanged="OnLastChanged" Error="@_lastError" OnKeyDown="OnFieldKey" />
        </div>

        <div>
            <DsInput Id="cu-username" Label="Username" Icon="at" Placeholder="ilya.motorin" MaxLength="32"
                     Value="@_username" ValueChanged="OnUsernameChanged" Error="@_usernameError" OnKeyDown="OnFieldKey" />
            <div class="hint" style="margin-top:8px;">Для упоминаний <code>@@@UsernamePreview</code> и адреса профиля. @Ru.UsernameRule.</div>
        </div>

        <DsInput Id="cu-email" Label="Почта" Icon="mail" Type="email" Placeholder="ilya@company.ru" MaxLength="254"
                 Value="@_email" ValueChanged="OnEmailChanged" Error="@_emailError" OnKeyDown="OnFieldKey" />

        @if (_serverError is not null)
        {
            <div class="ds-field-error">@_serverError</div>
        }

        <div class="modal-actions">
            <DsButton Variant="secondary" Size="md" OnClick="Cancel" Disabled="_busy">Отмена</DsButton>
            <DsButton Variant="primary" Size="md" OnClick="Submit" Disabled="!IsValid" Busy="_busy">Добавить</DsButton>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<UserResponse> OnCreated { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool _in;
    private bool _busy;
    private string _first = "";
    private string _last = "";
    private string _username = "";
    private string _email = "";
    private bool _usernameTouched;
    private string? _firstError;
    private string? _lastError;
    private string? _usernameError;
    private string? _emailError;
    private string? _serverError;
    private IDisposable? _hotkeys;

    private string UsernamePreview => _username.Length == 0 ? "username" : _username;

    private bool IsValid => _first.Trim().Length > 0 && _last.Trim().Length > 0
                            && Ru.UsernamePattern().IsMatch(_username) && EmailLooksValid(_email) && !_busy;

    private static bool EmailLooksValid(string email)
    {
        var e = email.Trim();
        var at = e.IndexOf('@');
        return at > 0 && at < e.Length - 1 && e.Length <= 254 && !e.Contains(' ');
    }

    protected override void OnInitialized()
    {
        _hotkeys = Hotkeys.Subscribe(async e =>
        {
            if (e.Key == "Escape") { e.Handled = true; await Cancel(); }
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _in = true;
            StateHasChanged();
            await Browser.FocusAsync("cu-first");
        }
    }

    private void OnFirstChanged(string v) { _first = v; _firstError = null; _serverError = null; Suggest(); }
    private void OnLastChanged(string v) { _last = v; _lastError = null; _serverError = null; Suggest(); }

    private void Suggest()
    {
        if (_usernameTouched) return;
        _username = Ru.SuggestUsername(_first, _last);
        _usernameError = null;
    }

    private void OnUsernameChanged(string v)
    {
        _username = v.Trim().ToLowerInvariant();
        _usernameTouched = _username.Length > 0;
        _serverError = null;
        _usernameError = _username.Length > 0 && !Ru.UsernamePattern().IsMatch(_username) ? Ru.UsernameRule : null;
    }

    private void OnEmailChanged(string v)
    {
        _email = v;
        _serverError = null;
        _emailError = _email.Trim().Length > 0 && !EmailLooksValid(_email) ? "Похоже на неверный адрес" : null;
    }

    private async Task OnFieldKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit();
    }

    private Task Cancel() => _busy ? Task.CompletedTask : OnCancel.InvokeAsync();

    private async Task Submit()
    {
        if (_first.Trim().Length == 0) { _firstError = "Введите имя"; return; }
        if (_last.Trim().Length == 0) { _lastError = "Введите фамилию"; return; }
        if (!Ru.UsernamePattern().IsMatch(_username)) { _usernameError = Ru.UsernameRule; return; }
        if (!EmailLooksValid(_email)) { _emailError = "Введите почту"; return; }
        if (!IsValid) return;

        _busy = true;
        _serverError = null;
        var result = await Api.CreateUser(new CreateUserRequest(_username, _email.Trim(), _first.Trim(), _last.Trim()));
        _busy = false;

        if (result.Ok)
        {
            await OnCreated.InvokeAsync(result.Value!);
            return;
        }

        if (result.Conflict)
        {
            // Сервер: «Username 'x' уже занят» / «Email 'x' уже занят» — кладём под нужное поле.
            var msg = result.Error ?? "Уже занято";
            if (msg.Contains("mail", StringComparison.OrdinalIgnoreCase) || msg.Contains("почт", StringComparison.OrdinalIgnoreCase))
                _emailError = "Почта уже занята";
            else
                _usernameError = "Username уже занят";
        }
        else
        {
            _serverError = result.Error;
        }
    }

    public void Dispose() => _hotkeys?.Dispose();
}
