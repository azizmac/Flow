          <mxGeometry x="30" y="235" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="app" value="Flow.Application / Features/Ai" style="swimlane;startSize=28;html=1;fillColor=#d5e8d4;strokeColor=#82b366;pointerEvents=0;" vertex="1" parent="1">
