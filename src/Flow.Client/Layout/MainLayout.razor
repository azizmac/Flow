@* Sidebar — только для аутентифицированных: AuthorizeRouteView рисует Authorizing/NotAuthorized внутри этого же layout,
   и без сессии сайдбар не должен ни показываться, ни ходить в API. *@
@inherits LayoutComponentBase
@inject HotkeyService Hotkeys

<div class="flow-app">
    <AuthorizeView>
        <Authorized>
            <Sidebar />
        </Authorized>
    </AuthorizeView>
    <div class="main">
        @Body
    </div>
    <Toast />
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Hotkeys.EnsureRegisteredAsync();
    }
}
