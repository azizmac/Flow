{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Startup": {
    "DatabaseWaitTimeoutSeconds": 60
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=flow_auth;Username=flow;Password=flow"
  },
  "Cors": {
    "Origins": [
      "http://localhost:5016",
      "https://localhost:7062"
    ]
  },
  "Auth": {
    "Issuer": "http://localhost:5100",
    "Client": {
      "ClientId": "flow-client",
      "RedirectUris": [
        "http://localhost:5016/authentication/login-callback",
        "https://localhost:7062/authentication/login-callback"
      ],
      "PostLogoutRedirectUris": [
        "http://localhost:5016/authentication/logout-callback",
        "https://localhost:7062/authentication/logout-callback"
      ]
    },
    "ApiClient": {
      "ClientId": "flow-api",
      "Secret": "dev-only-change-me"
    },
    "BCrypt": {
      "WorkFactor": 12
    },
    "AccessTokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 14,
    "AllowInsecureHttp": false,
    "UseEphemeralKeys": false,
    "SigningCertificate": { "Path": null, "Password": null },
    "EncryptionCertificate": { "Path": null, "Password": null }
  },
  "Bootstrap": {
    "Enabled": true,
    "Id": "11111111-1111-1111-1111-111111111111",
    "Username": "admin",
    "Email": "admin@flow.com",
    "Password": "admin"
  }
}
