@* Поле «Спринт» задачи (docs/TZ_task_views.md §2) — пилюля PillSelect: «Бэклог» (null) и незавершённые спринты проекта.
   Завершённый спринт в список не попадает — туда задачу не переносят; если задача уже в нём, он виден выключенным
   пунктом с причиной, чтобы пилюля не показывала пустоту. *@
@inject IFlowApi Api

@if (CanEdit)
{
    <PillSelect T="Guid?" Items="Options" Value="Value" OnChange="OnChange" Disabled="Disabled" Empty="@(id => id is null)"
                Label="LabelFor" DisabledReason="@(id => Find(id)?.State == SprintState.Completed ? "спринт завершён — сюда задачу не переносят" : null)"
                AriaLabel="Сменить спринт" />
}
else
{
    <span class="meta-v @(Value is null ? "muted" : "")">@LabelFor(Value)</span>
}

@code {
    [Parameter, EditorRequired] public Guid BoardId { get; set; }
    [Parameter] public Guid? Value { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<Guid?> OnChange { get; set; }

    private IReadOnlyList<SprintResponse> _sprints = [];
    private Guid _loadedFor;

    private IEnumerable<Guid?> Options =>
        new Guid?[] { null }.Concat(_sprints.Where(s => s.State != SprintState.Completed || s.Id == Value).Select(s => (Guid?)s.Id));

    private SprintResponse? Find(Guid? id) => _sprints.FirstOrDefault(s => s.Id == id);

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == BoardId)
            return;

        _loadedFor = BoardId;
        var result = await Api.GetSprints(BoardId);
        _sprints = result.Ok ? result.Value! : [];
    }

    private string LabelFor(Guid? id) => Find(id) switch
    {
        null => "Бэклог",
        { State: SprintState.Active } s => $"{s.Name} · идёт",
        { State: SprintState.Completed } s => $"{s.Name} · завершён",
        var s => s.Name
    };
}
