@* Блок «Разработка» (docs/TZ_git_integration.md §7): ветки, PR (номер, заголовок, состояние чипом, автор, целевая
   ветка) и последние коммиты задачи из привязанных репозиториев. Заголовки и сообщения — недоверенный текст с
   хостинга: выводятся как текст, без Markdown. Ссылки открываются на хостинге в новой вкладке. «Ветка» копирует
   git checkout -b КОД-название — без обращения к API. Проект без репозиториев — блока нет. Пометка под PR или коммитом —
   чего Flow не сделал по нему и почему (автопереход запрещён workflow, смарт-коммит без прав; этап 5C). С правом
   WriteGit (этап 5D) — «Создать ветку» и «Создать PR» прямо на хостинге (GitCreateDialog). *@
@inject IFlowApi Api
@inject BrowserInterop Browser
@inject ToastService Toasts
@inject UserDirectory Users

@if (_data is { HasRepositories: true } d)
{
    <div class="dev-block">
        <div class="subtasks-head">
            <div class="meta-k">Разработка</div>
            <button type="button" class="icon-lnk" title="@Checkout" @onclick="CopyBranch"><Icon Name="copy" Size="13" />Ветка</button>
            @if (d.CanWrite && d.Repositories is { Count: > 0 })
            {
                <button type="button" class="icon-lnk" title="Создать ветку на хостинге" @onclick="() => _create = false"><Icon Name="plus" Size="13" />Создать ветку</button>
                <button type="button" class="icon-lnk" title="Открыть PR на хостинге" @onclick="() => _create = true"><Icon Name="plus" Size="13" />Создать PR</button>
            }
        </div>
        @if (d.PullRequests.Count == 0 && d.Branches.Count == 0 && d.CommitCount == 0)
        {
            <div class="hint">Пока пусто: упомяните @Task.Code в имени ветки, коммите или PR.</div>
        }
        @foreach (var pr in d.PullRequests)
        {
            <a class="dev-row" href="@pr.Url" target="_blank" rel="noopener noreferrer">
                <span class="dev-kind">PR #@pr.ExternalId</span>
                <span class="dev-title">@pr.Title</span>
                <span class="dev-state @GitMeta.StateClass(pr.State)">@GitMeta.StateLabel(pr.State)</span>
                <span class="hint">@Who(pr)@(pr.TargetBranch is { } target ? $" → {target}" : "")</span>
            </a>
            @if (pr.Note is { } note)
            {
                <div class="dev-note">@note</div>
            }
        }
        @foreach (var branch in d.Branches)
        {
            <a class="dev-row" href="@branch.Url" target="_blank" rel="noopener noreferrer">
                <span class="dev-kind">ветка</span>
                <span class="dev-title mono @(branch.State == GitDevelopmentLinkState.Closed ? "gone" : "")">@branch.ExternalId</span>
                <span class="hint">@branch.RepositoryName</span>
            </a>
        }
        @foreach (var commit in d.Commits)
        {
            <a class="dev-row" href="@commit.Url" target="_blank" rel="noopener noreferrer">
                <span class="dev-kind mono">@commit.ExternalId[..Math.Min(7, commit.ExternalId.Length)]</span>
                <span class="dev-title">@commit.Title</span>
                <span class="hint">@Who(commit) · @Ru.DateShort(commit.OccurredAt)</span>
            </a>
            @if (commit.Note is { } note)
            {
                <div class="dev-note">@note</div>
            }
        }
        @if (d.CommitCount > d.Commits.Count)
        {
            <div class="hint">и ещё @Ru.Plural(d.CommitCount - d.Commits.Count, "коммит", "коммита", "коммитов")</div>
        }
    </div>
}

@if (_create is { } asPr && _data is { Repositories: { Count: > 0 } repos } data)
{
    <GitCreateDialog Task="Task" Repositories="repos" Branches="data.Branches" PullRequest="asPr" OnDone="d => _data = d" OnClose="() => _create = null" />
}

@code {
    [Parameter, EditorRequired] public TaskResponse Task { get; set; } = default!;

    private TaskDevelopmentResponse? _data;
    private Guid _loadedFor;
    private bool? _create;

    private string Checkout => $"git checkout -b {Ru.BranchName(Task.Code, Task.Title)}";

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == Task.Id)
            return;
        _loadedFor = Task.Id;
        var result = await Api.GetTaskDevelopment(Task.Id);
        _data = result.Ok ? result.Value : null;
    }

    /// <summary>Сопоставленный человек Flow — его имя, иначе логин хостинга.</summary>
    private string Who(GitDevelopmentLinkResponse link) =>
        Users.Find(link.AuthorUserId) is { } user ? $"{user.FirstName} {user.LastName}".Trim() : link.AuthorLogin ?? "";

    private async Task CopyBranch()
    {
        if (await Browser.CopyAsync(Checkout))
            Toasts.Ok("Команда скопирована");
        else
            Toasts.Error("Не удалось скопировать");
    }
}
