@* «Сохранить задачу как шаблон» (этап 3G): название, тип, приоритет, описание, значения полей, чек-лист и прямые
   подзадачи задачи становятся шаблоном проекта. Спрашиваем только имя шаблона. *@
@implements IAsyncDisposable
@inject IFlowApi Api
@inject ToastService Toasts
@inject BrowserInterop Browser

<MudDialog @ref="_dialog" Visible="@_visible" VisibleChanged="OnVisibleChanged" Options="_options" Class="flow-modal"
           TitleClass="flow-modal-title" ContentClass="flow-modal-content" ActionsClass="modal-actions">
    <TitleContent>
        <h3>Шаблон из @Task.Code</h3>
        <div class="hint">Тип, приоритет, описание, поля, чек-лист и подзадачи — новая задача по шаблону получит их такими же</div>
    </TitleContent>
    <DialogContent>
        <DsInput Id="stt-name" Label="Название шаблона" MaxLength="80" Value="@_name" ValueChanged="v => _name = v" OnKeyDown="OnKey" />
        @if (_error is not null)
        {
            <div class="ds-field-error">@_error</div>
        }
    </DialogContent>
    <DialogActions>
        <DsButton Variant="secondary" Size="md" OnClick="Close" Disabled="_busy">Отмена</DsButton>
        <DsButton Variant="primary" Size="md" OnClick="Save" Disabled="@(_busy || _name.Trim().Length == 0)" Busy="_busy">Сохранить</DsButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public TaskResponse Task { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    private MudDialog? _dialog;
    private bool _visible = true;
    private bool _closing;
    private bool _busy;
    private string _name = "";
    private string? _error;

    private readonly DialogOptions _options = new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = false, CloseOnEscapeKey = true, BackdropClick = true };

    protected override void OnInitialized() => _name = Task.Title.Length > 80 ? Task.Title[..80] : Task.Title;

    protected override async System.Threading.Tasks.Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        await System.Threading.Tasks.Task.Delay(50);
        await Browser.FocusAsync("stt-name", select: true);
    }

    private async System.Threading.Tasks.Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _name.Trim().Length > 0)
            await Save();
    }

    private async System.Threading.Tasks.Task Save()
    {
        _busy = true;
        _error = null;
        var result = await Api.SaveTaskAsTemplate(Task.Id, _name.Trim());
        _busy = false;
        if (!result.Ok)
        {
            _error = result.Error ?? "Не удалось сохранить шаблон";
            return;
        }

        Toasts.Ok($"Шаблон «{result.Value!.Name}» сохранён");
        await Close();
    }

    private System.Threading.Tasks.Task OnVisibleChanged(bool visible) => visible || _closing ? System.Threading.Tasks.Task.CompletedTask : Close();

    private async System.Threading.Tasks.Task CloseDialog()
    {
        if (_closing) return;
        _closing = true;
        _visible = false;
        if (_dialog is not null)
            await _dialog.CloseAsync();
    }

    public ValueTask DisposeAsync() => new(CloseDialog());

    private async System.Threading.Tasks.Task Close()
    {
        if (_busy) return;
        await CloseDialog();
        await OnClose.InvokeAsync();
    }
}
