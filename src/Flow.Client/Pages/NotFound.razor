@page "/not-found"
@layout MainLayout

<PageTitle>Страница не найдена — Flow</PageTitle>

<div style="flex:1;display:flex;align-items:center;justify-content:center;">
    <div style="max-width:420px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:14px;">
        <div style="font:900 56px Inter,sans-serif;color:var(--accent);">404</div>
        <h2 style="font:800 22px Inter,sans-serif;margin:0;color:#fff;">Страница не найдена</h2>
        <p style="font:500 13.5px/1.6 Inter,sans-serif;color:var(--text-secondary);margin:0;">
            Похоже, такой страницы не существует или она была перемещена.
        </p>
        <FlowButton Variant="primary" Size="md" OnClick="@(() => Nav.NavigateTo("/"))">На главную</FlowButton>
    </div>
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
}
