@* Экран «Задачи» (GET /tasks): список задач или канбан (?view=board, docs/TZ_task_views.md §1) по всем проектам или по одному — проект выбирается
   селектором в топбаре и живёт в query (?board=). Фильтры (?status= внутри проекта, ?type= в сводном режиме,
   ?who= — id, "none" — без исполнителя) и поиск считает сервер, страница грузится порциями по курсору.
   Слайдер создания (N) и слайдер задачи (?task=) — как раньше.
   Старый адрес /boards/{id} сохранён и уводит на /tasks?board={id}: ссылки и закладки остаются рабочими. *@
@page "/tasks"
@page "/boards/{Id:guid}"
@implements IDisposable
@inject IFlowApi Api
@inject NavigationManager Nav
@inject ToastService Toasts
@inject BrowserInterop Browser
@inject HotkeyService Hotkeys
@inject AppState State
@inject UserDirectory Users
@inject ProjectAccessState Access
@inject PreferencesState Preferences
@inject SavedFiltersState Filters

<PageTitle>@(CurrentBoard?.Name ?? "Задачи") — Flow</PageTitle>

<div class="topbar">
    <div class="topbar-left">
        <a class="topbar-back" href="boards" title="К проектам"><Icon Name="arrow-left" Size="18" /></a>
        @if (_renaming && CurrentBoard is not null)
        {
            <input id="board-rename" class="title-input" style="font-size:20px;letter-spacing:-0.3px;max-width:420px;"
                   value="@_renameValue" maxlength="200"
                   @oninput="e => _renameValue = e.Value?.ToString() ?? string.Empty"
                   @onkeydown="OnRenameKey" @onblur="CommitRename" />
        }
        else
        {
            <BoardSelect Boards="_boards" Value="BoardId" ValueChanged="SelectBoard" Disabled="_boardsLoading" />
            @if (CurrentBoard is not null)
            {
                var boardAccess = Access.For(CurrentBoard.Id);
                @if (Permissions.CanRenameBoard(boardAccess))
                {
                    <DsIconButton Icon="edit" Size="30" Title="Переименовать проект" Style="color:rgba(255,255,255,0.45)" OnClick="StartRename" />
                }
                @if (Permissions.CanManageConfig(boardAccess))
                {
                    <DsIconButton Icon="list" Size="30" Title="Статусы проекта" Style="color:rgba(255,255,255,0.45)" OnClick="() => _statusesOpen = true" />
                    <DsIconButton Icon="link" Size="30" Title="Workflow проекта" Style="color:rgba(255,255,255,0.45)" OnClick="@(() => Nav.NavigateTo($"boards/{CurrentBoard.Id}/workflow"))" />
                    <DsIconButton Icon="settings" Size="30" Title="Типы задач проекта" Style="color:rgba(255,255,255,0.45)" OnClick="() => _typesOpen = true" />
                    <DsIconButton Icon="check-square" Size="30" Title="Поля проекта" Style="color:rgba(255,255,255,0.45)" OnClick="() => _fieldsOpen = true" />
                }
                <DsIconButton Icon="calendar" Size="30" Title="Вехи проекта" Style="color:rgba(255,255,255,0.45)" OnClick="@(() => Nav.NavigateTo($"boards/{CurrentBoard.Id}/milestones"))" />
                @if (Permissions.CanManageMembers(boardAccess))
                {
                    <DsIconButton Icon="users" Size="30" Title="Доступ к проекту" Style="color:rgba(255,255,255,0.45)" OnClick="() => _accessOpen = true" />
                }
            }
        }
    </div>
    <div class="topbar-right">
        <SearchBox Placeholder="Найти задачу или код..." Value="@_search" ValueChanged="OnSearchChanged" />
        @if (CanCreateTask)
        {
            <DsButton Variant="primary" Size="sm" Icon="plus" OnClick="OpenCreate" Disabled="_boards.Count == 0">Создать задачу</DsButton>
        }
    </div>
</div>

<div class="content no-scroll">
    @* Ветки «загрузка» здесь нет намеренно: данные запрашивает сама таблица (ServerData), и пока её нет
       в разметке, запрос не начнётся. Состояние загрузки показывает сам грид (Loading + LoadingContent). *@
    @if (_notFound)
    {
        <div class="empty">
            <div class="empty-title">Проект не найден</div>
            <a href="tasks">Ко всем задачам</a>
        </div>
    }
    else if (_loadError is not null)
    {
        <div class="empty">
            <div class="empty-title">Не удалось загрузить задачи</div>
            <div>@_loadError</div>
            <DsButton Variant="secondary" Size="sm" OnClick="Load">Повторить</DsButton>
        </div>
    }
    else
    {
        <div class="filter-row">
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                <div class="seg" role="radiogroup" aria-label="Вид">
                    <button type="button" class="seg-btn @(CurrentView == TaskView.List ? "on" : "")" role="radio" aria-checked="@(CurrentView == TaskView.List)"
                            title="Список" @onclick="() => SetView(TaskView.List)"><Icon Name="list" Size="14" />Список</button>
                    <button type="button" class="seg-btn @(IsBoardView ? "on" : "")" role="radio" aria-checked="@IsBoardView"
                            title="Доска: колонки по статусам" @onclick="() => SetView(TaskView.Board)"><Icon Name="grid" Size="14" />Доска</button>
                    <button type="button" class="seg-btn @(IsTreeView ? "on" : "")" role="radio" aria-checked="@IsTreeView" disabled="@(BoardId is null)"
                            title="@(BoardId is null ? "Дерево — внутри одного проекта: выберите проект" : "Дерево: эпики, истории и подзадачи")"
                            @onclick="() => SetView(TaskView.Tree)"><Icon Name="list-ordered" Size="14" />Дерево</button>
                    <button type="button" class="seg-btn @(IsBacklogView ? "on" : "")" role="radio" aria-checked="@IsBacklogView" disabled="@(BoardId is null)"
                            title="@(BoardId is null ? "Бэклог — внутри одного проекта: выберите проект" : "Бэклог и спринты")"
                            @onclick="() => SetView(TaskView.Backlog)"><Icon Name="history" Size="14" />Бэклог</button>
                </div>
                @* В доске фильтр статуса не нужен: колонки и есть статусы. *@
                @if (CurrentView == TaskView.List && CurrentBoard is { } board)
                {
                    <StatusFilter Statuses="board.Statuses" Counts="_countsByStatus" Total="_total" Value="StatusId" ValueChanged="SetStatusFilter" />
                }
                else if (CurrentView == TaskView.List)
                {
                    <StatusTypeFilter Counts="_countsByType" Total="_total" Value="TypeFilter" ValueChanged="SetTypeFilter" />
                }
                <AssigneeFilter Tasks="_tasks" Value="@Who" ValueChanged="SetWhoFilter" />
                @if (Me is { } me)
                {
                    <button type="button" class="seg-btn solo @(Who == me.Id.ToString() ? "on" : "")"
                            title="Задачи, где я исполнитель" @onclick="ToggleMine">Мои задачи</button>
                }
                <FilterMenu Current="CurrentFilter" />
                <button type="button" class="seg-btn solo @(FqlVisible ? "on" : "")" @onclick="OpenFql"
                        title="@(HasPanelFilters && !FqlVisible ? "Показать фильтры строкой FQL" : "Строка запроса FQL")">FQL</button>
            </div>
            <div class="meta-line">
                @if (CurrentView == TaskView.List)
                {
                    @Ru.Tasks(_total)@(" · ")
                }@(CurrentBoard is { } b ? $"создан {Ru.Date(b.CreatedAt)}" : Ru.Projects(_boards.Count))
            </div>
        </div>

        @if (FqlVisible)
        {
            <FqlBar Value="@EffectiveFql" Error="_fqlError" OnApply="ApplyFql" OnSave="OpenSave" OnClose="CloseFql" />
        }

        @if (IsBacklogView && BoardId is { } backlogBoardId)
        {
            <BacklogView @ref="_backlog" Boards="_boards" BoardId="backlogBoardId" AssigneeId="AssigneeFilterId" Unassigned="@(Who == "none")"
                         Query="@_search" Fql="@EffectiveFql" Me="Me" SelectedId="TaskId"
                         OnOpen="OpenTask" OnLoaded="OnKanbanLoaded" OnFqlError="e => _fqlError = e" />
        }
        else if (IsTreeView && BoardId is { } treeBoardId)
        {
            <TaskTree @ref="_tree" Boards="_boards" BoardId="treeBoardId" AssigneeId="AssigneeFilterId" Unassigned="@(Who == "none")"
                      Query="@_search" Fql="@EffectiveFql" Me="Me" SelectedId="TaskId"
                      OnOpen="OpenTask" OnLoaded="OnKanbanLoaded" OnFqlError="e => _fqlError = e" />
        }
        else if (IsBoardView)
        {
            <KanbanBoard @ref="_kanban" Boards="_boards" BoardId="BoardId" AssigneeId="AssigneeFilterId" Unassigned="@(Who == "none")"
                         Query="@_search" Fql="@EffectiveFql" Me="Me" SelectedId="TaskId"
                         OnOpen="OpenTask" OnLoaded="OnKanbanLoaded" OnFqlError="e => _fqlError = e"
                         OnBoardChanged="ReplaceBoard" OnCreated="OnQuickCreated" />
        }
        else
        {
        @* Страницу и размер страницы, как и сортировку, ведём сами: встроенные переключатели таблицы в
           серверном режиме меняют только подписи пейджера, а повторный запрос не делают. *@
        <MudDataGrid @ref="_grid" T="TaskResponse" ServerData="LoadTasks" Class="flow-grid panel"
                     Dense="true" Hover="true" Elevation="0" SortMode="SortMode.None"
                     CurrentPage="_page" CurrentPageChanged="OnPageChanged"
                     RowsPerPage="_pageSize" RowsPerPageChanged="OnPageSizeChanged"
                     RowClass="task-row" RowClassFunc="RowClass" RowClick="@(args => OpenTask(args.Item))" Loading="_loading">
            <Columns>
                <PropertyColumn T="TaskResponse" TProperty="string" Property="t => t.Code" Title="Код" CellClass="code" Sortable="false">
                    <HeaderTemplate>
                        <SortHeader Field="TaskSortField.Code" Current="_sortField" Descending="_sortDescending" OnSort="SortBy">Код</SortHeader>
                    </HeaderTemplate>
                    <CellTemplate>
                        @* Ячейка кода — точка входа строки с клавиатуры: Tab останавливается здесь, Enter
                           открывает задачу, ↑↓ переводят фокус на соседнюю. Она же якорь для прокрутки. *@
                        <span id="@TaskAnchorId(context.Item.Id)" class="row-key" role="button" tabindex="0"
                              aria-label="@($"{context.Item.Code}: {context.Item.Title}")"
                              @onclick:stopPropagation @onclick="() => OpenTask(context.Item)"
                              @onkeydown="e => OnRowKey(e, context.Item)">@if (TypeFor(context.Item) is { } type)
                              {
                                  <TaskTypeIcon Kind="type.Kind" Name="@type.Name" Size="13" />
                              }@context.Item.Code</span>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn T="TaskResponse" TProperty="string" Property="t => t.Title" Title="Задача" CellClass="task-cell-title" Sortable="false">
                    <HeaderTemplate>
                        <SortHeader Field="TaskSortField.Title" Current="_sortField" Descending="_sortDescending" OnSort="SortBy">Задача</SortHeader>
                    </HeaderTemplate>
                    <CellTemplate>
                        <div class="task-title">
                            @if (_renamingId == context.Item.Id)
                            {
                                <input id="@RenameInputId" value="@_renameTaskValue" maxlength="500"
                                       @oninput="e => _renameTaskValue = e.Value?.ToString() ?? string.Empty"
                                       @onkeydown="OnTaskRenameKey" @onblur="CommitTaskRename"
                                       @onclick:stopPropagation />
                            }
                            else
                            {
                                <PriorityIcon Value="context.Item.Priority" Size="13" />@context.Item.Title
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(context.Item.Description))
                        {
                            <div class="task-desc">@Ru.PlainFirstLine(context.Item.Description)</div>
                        }
                        @if (context.Item.DueDate is not null || context.Item.CommentCount > 0 || context.Item.StoryPoints is not null || context.Item.ChildCount > 0 || context.Item.ChecklistTotal > 0 || context.Item.BlockedByCount > 0)
                        {
                            <div class="task-meta-chips">
                                @if (context.Item.StoryPoints is { } sp)
                                {
                                    <span class="count-chip" title="Story points">@Ru.Points(sp) SP</span>
                                }
                                @if (context.Item.DueDate is { } d)
                                {
                                    <DueChip Value="d" IsDone="IsDone(context.Item)" />
                                }
                                @if (context.Item.BlockedByCount > 0)
                                {
                                    <span class="count-chip blocked" title="@($"Заблокирована незакрытыми задачами: {context.Item.BlockedByCount}")"><Icon Name="lock" Size="12" />заблокирована</span>
                                }
                                @if (context.Item.ChildCount > 0)
                                {
                                    var ci = context.Item;
                                    <span class="count-chip @(ci.ChildDoneCount == ci.ChildCount ? "done" : "")"
                                          title="@($"Подзадачи: выполнено {ci.ChildDoneCount} из {ci.ChildCount}")"><Icon Name="list" Size="12" />@ci.ChildDoneCount/@ci.ChildCount</span>
                                }
                                @if (context.Item.ChecklistTotal > 0)
                                {
                                    var cl = context.Item;
                                    <span class="count-chip @(cl.ChecklistDone == cl.ChecklistTotal ? "done" : "")"
                                          title="@($"Чек-лист: {cl.ChecklistDone} из {cl.ChecklistTotal}")"><Icon Name="check-square" Size="12" />@cl.ChecklistDone/@cl.ChecklistTotal</span>
                                }
                                @if (context.Item.CommentCount > 0)
                                {
                                    <span class="count-chip" title="@Ru.Comments(context.Item.CommentCount)"><Icon Name="message" Size="12" />@context.Item.CommentCount</span>
                                }
                            </div>
                        }
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn T="TaskResponse" TProperty="Guid?" Property="t => t.AssigneeId" Title="Кто" Sortable="false">
                    <HeaderTemplate>
                        <SortHeader Field="TaskSortField.Assignee" Current="_sortField" Descending="_sortDescending" OnSort="SortBy">Кто</SortHeader>
                    </HeaderTemplate>
                    <CellTemplate>
                        <AssigneeSelect Compact="true" Value="context.Item.AssigneeId" Disabled="!Permissions.CanAssign(Me, AccessFor(context.Item), context.Item)"
                                        OnlyUserId="OnlyAssigneeFor(context.Item.BoardId)" OnChange="id => AssignTask((context.Item, id))" />
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn T="TaskResponse" TProperty="Guid" Property="t => t.StatusId" Title="Статус" Sortable="false">
                    <HeaderTemplate>
                        <SortHeader Field="TaskSortField.Status" Current="_sortField" Descending="_sortDescending" OnSort="SortBy">Статус</SortHeader>
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (Permissions.CanEditTask(Me, AccessFor(context.Item), context.Item))
                        {
                            <StatusSelect Statuses="StatusesFor(context.Item)" Value="context.Item.StatusId"
                                          TaskId="context.Item.Id" Restricted="IsRestricted(context.Item.BoardId)"
                                          OnChange="id => ChangeStatus((context.Item, id))" />
                        }
                        else
                        {
                            var st = StatusesFor(context.Item).FirstOrDefault(x => x.Id == context.Item.StatusId);
                            <span class="status-pill" @onclick:stopPropagation><span class="sd" style="background:@StatusColors.For(st?.Type)"></span>@(st?.Name ?? "—")</span>
                        }
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn T="TaskResponse" TProperty="DateTime" Property="t => t.CreatedAt" Title="Создана" CellClass="task-date" Sortable="false">
                    <HeaderTemplate>
                        <SortHeader Field="TaskSortField.Created" Current="_sortField" Descending="_sortDescending" OnSort="SortBy">Создана</SortHeader>
                    </HeaderTemplate>
                    <CellTemplate>
                        <span title="@Ru.DateTimeFull(context.Item.CreatedAt)">@Ru.DateShort(context.Item.CreatedAt)</span>
                    </CellTemplate>
                </PropertyColumn>

                <TemplateColumn T="TaskResponse" Sortable="false" Filterable="false" CellClass="task-cell-menu">
                    <CellTemplate>
                        <RowMenu OnOpen="() => OpenTask(context.Item)" ShowRename="Permissions.CanEditTask(Me, AccessFor(context.Item), context.Item)"
                                 ShowDelete="Permissions.CanEditTask(Me, AccessFor(context.Item), context.Item)"
                                 OnRename="() => StartTaskRename(context.Item)" OnCopy="() => CopyCode(context.Item)"
                                 OnDelete="() => AskDeleteTask(context.Item)" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <LoadingContent>
                <Skeleton Kind="rows" Count="5" />
            </LoadingContent>
            <NoRecordsContent>
                <div class="empty">
                    @if (HasFilters)
                    {
                        <div class="empty-title">Ничего не найдено</div>
                        <button type="button" class="icon-lnk" @onclick="ResetFilters">Сбросить фильтры</button>
                    }
                    else if (CurrentBoard is { } empty)
                    {
                        <div class="empty-title">Пока нет задач</div>
                        <div>Создайте первую — код будет <span class="code accent">@empty.Key-@empty.NextTaskNumber</span></div>
                        @if (CanCreateTask)
                        {
                            <DsButton Variant="primary" Size="sm" Icon="plus" OnClick="OpenCreate">Создать первую</DsButton>
                        }
                    }
                    else
                    {
                        <div class="empty-title">Задач нет ни в одном проекте</div>
                        @if (CanCreateTask && _boards.Count > 0)
                        {
                            <DsButton Variant="primary" Size="sm" Icon="plus" OnClick="OpenCreate">Создать первую</DsButton>
                        }
                    }
                </div>
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="TaskResponse" RowsPerPageString="Задач на странице" InfoFormat="{first_item}–{last_item} из {all_items}" />
            </PagerContent>
        </MudDataGrid>
        }
    }
</div>

<Drawer Open="DrawerOpen" OnClose="CloseDrawer">
    @if (DrawerBoard is { } drawerBoard && (_createOpen || SelectedTask is not null))
    {
        <TaskDrawer Board="drawerBoard" Boards="CreatableBoards" OnBoardChanged="SetCreateBoard" Item="@(_createOpen ? null : SelectedTask)"
                    CanEdit="@(SelectedTask is { } sel && Permissions.CanEditTask(Me, AccessFor(sel), sel))"
                    CanAssign="@(SelectedTask is { } sel2 && Permissions.CanAssign(Me, AccessFor(sel2), sel2))"
                    OnlyAssigneeId="OnlyAssigneeFor(drawerBoard.Id)"
                    OnClose="CloseDrawer" OnCreated="OnTaskCreated" OnUpdated="OnTaskUpdated" OnDelete="AskDeleteTask"
                    OnHierarchyChanged="Reload" />
    }
</Drawer>

@if (_accessOpen && CurrentBoard is { } accessBoard)
{
    <ProjectAccessDialog Board="accessBoard" OnClose="() => _accessOpen = false" />
}

@if (_saveQuery is not null)
{
    <SaveFilterDialog Query="@_saveQuery" Current="CurrentFilter" OnSaved="OnFilterSaved" OnClose="() => _saveQuery = null" />
}

@if (_statusesOpen && CurrentBoard is { } statusesBoard)
{
    <StatusesDialog Board="statusesBoard" OnChanged="OnStatusesChanged" OnClose="() => _statusesOpen = false" />
}

@if (_fieldsOpen && CurrentBoard is { } fieldsBoard)
{
    <CustomFieldsDialog Board="fieldsBoard" OnChanged="ReplaceBoard" OnClose="() => _fieldsOpen = false" />
}

@if (_typesOpen && CurrentBoard is { } typesBoard)
{
    <TaskTypesDialog Board="typesBoard" OnChanged="ReplaceBoard" OnClose="() => _typesOpen = false" />
}

@if (_deleting is not null)
{
    <ConfirmDialog Title="@($"Удалить задачу {_deleting.Code}?")"
                   Text="@TaskMeta.DeleteWarning(_deleting)"
                   OnConfirm="ConfirmDeleteTask" OnCancel="() => _deleting = null" />
}

@code {
    private const int PageSize = 100;

    /// <summary>Приходит только со старого маршрута /boards/{id} — сразу уводим на /tasks?board={id}.</summary>
    [Parameter] public Guid? Id { get; set; }

    /// <summary>Выбранный проект; null — все проекты.</summary>
    [SupplyParameterFromQuery(Name = "board")] public Guid? BoardId { get; set; }

    /// <summary>Фильтр по статусу проекта (только когда проект выбран).</summary>
    [SupplyParameterFromQuery(Name = "status")] public Guid? StatusId { get; set; }

    /// <summary>Фильтр по типу статуса в сводном режиме: наборы статусов у проектов разные.</summary>
    [SupplyParameterFromQuery(Name = "type")] public string? Type { get; set; }

    /// <summary>Открытая в слайдере задача.</summary>
    [SupplyParameterFromQuery(Name = "task")] public Guid? TaskId { get; set; }

    /// <summary>Фильтр по исполнителю: Guid пользователя или "none" — без исполнителя.</summary>
    [SupplyParameterFromQuery(Name = "who")] public string? Who { get; set; }

    /// <summary>Запрос FQL (docs/TZ_task_views.md §7); складывается с панелью фильтров через AND.</summary>
    [SupplyParameterFromQuery(Name = "fql")] public string? Fql { get; set; }

    /// <summary>Представление: list | board; без параметра — из личных настроек (docs/TZ_task_views.md).</summary>
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }

    /// <summary>Открытый сохранённый фильтр; его запрос действует, пока в адресе нет своего ?fql= (правки до «Сохранить»).</summary>
    [SupplyParameterFromQuery(Name = "filter")] public Guid? FilterId { get; set; }

    private MudDataGrid<TaskResponse>? _grid;
    private KanbanBoard? _kanban;

    private TaskTree? _tree;

    /// <summary>
    /// Вид экрана: из адреса, без него — из личных настроек. Дерево — только внутри проекта (docs/TZ_task_views.md §3):
    /// в «Все проекты» оно показывает список.
    /// </summary>
    private TaskView CurrentView
    {
        get
        {
            var view = View switch
            {
                "board" => TaskView.Board,
                "tree" => TaskView.Tree,
                "backlog" => TaskView.Backlog,
                "list" => TaskView.List,
                _ => Preferences.TasksView
            };
            return view is TaskView.Tree or TaskView.Backlog && BoardId is null ? TaskView.List : view;
        }
    }

    private bool IsBoardView => CurrentView == TaskView.Board;

    private bool IsTreeView => CurrentView == TaskView.Tree;

    private bool IsBacklogView => CurrentView == TaskView.Backlog;

    private BacklogView? _backlog;

    /// <summary>
    /// Смена вида. Фильтр статуса есть только у списка (в доске колонки и есть статусы, в дереве статус виден в строке),
    /// поэтому он снимается; остальные фильтры едут с адресом.
    /// </summary>
    private void SetView(TaskView view)
    {
        if (view == CurrentView)
            return;

        Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["view"] = view.ToString().ToLowerInvariant(),
            ["status"] = null,
            ["type"] = null
        }));
    }

    /// <summary>Карточки доски — те же _tasks, по которым ходят слайдер и ↑↓.</summary>
    private void OnKanbanLoaded(IReadOnlyList<TaskResponse> cards) => _tasks = cards.ToList();

    private async Task OnQuickCreated(TaskResponse t)
    {
        BumpNextNumber(t.BoardId);
        Toasts.Ok($"Задача {t.Code} создана");
        await Task.CompletedTask;
    }
    private TaskSortField _sortField = TaskSortField.Created;
    private bool _sortDescending = true;
    private int _page;
    private int _pageSize = PageSize;
    private List<BoardResponse> _boards = [];
    private bool _boardsLoading = true;
    private List<TaskResponse> _tasks = [];
    /// <summary>Сколько строк под текущим отбором — им живёт пейджер таблицы.</summary>
    private int _matched;
    /// <summary>Флаг для <see cref="LoadTasks"/>: отдать текущую страницу без запроса (см. Redraw).</summary>
    private bool _redrawOnly;
    private IReadOnlyList<StatusTypeCount> _countsByType = [];
    private Dictionary<Guid, int> _countsByStatus = new();
    private int _total;
    private bool _loading = true;
    private bool _notFound;
    private string? _loadError;
    private string _search = "";
    private CancellationTokenSource? _searchCts;
    private string? _loadedKey;
    private bool _createOpen;
    private Guid? _createBoardId;
    private TaskResponse? _deleting;
    private Guid? _flashId;
    private bool _renaming;
    private string _renameValue = "";
