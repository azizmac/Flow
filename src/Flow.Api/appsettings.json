{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Startup": {
    "DatabaseWaitTimeoutSeconds": 60
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=flow;Username=flow;Password=flow"
  },
  "Cors": {
    "Origins": [
      "http://localhost:5016",
      "https://localhost:7062"
    ]
  },
  "Auth": {
    "BaseUrl": "http://localhost:5100",
    "Issuer": "http://localhost:5100",
    "ApiClient": {
      "ClientId": "flow-api",
      "Secret": "dev-only-change-me"
    }
  },
  "S3": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "flow",
    "SecretKey": "flow12345",
    "Bucket": "flow",
    "UseSsl": false
  },
  "Attachments": {
    "MaxFileBytes": 26214400,
    "MaxPerTask": 20,
    "MaxTotalBytesPerTask": 104857600
  },
  "Search": {
    "Enabled": true,
    "Embeddings": {
      "Enabled": true,
      "Provider": "Http",
      "QueryEndpoint": "http://localhost:8081/v1",
      "IndexingEndpoint": "",
      "Model": "Qwen3-Embedding-0.6B",
      "Dimensions": 512,
      "QueryInstruction": "Given a search query, retrieve relevant tasks, comments and documents",
      "BatchSize": 16,
      "TimeoutSeconds": 5,
      "Vision": {
        "Enabled": false,
        "Endpoint": "http://localhost:8083/v1",
        "Model": "Qwen3-VL-Embedding-2B",
        "Dimensions": 512,
        "MaxBytes": 8388608,
        "TimeoutSeconds": 30
      }
    },
    "Indexing": {
      "Enabled": true,
      "PollIntervalSeconds": 5,
      "BatchSize": 32,
      "MaxAttempts": 10,
      "ChunkTokens": 512,
      "ChunkOverlap": 64
    },
    "Query": {
      "VectorTopN": 50,
      "TextTopN": 50,
      "RrfK": 60,
      "MaxLimit": 50,
      "HnswEfSearch": 100
    },
    "Rerank": {
      "Enabled": false,
      "Endpoint": "http://localhost:8082/v1",
      "Model": "bge-reranker-v2-m3",
      "TopN": 10,
      "MaxDocumentChars": 1200,
      "TimeoutSeconds": 15
    }
  },
  "Bootstrap": {
    "Enabled": true,
    "Id": "11111111-1111-1111-1111-111111111111",
    "Username": "admin",
    "Email": "admin@flow.com",
    "FirstName": "Admin",
    "LastName": "Flow"
  }
}
