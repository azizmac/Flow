@* Выбор исполнителя «в строке»: триггер (аватар + имя или «Не назначена») + меню с поиском по @username/имени
   и пунктом «Снять исполнителя». Список — из UserDirectory (только активные: деактивированных назначать нельзя).
   Выбор → OnChange(userId | null). Печать в поле фильтрует локально; Enter — первый результат, Esc — закрыть.

   Слой — MudMenu. Здесь фокус намеренно уходит в поле поиска: печатать важнее, чем ходить стрелками,
   а первый результат выбирается по Enter. *@
@implements IDisposable
@inject UserDirectory Users
@inject BrowserInterop Browser

<MudMenu @bind-Open="_open" PopoverClass="flow-pop flow-pop-wide" ListClass="flow-pop-list" AnchorOrigin="@AnchorOrigin"
         TransformOrigin="@TransformOrigin" Dense="true" DropShadow="false" Ripple="false" AriaLabel="Назначить исполнителя">
    <ActivatorContent>
        <div class="assignee-sel @(Compact ? "compact" : "") @(Current is null ? "none" : "")" @onclick="Toggle" @onclick:stopPropagation
             role="button" tabindex="@(Disabled ? -1 : 0)" aria-haspopup="listbox" aria-expanded="@(_open ? "true" : "false")"
             title="@(Disabled ? "" : "Назначить исполнителя")">
            <Avatar User="Current" Size="@(Compact ? 20 : 22)" />
            @if (!Compact)
            {
                <span class="lbl">@(Current?.FullName ?? "Не назначена")</span>
                <Icon Name="chevrons" Size="12" />
            }
        </div>
    </ActivatorContent>
    <ChildContent>
        <label class="pop-search" @onclick:stopPropagation>
            <Icon Name="search" Size="14" />
            <input id="@_inputId" placeholder="Имя или @@username" value="@_query" autocomplete="off" spellcheck="false"
                   @oninput="e => _query = e.Value?.ToString() ?? string.Empty" @onkeydown="OnKey" />
        </label>
        @if (!Users.IsLoaded)
        {
            <div class="pop-empty">Загрузка…</div>
        }
        else
        {
            // Member на своей задаче назначает только себя (Permissions.CanAssign): список сужаем до него.
            var list = OnlyUserId is { } only ? Users.Filter(_query).Where(u => u.Id == only).ToList() : Users.Filter(_query);
            if (list.Count == 0)
            {
                <div class="pop-empty">@(Users.Active.Count == 0 ? "Пока нет людей — добавьте на странице «Люди»" : "Никого не найдено")</div>
            }
            @foreach (var u in list)
            {
                <MudMenuItem Class="@($"pop-item user {(u.Id == Value ? "cur" : "")}")" OnClick="() => Select(u.Id)">
                    <Avatar User="u" Size="22" />
                    <span class="pop-user">
                        <span class="pop-user-name">@u.FullName</span>
                        <span class="pop-user-un">@@@u.Username@(string.IsNullOrEmpty(u.JobTitle) ? "" : $" · {u.JobTitle}")</span>
                    </span>
                </MudMenuItem>
            }
        }
        @if (Value is not null)
        {
            <div class="pop-sep"></div>
            <MudMenuItem Class="pop-item" OnClick="() => Select(null)">
                <Icon Name="user-off" Size="15" />Снять исполнителя
            </MudMenuItem>
        }
    </ChildContent>
</MudMenu>

@code {
    [Parameter] public Guid? Value { get; set; }
    [Parameter] public EventCallback<Guid?> OnChange { get; set; }
    /// <summary>Только аватар — для строки списка.</summary>
    [Parameter] public bool Compact { get; set; }
    /// <summary>"left" — меню под левым краем триггера, "right" — под правым.</summary>
    [Parameter] public string Align { get; set; } = "left";
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Ограничить выбор одним пользователем (Member — только себя); null — все активные.</summary>
    [Parameter] public Guid? OnlyUserId { get; set; }

    private readonly string _inputId = "asq-" + Guid.NewGuid().ToString("N")[..8];
    private bool _open;
    private string _query = "";

    private UserResponse? Current => Users.Find(Value);

    private Origin AnchorOrigin => Align == "right" ? Origin.BottomRight : Origin.BottomLeft;

    private Origin TransformOrigin => Align == "right" ? Origin.TopRight : Origin.TopLeft;

    protected override async Task OnInitializedAsync()
    {
        Users.Changed += OnUsersChanged;
        if (!Users.IsLoaded)
            await Users.EnsureLoadedAsync();
    }

    private void OnUsersChanged() => InvokeAsync(StateHasChanged);

    private async Task Toggle()
    {
        if (Disabled) return;
        _open = !_open;
        if (_open)
        {
            _query = "";
            StateHasChanged();
            // Меню рендерится в портал провайдера — поле появляется в DOM на кадр позже.
            await Task.Delay(FocusDelayMs);
            await Browser.FocusAsync(_inputId);
        }
    }

    private const int FocusDelayMs = 50;

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            var first = Users.Filter(_query, 1).FirstOrDefault();
            if (first is not null) await Select(first.Id);
        }
        else if (e.Key == "Escape")
        {
            _open = false;
        }
    }

    private async Task Select(Guid? id)
    {
        _open = false;
        if (id != Value)
            await OnChange.InvokeAsync(id);
    }

    public void Dispose() => Users.Changed -= OnUsersChanged;
}
