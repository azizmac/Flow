@* Вложения задачи: список, загрузка, превью, скачивание и удаление (docs/TZ_attachments.md, этап 2).

   И превью, и скачивание — прямые ссылки /files/{id}: браузер забирает файл сам по cookie, минуя
   circuit. Раньше байты ехали на сервер в память, оттуда по SignalR в браузер и превращались
   в blob:-URL, который приходилось освобождать вручную. *@
@implements IDisposable
@inject IFlowApi Api
@inject ToastService Toasts
@inject AttachmentSizes Sizes
@inject UserDirectory Users
@inject AppState State
@inject AttachmentEvents Events

@if (_items.Count > 0 || CanAttach)
{
    <div class="att-block">
        <div class="att-head">
            <div class="section-title">Вложения@(_items.Count > 0 ? $" · {_items.Count}" : "")</div>
            @if (CanAttach)
            {
                <AttachmentUpload TaskId="TaskId" InputId="@_inputId" DropZoneId="@DropZoneId" />
            }
        </div>

        @foreach (var item in _items)
        {
            <div class="att-row">
                @if (item.IsImage && item.SizeBytes <= PreviewMaxBytes)
                {
                    <img class="att-thumb" src="@Href(item)" alt="@item.FileName" data-attachment="@item.Id"
                         loading="lazy" decoding="async" />
                }
                else
                {
                    <span class="att-ico"><Icon Name="@(item.IsImage ? "eye" : "file")" Size="15" /></span>
                }
                <div class="att-main">
                    <a class="att-name" href="@Href(item)" download="@item.FileName" title="Скачать @item.FileName">@item.FileName</a>
                    <div class="att-sub">
                        <span>@Ru.FileSize(item.SizeBytes)</span>
                        <span>·</span>
                        <UserName Id="@item.UploadedById" />
                        <span>·</span>
                        <span title="@Ru.DateTimeFull(item.UploadedAt)">@Ru.Ago(item.UploadedAt)</span>
                    </div>
                </div>
                @* Спиннера больше нет и он не нужен: прогресс скачивания показывает сам браузер. *@
                <a class="icon-lnk" href="@Href(item)" download="@item.FileName" title="Скачать">
                    <Icon Name="arrow-left" Size="13" Style="transform:rotate(-90deg);" />
                </a>
                @if (CanDelete(item))
                {
                    <button type="button" class="icon-lnk danger" title="Удалить" @onclick="() => StartDelete(item)">
                        <Icon Name="trash" Size="13" />
                    </button>
                }
            </div>
        }
    </div>
}

@if (_deleting is not null)
{
    <ConfirmDialog Title="Удалить файл?" Text="@DeleteWarning" OnConfirm="ConfirmDelete" OnCancel="() => _deleting = null" />
}

@code {
    [Parameter, EditorRequired] public Guid TaskId { get; set; }

    /// <summary>
    /// Элемент, в который можно бросить файл — вся карточка или тело слайдера. Редактор комментария
    /// внутри такой зоны перехватывает файл себе и вставляет ссылку в текст (см. flow.attachZone).
    /// </summary>
    [Parameter] public string? DropZoneId { get; set; }

    /// <summary>
    /// Порог остался, но смысл у него теперь другой. Трафика он больше не экономит — браузер тянет
    /// файл сам и кэширует его. Экономит он декодирование: ради плитки 40×40 незачем разворачивать
    /// в памяти снимок на 20 МБ. Настоящее решение — уменьшенная копия на сервере, это отдельная задача.
    /// </summary>
    private const long PreviewMaxBytes = 4L * 1024 * 1024;

    private readonly string _inputId = "att-" + Guid.NewGuid().ToString("N")[..8];

    private List<AttachmentResponse> _items = [];
    private Guid _loadedTaskId;
    private AttachmentResponse? _deleting;
    private bool _deletingIsMentioned;

    private string DeleteWarning => _deleting is null
        ? string.Empty
        : $"«{_deleting.FileName}» будет удалён без возможности восстановления."
          + (_deletingIsMentioned ? " Файл упомянут в тексте — ссылка на него перестанет работать." : string.Empty);

    private UserResponse? Me => Users.Find(State.CurrentUserId);

    protected override void OnInitialized() => Events.Changed += OnAttachmentsChanged;

    /// <summary>
    /// Изменение приходит событием, откуда бы файл ни приложили: кнопкой здесь, перетаскиванием
    /// в карточку или из редактора комментария. Список правится точечно — перечитывать его целиком
    /// значит заново качать все превью.
    /// </summary>
    private void OnAttachmentsChanged(AttachmentChange change)
    {
        if (change.TaskId != TaskId)
            return;

        if (change.Added is { } added && _items.All(item => item.Id != added.Id))
        {
            InvokeAsync(() => Add(added));
            return;
        }

        if (change.RemovedId is { } removedId && _items.Any(item => item.Id == removedId))
            InvokeAsync(() => Remove(removedId));
    }

    private bool CanAttach => Permissions.CanAttach(Me);

    private bool CanDelete(AttachmentResponse item) => Permissions.CanDeleteAttachment(Me, item);

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedTaskId == TaskId)
            return;

        _loadedTaskId = TaskId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _items = [];

        var result = await Api.GetAttachments(TaskId);
        if (!result.Ok)
        {
            // Список вложений не главное на экране: молча пустой блок лучше тоста поверх задачи.
            return;
        }

        _items = [.. result.Value!];
        // Размеры отсюда нужны рендеру Markdown: в тексте лежит только attachment:{id}.
        // На странице задачи справочник уже наполнен до первого рендера, здесь это для слайдера,
        // где список приезжает параметром и гейта загрузки нет.
        Sizes.Remember(_items);
        StateHasChanged();

        if (!Users.IsLoaded)
            _ = Users.EnsureLoadedAsync();
    }

    /// <summary>Прямая ссылка на содержимое — FilesController, вне префикса /api (там только Bearer).</summary>
    private static string Href(AttachmentResponse item) => $"/files/{item.Id}";

    private void Add(AttachmentResponse item)
    {
        _items = [.. _items, item];
        // Только что приложенная картинка должна получить размеры сразу: её уже вставили в текст.
        Sizes.Remember([item]);
        StateHasChanged();
    }

    private void Remove(Guid id)
    {
        _items = [.. _items.Where(item => item.Id != id)];
        StateHasChanged();
    }

    /// <summary>
    /// Перед удалением смотрим, не ссылается ли на файл описание или комментарий: чужие тексты мы
    /// не правим (ТЗ), поэтому единственное, что остаётся, — предупредить. Проверка по требованию,
    /// а не заранее: тексты нужны один раз и только тому, кто действительно нажал «удалить».
    /// </summary>
    private async Task StartDelete(AttachmentResponse item)
    {
        _deleting = item;
        _deletingIsMentioned = false;
        StateHasChanged();

        var mention = $"attachment:{item.Id}";

        var task = await Api.GetTask(TaskId);
        if (task.Ok && task.Value!.Description?.Contains(mention, StringComparison.OrdinalIgnoreCase) == true)
        {
            _deletingIsMentioned = true;
            StateHasChanged();
            return;
        }

        var comments = await Api.GetComments(TaskId);
        if (comments.Ok && comments.Value!.Any(c => c.Body.Contains(mention, StringComparison.OrdinalIgnoreCase)))
        {
            _deletingIsMentioned = true;
            StateHasChanged();
        }
    }

    private async Task ConfirmDelete()
    {
        var item = _deleting!;
        var result = await Api.DeleteAttachment(item.Id);
        _deleting = null;

        if (!result.Ok)
        {
            Toasts.Error(result.Error ?? "Не удалось удалить файл");
            return;
        }

        Remove(item.Id);
        // Тот же файл мог быть показан в тексте комментария — там ссылка теперь не сработает,
        // но чужие тексты не правим (см. ТЗ, «Порядок операций»).
        Events.NotifyRemoved(TaskId, item.Id);
        Toasts.Ok($"Файл {item.FileName} удалён");
    }

    public void Dispose() => Events.Changed -= OnAttachmentsChanged;
}
