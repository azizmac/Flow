@* Роутер переехал сюда из Flow.Client/App.razor вместе с провайдерами MudBlazor: корневой документ
   теперь Components/App.razor хоста, а этот файл — только маршрутизация и слои UI.
   AppAssembly указывает на сборку Flow.Client: все страницы (@page) живут там, а не в хосте. *@
@* Все страницы закрыты ([Authorize] в _Imports.razor). Без сессии — RedirectToLogin на /account/login Auth-модуля
   (маршрута /authentication/{action} больше нет: он обслуживал браузерный OIDC, которого при серверном рендере нет).
   Authorizing/NotAuthorized AuthorizeRouteView сам оборачивает в DefaultLayout (MainLayout), поэтому Sidebar там
   показывается только для аутентифицированных (AuthorizeView в MainLayout). *@
@* Провайдеры MudBlazor поднимаются выше роутера: слои (поповеры, диалоги, снекбары) не должны
   пересоздаваться при переходе между страницами. Тема всегда тёмная — светлой палитры у Flow нет. *@
<MudThemeProvider Theme="@FlowTheme.Instance" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" />
<MudSnackbarProvider />

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(MainLayout).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div class="auth-screen">
                            <div class="auth-card">
                                <div class="auth-title">Нет доступа</div>
                                <div class="auth-text">У вашей учётной записи нет прав на эту страницу.</div>
                            </div>
                        </div>
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="auth-screen"><div class="auth-card"><div class="auth-text">Проверяем сессию…</div></div></div>
                </Authorizing>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <Flow.Client.Pages.NotFound />
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
