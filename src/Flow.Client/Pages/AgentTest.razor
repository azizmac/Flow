@page "/agents/test"
@inject IFlowApi Api

<PageTitle>Проверка агента — Flow</PageTitle>

<div class="topbar">
    <div class="topbar-left">
        <span class="agent-test-top-icon"><Icon Name="send" Size="18" /></span>
        <div>
            <h2>Локальный агент</h2>
            <div class="agent-test-top-subtitle">OpenCode · рабочий каталог</div>
        </div>
    </div>
</div>

<div class="content">
    <div class="agent-test">
        <div class="agent-test-hero">
            <div class="agent-test-hero-icon"><Icon Name="message" Size="22" /></div>
            <div>
                <div class="agent-test-kicker">Проверка интеграции</div>
                <h1>Спросите о кодовой базе</h1>
                <p>Агент получит вопрос и изучит выбранный рабочий каталог в OpenCode.</p>
            </div>
        </div>

        <div class="agent-test-layout">
            <section class="panel agent-test-composer">
                <div class="agent-test-panel-head">
                    <div>
                        <h3>Новый вопрос</h3>
                        <p>Нажмите <kbd>Ctrl</kbd> + <kbd>Enter</kbd>, чтобы отправить.</p>
                    </div>
                    <span class="agent-test-status @(_sending ? "working" : "ready")">
                        <span></span>@(_sending ? "Агент работает" : "Готов к вопросу")
                    </span>
                </div>

                <div class="agent-test-source">
                    <label>Проект
                        <select value="@_boardId" @onchange="SelectBoard">
                            @foreach (var board in _boards)
                            {
                                <option value="@board.Id">@board.Name</option>
                            }
                        </select>
                    </label>
                    <label>Репозиторий
                        <select value="@_repositoryId" @onchange="SelectRepository">
                            @foreach (var repository in _repositories)
                            {
                                <option value="@repository.RepositoryId">@repository.FullName · @repository.DefaultBranch (@repository.SyncState)</option>
                            }
                        </select>
                    </label>
                </div>
                @if (_boardId != Guid.Empty && _repositories.Count == 0)
                {
                    <div class="hint">У проекта нет репозиториев. <a href="@($"boards/{_boardId}/repositories")">Подключить репозиторий</a>.</div>
                }

                <div class="agent-test-question-field">
                    <label class="agent-test-question-label" for="agent-question">Что нужно узнать?</label>
                    <textarea id="agent-question" class="agent-test-question" rows="7" maxlength="10000"
                              placeholder="Например: что хранится в этом репозитории?" @bind="_question" @bind:event="oninput"
                              @onkeydown="OnQuestionKeyDown"></textarea>
                </div>

                <div class="agent-test-composer-foot">
                    <span class="hint">Ответ будет получен в отдельной сессии OpenCode.</span>
                    <DsButton Variant="primary" Size="md" Icon="send" OnClick="Ask" Busy="_sending" Disabled="@(!CanAsk)">
                        Отправить вопрос
                    </DsButton>
                </div>
            </section>

            <aside class="panel agent-test-info">
                <div class="agent-test-info-icon"><Icon Name="code" Size="19" /></div>
                <h3>Выбранная ревизия</h3>
                <p>Агент читает код подключённого репозитория из общего тома.</p>
                <div class="agent-test-path"><span>@(SelectedRepository?.LastSyncedCommit?[..Math.Min(12, SelectedRepository.LastSyncedCommit.Length)] ?? "Нет готового commit")</span></div>
                <div class="agent-test-info-rule"></div>
                <div class="agent-test-info-note">
                    <Icon Name="message" Size="15" />
                    <span>Ответ не сохраняется в задаче — это техническая проверка подключения.</span>
                </div>
            </aside>
        </div>

        @if (_error is not null)
        {
            <div class="agent-test-error" role="alert">
                <Icon Name="danger" Size="18" />
                <div><strong>Не удалось получить ответ</strong><span>@_error</span></div>
            </div>
        }

        @if (_answer is { } answer)
        {
            <section class="panel agent-test-answer has-answer">
                <div class="agent-test-answer-head">
                    <div class="agent-test-answer-title">
                        <span class="agent-test-answer-icon"><Icon Name="message" Size="18" /></span>
                        <div><h3>Ответ агента</h3><span>Сессия OpenCode</span></div>
                    </div>
                    <span class="code" title="Идентификатор сессии OpenCode">@answer.SessionId</span>
                </div>
                <div class="agent-test-answer-body">
                    <MarkdownView Text="@answer.Text" Placeholder="Агент вернул пустой ответ." />
                </div>
            </section>
        }
        else if (_error is null)
        {
            <section class="panel agent-test-answer agent-test-answer-empty">
                @if (_sending)
                {
                    <span class="agent-test-waiting"><span></span><span></span><span></span></span>
                    <div><strong>Агент изучает кодовую базу</strong><span>Это может занять некоторое время.</span></div>
                }
                else
                {
                    <span class="agent-test-answer-icon muted"><Icon Name="message" Size="19" /></span>
                    <div><strong>Ответ появится здесь</strong><span>Начните с вопроса о содержимом репозитория.</span></div>
                }
            </section>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "boardId")] public Guid? BoardIdParam { get; set; }
    [SupplyParameterFromQuery(Name = "repositoryId")] public Guid? RepositoryIdParam { get; set; }

    private IReadOnlyList<BoardResponse> _boards = [];
    private IReadOnlyList<ScmBoardRepositoryResponse> _repositories = [];
    private Guid _boardId;
    private Guid _repositoryId;
    private string _question = "Что хранится в этом репозитории?";
    private AgentTestResponse? _answer;
    private string? _error;
    private bool _sending;

    private ScmBoardRepositoryResponse? SelectedRepository => _repositories.FirstOrDefault(repository => repository.RepositoryId == _repositoryId);

    private bool CanAsk => !_sending && !string.IsNullOrWhiteSpace(_question) &&
        SelectedRepository is { LastSyncedCommit: not null, SyncState: "Ready" or "Failed" };

    protected override async Task OnInitializedAsync()
    {
        var boards = await Api.GetBoards();
        if (!boards.Ok)
        {
            _error = boards.Error;
            return;
        }

        _boards = boards.Value!;
        _boardId = BoardIdParam is { } id && _boards.Any(board => board.Id == id) ? id : _boards.FirstOrDefault()?.Id ?? Guid.Empty;
        await LoadRepositories();
        if (RepositoryIdParam is { } repositoryId && _repositories.Any(repository => repository.RepositoryId == repositoryId))
            _repositoryId = repositoryId;
    }

    private async Task SelectBoard(ChangeEventArgs e)
    {
        _boardId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : Guid.Empty;
        await LoadRepositories();
    }

    private void SelectRepository(ChangeEventArgs e) =>
        _repositoryId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : Guid.Empty;

    private async Task LoadRepositories()
    {
        _repositories = [];
        _repositoryId = Guid.Empty;
        if (_boardId == Guid.Empty) return;

        var result = await Api.GetBoardRepositories(_boardId);
        if (result.Ok)
        {
            _repositories = result.Value!.Where(repository => repository.IsBound).ToList();
            _repositoryId = _repositories.FirstOrDefault(repository => repository.LastSyncedCommit is not null && repository.SyncState is "Ready" or "Failed")?.RepositoryId ?? Guid.Empty;
            _error = null;
        }
        else
            _error = result.Error;
    }

    private async Task Ask()
    {
        if (!CanAsk)
            return;

        _sending = true;
        _error = null;
        _answer = null;

        var result = await Api.AskAgent(new AgentTestRequest(_question, _repositoryId));
        _sending = false;

        if (result.Ok)
            _answer = result.Value;
        else
            _error = result.Error;
    }

    private Task OnQuestionKeyDown(KeyboardEventArgs e) =>
        e.CtrlKey && e.Key == "Enter" ? Ask() : Task.CompletedTask;
}
